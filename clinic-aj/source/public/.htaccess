# ============================================================
# clinic-aj.ru — настройки для хостинга Timeweb (Apache)
# ============================================================

AddDefaultCharset UTF-8
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Всегда https и без www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://clinic-aj.ru%{REQUEST_URI} [L,R=301]

  # 1а. Страницы Тильды без адреса → новые адреса (28.10)
  RewriteRule ^page77185316\.html$ /massage [L,R=301]
  RewriteRule ^page77186186\.html$ /lifting [L,R=301]

  # 2. Старые адреса с .html → без .html (301, 29.10): /lpg.html → /lpg, /index.html → /
  #    THE_REQUEST — то, что набрал посетитель, поэтому внутренняя подмена из п. 4 сюда не попадает
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [L,R=301]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # 3. Без слэша в конце (trailingSlash: 'never'): /lpg/ → /lpg
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 4. Адреса как на Тильде: /lpg открывает lpg.html (адрес в браузере не меняется)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Кэширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
