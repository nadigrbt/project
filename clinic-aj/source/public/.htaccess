# ============================================================
# clinic-aj.ru — настройки для хостинга Timeweb (Apache)
# ============================================================

AddDefaultCharset UTF-8
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Всегда https и без www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://clinic-aj.ru%{REQUEST_URI} [L,R=301]

  # 1а. Страницы Тильды без адреса → новые адреса (28.10)
  RewriteRule ^page77185316\.html$ /massage [L,R=301]
  RewriteRule ^page77186186\.html$ /lifting [L,R=301]
  # Служебная страница Тильды (скрипт для слабовидящих) была в sitemap — ведём на главную (28.10)
  RewriteRule ^page39632167\.html$ / [L,R=301]

  # 1б. /index и /index.html — дубли главной → /
  RewriteCond %{THE_REQUEST} \s/index(\.html)?[\s?] [NC]
  RewriteRule ^ / [L,R=301]

  # 2. Адреса как на Тильде: /lpg открывает lpg.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # 3. Если кто-то зайдёт на /lpg.html — перекидываем на /lpg
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
  RewriteCond %1 !^index$
  RewriteRule ^ /%1 [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

# Типы файлов (на случай, если хостинг их не знает)
AddType image/webp .webp
AddType font/woff2 .woff2
AddType video/mp4 .mp4

# Кэширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/xml text/xml image/x-icon
</IfModule>
