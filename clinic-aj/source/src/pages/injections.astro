---
// Страница /injections — новый дизайн в стиле /volnewmer и /cosmetology, 5 размеров шрифта (шкала --fs-*).
// Тексты — со страниц Тильды (/injections, /botulino, /biorevitalization, /sfero, /plazma), освежены и проверены: убраны «безопасная и эффективная альтернатива хирургии»,
// «результат уже после первой процедуры», цена в описании для поиска, названия препаратов и фото упаковок (реклама рецептурных препаратов, 38-ФЗ).
// Копия страницы с Тильды для сравнения — injections-tilda.astro (/injections-tilda).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Directions from '../components/Directions.astro';
import { site } from '../data/site';
import { img } from '../data/images';

const benefits = [
  { title: 'Консультация перед процедурой', text: 'Врач определит зоны, подберёт препарат и расскажет о противопоказаниях.' },
  { title: 'Врачи с медицинским образованием', text: 'Специалисты постоянно учатся и работают индивидуально.' },
  { title: 'Сертифицированные препараты', text: 'Подбираем под вашу кожу и задачу, а не по шаблону.' },
  { title: 'Три адреса в Мурманске', text: 'Принимаем ежедневно с 9:00 до 21:00, без выходных.' },
];
const goals = [
  { title: 'Разгладить мимические морщины', items: [['botulino', 'Ботулинотерапия'], ['biorev', 'Биоревитализация']] },
  { title: 'Увлажнить и освежить кожу', items: [['biorev', 'Биоревитализация'], ['hands', 'Кожа рук'], ['meso', 'Мезотерапия'], ['prp', 'Плазмолифтинг']] },
  { title: 'Вернуть объём и скорректировать контуры', items: [['contour', 'Контурная пластика'], ['threads', 'Нитевой лифтинг']] },
  { title: 'Подтянуть кожу и вернуть упругость', items: [['threads', 'Нитевой лифтинг'], ['collagen', 'Коллагенотерапия'], ['sfero', 'СФЕРОгель']] },
  { title: 'Омолодить кожу вокруг глаз', items: [['sfero', 'СФЕРОгель'], ['biorev', 'Биоревитализация']] },
  { title: 'Уменьшить локальные жировые отложения', items: [['lipo', 'Липолитики'], ['consult', 'Консультация']] },
];
const procedures: { id: string; href: string; title: string; forWhat: string; text: string }[] = [
  { id: 'botulino', href: '/botulino', title: 'Ботулинотерапия', forWhat: 'Мимические морщины на лбу, между бровей и в уголках глаз.', text: 'Препарат расслабляет мышцы, которые образуют морщины: они сглаживаются и появляются реже. Врач определяет зоны и дозировку на консультации. Первые изменения заметны через несколько дней, максимальный эффект — примерно через две недели. Обычно он сохраняется 3–6 месяцев, у каждого по-разному.' },
  { id: 'biorev', href: '/biorevitalization', title: 'Биоревитализация лица', forWhat: 'Сухость, тусклый цвет лица, мелкие морщины, сниженный тонус.', text: 'Микроинъекции гиалуроновой кислоты увлажняют и питают кожу и поддерживают её собственные процессы восстановления. Подходит для разных типов кожи; часто её выбирают после стресса, при смене сезона или в рамках антивозрастного ухода.' },
  { id: 'hands', href: '/biorevitalization', title: 'Биоревитализация рук', forWhat: 'Сухость, тонкая кожа, морщинки и пигментация на руках.', text: 'Кожа рук раньше других выдаёт возраст. Биоревитализация помогает вернуть ей увлажнение и более свежий вид без операции и длительного восстановления.' },
  { id: 'sfero', href: '/sfero', title: 'СФЕРОгель', forWhat: 'Кожа вокруг глаз: тонкие морщинки, отёчность, тёмные круги.', text: 'Отечественный препарат на основе коллагена с гиалуроновой кислотой и аминокислотами, который сочетает свойства коллагенотерапии, филлеров и биоревитализации. Процедура проводится тонкими иглами или канюлями; лёгкое покраснение и отёк обычно проходят за 1–2 дня. Курс и интервалы подбирает врач, эффект может сохраняться до года.' },
  { id: 'meso', href: '', title: 'Мезотерапия', forWhat: 'Тусклая кожа, сниженный тонус, мелкие морщины на лице, шее и декольте.', text: 'Витамины, аминокислоты и другие активные вещества вводятся в кожу микроинъекциями. Состав врач подбирает под вашу задачу и состояние кожи.' },
  { id: 'contour', href: '', title: 'Контурная пластика лица', forWhat: 'Форма и объём губ, подбородка, скул, складки.', text: 'Гелевые препараты на основе гиалуроновой кислоты восполняют объём и сглаживают складки. Эффект виден сразу, восстановление обычно недолгое. Зоны и препарат врач подбирает так, чтобы сохранить ваши естественные черты.' },
  { id: 'prp', href: '/plazma', title: 'Плазмолифтинг (PRP)', forWhat: 'Тонус и цвет лица, следы акне, расширенные поры.', text: 'Используется плазма вашей собственной крови, богатая тромбоцитами и ростовыми факторами: её вводят обратно в кожу тонкими иглами. Метод стимулирует обновление кожи; так как это ваш собственный материал, риск аллергической реакции ниже. Применяют и для волос, подробности — на консультации.' },
  { id: 'lipo', href: '', title: 'Инъекции липолитиков', forWhat: 'Локальные жировые отложения: подбородок, живот, бёдра.', text: 'Препараты вводятся под кожу и воздействуют на жировую ткань. Число процедур и интервалы зависят от задачи, результат оценивают через несколько недель.' },
  { id: 'collagen', href: '', title: 'Коллагенотерапия', forWhat: 'Потеря упругости и эластичности, возрастные изменения, рубцы и растяжки.', text: 'Препараты с коллагеном вводятся в кожу и поддерживают её каркас. Результат зависит от исходного состояния кожи; врач оценит, что реально улучшить.' },
  { id: 'threads', href: '', title: 'Нитевой лифтинг', forWhat: 'Опущение тканей, овал лица, контур скул и подбородка.', text: 'Под кожу вводят рассасывающиеся нити разной формы и длины: они поддерживают ткани и запускают выработку собственного коллагена. Эффект заметен сразу, окончательный — через несколько недель. Подходит не всем, решение принимает врач.' },
  { id: 'ozone', href: '', title: 'Озонотерапия', forWhat: 'Тонус и цвет лица, купероз, акне и постакне.', text: 'Метод основан на применении озона: он вводится инъекционно или наносится наружно. Показания, схему и курс определяет врач.' },
];
const principles = [
  'Подчёркиваем вашу естественную красоту',
  'Подбираем препарат и зоны индивидуально',
  'Только то, что действительно нужно вашей коже',
  'Объясняем, как проходит восстановление и уход после процедуры',
];
const steps = [
  { title: 'Консультация', text: 'Врач выслушает пожелания, оценит состояние кожи и расскажет о противопоказаниях.' },
  { title: 'Индивидуальный план', text: 'Определим зоны, подберём препарат и схему. Если процедура вам не нужна, скажем об этом сразу.' },
  { title: 'Процедура и наблюдение', text: 'Проводим процедуру, объясняем уход после неё и договариваемся о повторном визите, если он нужен.' },
];
const faq = [
  { q: 'Это больно?', a: 'Ощущения индивидуальны. Используются тонкие иглы или канюли; если вы беспокоитесь, обсудите обезболивание с врачом на консультации.' },
  { q: 'Нужно ли восстановление?', a: 'После инъекций возможны небольшие покраснение, отёчность или следы от уколов, они обычно проходят в течение нескольких дней. Как подготовиться и что делать после процедуры, расскажет врач.' },
  { q: 'Когда будет виден результат?', a: 'Это зависит от процедуры. После контурной пластики эффект виден сразу, после ботулинотерапии — через несколько дней, при курсовых методиках результат нарастает постепенно.' },
  { q: 'Как долго держится эффект?', a: 'У каждого по-разному. Например, после ботулинотерапии эффект обычно сохраняется 3–6 месяцев. Врач подскажет, когда лучше повторить процедуру.' },
  { q: 'Нужна ли консультация перед процедурой?', a: 'Да. Перед процедурой вы проходите консультацию: врач определяет зоны, подбирает препарат и рассчитывает дозировку.' },
];
const contra = [
  'беременность и грудное вскармливание',
  'воспаление, инфекция или высыпания в зоне инъекций',
  'онкологические заболевания',
  'нарушения свёртываемости крови',
  'аллергия на компоненты препарата',
  'обострение хронических заболеваний',
];
---
<Base
  title="Инъекционная косметология в Мурманске | Клиника эстетической косметологии A&J"
  description="Инъекционная косметология в клинике A&J в Мурманске: ботулинотерапия, биоревитализация, контурная пластика, плазмолифтинг, мезотерапия. Запишитесь онлайн или по номеру 78-70-30"
>
  <section class="cs-hero">
    <Header />

    <div class="container">
      <nav class="cs-crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Инъекционная косметология</span>
      </nav>
    </div>

    <div class="container in-hero">
      <div class="in-hero__text">
        <p class="cs-eyebrow">Инъекционная косметология</p>
        <h1 class="cs-hero__title">Свежесть и тонус кожи <span>без операции</span></h1>
        <p class="cs-hero__lead">Увлажнение, морщины, объём и контуры лица. Врач подберёт процедуру на консультации, чтобы подчеркнуть вашу естественную красоту.</p>
        <div class="cs-actions">
          <a class="cs-btn" href="#contact">Записаться на консультацию</a>
          <a class="cs-phone" href={site.phone.href}>
            <span class="cs-phone__label">или позвоните</span>
            <span class="cs-phone__num">{site.phone.display}</span>
          </a>
        </div>
      </div>
      <div class="in-hero__visual" aria-hidden="true">
        <img class="in-hero__letters" src={img('cosmLetters')} alt="" width="1183" height="821" />
        <img class="in-hero__woman" src={img('promoWoman')} alt="" width="700" height="700" fetchpriority="high" />
      </div>
    </div>

    <div class="cs-benefits">
      <ul class="container cs-benefits__list">
        {benefits.map((b) => (
          <li>
            <img src={img('star')} alt="" width="15" height="15" />
            <div><strong>{b.title}</strong><span>{b.text}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <main>
    <!-- О направлении -->
    <section class="container cs-intro">
      <p class="cs-eyebrow">О направлении</p>
      <h2 class="cs-title">Работаем с кожей изнутри, без хирургического вмешательства</h2>
      <p class="cs-intro__text">Инъекционная косметология — это малоинвазивные процедуры: препарат вводится в кожу или под кожу тонкими иглами или канюлями. С их помощью работают над увлажнением и тонусом кожи, мимическими морщинами, объёмом и контурами лица. Результат у каждого свой, поэтому врач сначала знакомится с вашей кожей и пожеланиями, а уже потом предлагает процедуры.</p>
    </section>

    <!-- Что вы хотите изменить -->
    <section class="container cs-nav">
      <p class="cs-eyebrow">Подбор по задаче</p>
      <h2 class="cs-title">Что вы хотите изменить?</h2>
      <ul class="cs-nav__list">
        {goals.map((g) => (
          <li class="cs-nav__item">
            <h3>{g.title}</h3>
            <ul>{g.items.map(([id, name]) => <li><a href={`#${id}`}>{name}</a></li>)}</ul>
          </li>
        ))}
      </ul>
    </section>

    <!-- Каталог процедур -->
    <section class="cs-devices">
      <div class="container">
        <h2 class="section-title">Наши процедуры</h2>
        <p class="cs-devices__lead">Какая процедура подойдёт именно вам, решит врач на консультации: у каждой есть показания и противопоказания.</p>
        <ul class="cs-devices__grid">
          {procedures.map((d) => (
            <li class="cs-card" id={d.id}>
              <h3>{d.title}</h3>
              <p class="cs-card__for">{d.forWhat}</p>
              <p>{d.text}</p>
              {d.href
                ? <a class="cs-card__link" href={d.href}>Подробнее о процедуре →</a>
                : <a class="cs-card__link" href="#contact">Записаться на консультацию →</a>}
            </li>
          ))}
          <li class="cs-card cs-card--soft" id="consult">
            <h3>Не знаете, с чего начать?</h3>
            <p>Врач соберёт анамнез, оценит состояние кожи и предложит план: какие процедуры нужны, в каком порядке и что подойдёт в домашнем уходе.</p>
            <a class="cs-card__link" href="#contact">Записаться на консультацию →</a>
          </li>
        </ul>
        <p class="cs-all">Все процедуры клиники — <a href="/">на главной странице</a></p>
      </div>
    </section>

    <!-- Принципы (винная полоса) -->
    <section class="cs-results">
      <div class="container cs-results__inner">
        <div>
          <h2 class="cs-results__title">Результат, в котором вы узнаёте себя</h2>
          <p class="cs-results__note">Наша задача — подчеркнуть вашу естественную красоту и сохранить молодость.</p>
        </div>
        <ul class="cs-results__list">
          {principles.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>

    <!-- Как проходит -->
    <section class="container cs-steps">
      <h2 class="section-title">Как мы работаем</h2>
      <ol class="cs-steps__list">
        {steps.map((s, i) => (
          <li>
            <span class="cs-steps__num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Вопросы -->
    <section class="container in-faq">
      <p class="cs-eyebrow">Вопросы и ответы</p>
      <h2 class="cs-title">Что обычно спрашивают</h2>
      <div class="in-faq__list">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Противопоказания + аппаратные методы -->
    <section class="container cs-med">
      <div class="cs-med__card">
        <h2>Когда процедуры могут быть невозможны</h2>
        <ul>
          {contra.map((c) => <li>{c}</li>)}
        </ul>
        <p>Это общий перечень: у каждой процедуры и препарата он свой. Имеются противопоказания. Необходима консультация специалиста.</p>
      </div>
      <div class="cs-med__card cs-med__card--alt">
        <h2>Подтяжка и омоложение без инъекций</h2>
        <p class="in-cross__text">Если вам ближе методы без уколов, в клинике есть аппаратная косметология: RF-лифтинг, ультразвуковой лифтинг, лазеры, LED-терапия и другие процедуры.</p>
        <p class="in-cross__links">
          <a href="/cosmetology">Аппаратная косметология →</a>
          <a href="/volnewmer">RF-лифтинг Volnewmer →</a>
        </p>
      </div>
    </section>

    <Directions current="/injections" />

    <!-- Запись -->
    <section class="cs-cta">
      <div class="container cs-cta__inner">
        <div>
          <h2 class="cs-cta__title">Хотите узнать, что подойдёт вашей коже?</h2>
          <p class="cs-cta__sub">Приходите на консультацию: подберём процедуры и расскажем, как всё проходит.</p>
          <p class="cs-cta__warn">Имеются противопоказания. Необходима консультация специалиста.</p>
        </div>
        <a class="cs-cta__btn" href="#contact">Записаться онлайн</a>
      </div>
    </section>

    <Contacts />
  </main>
  <Footer />
</Base>

<style>
  /* Размеры шрифта — только из общей шкалы --fs-* (styles/global.css), 5 размеров */

  .cs-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: var(--w-regular);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wine);
  }
  .cs-eyebrow::before { content: ''; width: 40px; height: 1px; background: currentColor; }
  .cs-title { margin-top: 20px; font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }

  /* ---------- Первый экран ---------- */
  .cs-hero { position: relative; overflow: hidden; background: var(--white); }
  .cs-crumbs { display: flex; gap: 10px; padding-top: 40px; font-size: var(--fs-small); color: var(--muted); }
  .cs-crumbs a { text-decoration: none; }
  .cs-crumbs a:hover { color: var(--wine); }
  .in-hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 40px; align-items: end; padding-top: 28px; padding-bottom: 0; }
  .cs-hero__title { margin-top: 20px; font-size: var(--fs-h1); line-height: 1.12; font-weight: var(--w-thin); }
  .cs-hero__title span { display: block; color: var(--wine); font-size: var(--fs-h2); line-height: 1.25; margin-top: 8px; }
  .cs-hero__lead { margin-top: 24px; max-width: 520px; color: var(--muted); }
  .in-hero__text { padding-bottom: 64px; }
  .in-hero__visual { position: relative; display: grid; justify-items: center; align-items: end; min-height: 440px; }
  .in-hero__letters { position: absolute; left: 50%; bottom: 0; width: 100%; max-width: 640px; height: auto; transform: translate(-50%, 14%); opacity: 0.28; clip-path: inset(0 0 14% 0); pointer-events: none; }
  .in-hero__woman { position: relative; width: 460px; max-width: 100%; height: auto; }

  .cs-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px 32px; margin-top: 32px; }
  .cs-btn,
  .cs-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    border-radius: 999px;
    font-family: var(--font);
    font-size: var(--fs-body);
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-btn { background: var(--wine); color: var(--white); }
  .cs-btn:hover { background: var(--graphite); }
  .cs-phone { display: grid; text-decoration: none; line-height: 1.2; }
  .cs-phone__label { font-size: var(--fs-small); color: var(--muted); }
  .cs-phone__num { font-family: var(--font); font-size: var(--fs-h3); letter-spacing: 0.5px; }
  .cs-phone:hover .cs-phone__num { color: var(--wine); }

  .cs-benefits { border-top: 1px solid var(--line); }
  .cs-benefits__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0 auto;
    padding-top: 32px;
    padding-bottom: 36px;
    list-style: none;
  }
