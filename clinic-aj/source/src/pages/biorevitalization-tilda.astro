---
// Страница /biorevitalization-tilda — копия страницы с Тильды для сравнения (закрыта от поиска). Тексты и порядок блоков как на Тильде.
// Убрано только: «устраняет пигментацию», «уже после первых сеансов пациенты отмечают видимое улучшение» (неподтверждённые обещания, 38-ФЗ); добавлено предупреждение о противопоказаниях.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';

const paras = [
  'Биоревитализация — это процедура, направленная на интенсивное увлажнение, питание и восстановление кожи с помощью гиалуроновой кислоты.',
  'Этот натуральный компонент активно участвует в процессах регенерации тканей, улучшая общее состояние кожи и возвращая ей свежесть и сияние.',
  'Процедура помогает бороться с первыми признаками старения: разглаживает мелкие морщины, выравнивает тон кожи и придаёт коже более гладкую и упругую текстуру. Благодаря биоревитализации улучшается микроциркуляция, активизируется выработка коллагена и эластина, что делает кожу более плотной и эластичной.',
  'Основная цель процедуры — активизировать внутренние ресурсы кожи, вернуть ей здоровье, молодость и естественное сияние.',
  'Биоревитализация подходит для любого типа кожи и особенно рекомендована в периоды снижения тонуса — после стресса, смены сезонов или в рамках антивозрастного ухода.',
];
---
<Base
  title="Биоревитализация — увлажнение и омоложение кожи в Мурманске | Клиника эстетической косметологии A&J"
  description="Биоревитализация в клинике A&J в Мурманске: увлажнение и омоложение кожи с помощью гиалуроновой кислоты. Запишитесь онлайн или по номеру 78-70-30"
  noindex
>
  <Header />

  <main>
    <nav class="container ct-crumbs" aria-label="Хлебные крошки">
      <a href="/">Главная страница</a>
      <span class="ct-crumbs__sep" aria-hidden="true">→</span>
      <a href="/injections">Инъекционная косметология</a>
      <span class="ct-crumbs__sep" aria-hidden="true">→</span>
      <a href="/biorevitalization" aria-current="page">Биоревитализация</a>
    </nav>

    <section class="ct-cover">
      <div class="container ct-cover__text">
        <h1 class="ct-cover__title">Биоревитализация — глубокое увлажнение и омоложение кожи</h1>
        <p class="ct-cover__descr">Борьба с первыми признаками старения с помощью гиалуроновой кислоты</p>
        <a class="btn-outline ct-cover__btn" href="#contact">Записаться</a>
      </div>
    </section>

    <section class="container ct-text">
      {paras.map((p) => <p>{p}</p>)}
      <p class="ct-text__warn">Имеются противопоказания. Необходима консультация специалиста.</p>
    </section>

    <About />
    <Contacts />
  </main>
  <Footer />
</Base>

<style>
  .ct-crumbs { display: flex; align-items: center; gap: 12px; padding-top: 22px; font-family: var(--font); font-size: 15px; font-weight: var(--w-light); }
  .ct-crumbs a { text-decoration: none; transition: color 0.2s; }
  .ct-crumbs a:hover { color: var(--muted); }
  .ct-crumbs__sep { color: #858585; font-size: 12px; }

  .ct-cover { padding-top: 60px; }
  .ct-cover__text { max-width: 820px; text-align: center; }
  .ct-cover__title { font-size: 40px; line-height: 1.23; font-weight: var(--w-regular); }
  .ct-cover__descr { margin-top: 32px; font-size: 16px; line-height: 1.55; }
  .ct-cover__btn { width: auto; min-width: 140px; height: 42px; margin-top: 36px; }
  

  .ct-text { padding-top: 60px; padding-bottom: 70px; font-size: 20px; line-height: 1.55; }
  .ct-text p + p { margin-top: 31px; }
  .ct-text .ct-text__warn { font-size: 14px; letter-spacing: 0.5px; text-transform: uppercase; color: var(--muted); }

  @media (max-width: 959px) {
    .ct-cover__title { font-size: 28px; }
    .ct-cover__img { height: 220px; }
    .ct-text { font-size: 18px; }
  }
</style>
