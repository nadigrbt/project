---
// Страница /rf — «Игольчатый RF-лифтинг на аппарате Morpheus 8», новый дизайн в стиле /sfero, 5 размеров шрифта (шкала --fs-*).
// Тексты — со страницы Тильды /rf, освежены и проверены: убраны «оригинальный и высокоэффективный», «всего 1 процедура в год», «безопасность, эффективность, комфортность»,
// «не вызывает боли, не требует наркоза» (на /cosmetology указана местная анестезия), «безопасный способ вернуть молодость», сроки восстановления «в течение нескольких дней» (38-ФЗ).
// РУ на Morpheus 8 владелец дошлёт; названия зон тела взяты со старой страницы, подтвердить. Видео — плавающее окошко слева внизу (public/video-widget.js), как на Тильде.
// Копию Тильды не делаем (решение владельца 18.10).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Directions from '../components/Directions.astro';
import { site } from '../data/site';
import { img } from '../data/images';

const videoUrl = 'https://cd75615.tw1.ru/rf.mp4';
const benefits = [
  { title: 'Консультация перед процедурой', text: 'Врач оценит состояние кожи, подберёт параметры и расскажет о противопоказаниях.' },
  { title: 'Специалисты с медицинским образованием', text: 'Врачи и косметологи постоянно учатся и работают индивидуально.' },
  { title: 'Сертифицированное оборудование', text: 'Аппарат Morpheus 8 производства InMode (Израиль).' },
  { title: 'Три адреса в Мурманске', text: 'Принимаем ежедневно с 9:00 до 21:00, без выходных.' },
];
const how = [
  { title: 'Что это', text: 'Игольчатый RF-лифтинг на аппарате Morpheus 8 сочетает две методики: микроигольчатую терапию и радиочастотное воздействие. Процедура проводится без хирургического вмешательства.' },
  { title: 'Как это работает', text: 'Микроиглы проникают в кожу, а радиочастотная энергия прогревает ткани и стимулирует выработку коллагена и эластина. Глубину и параметры воздействия подбирает врач.' },
];
const zones = [
  { title: 'Лицо', text: 'Тонус и упругость кожи, морщины, возрастные изменения.' },
  { title: 'Шея и декольте', text: 'Нежная кожа, потеря тонуса.' },
  { title: 'Тело', text: 'Живот и бёдра: тонус и упругость кожи. Зону и параметры подбирает врач.' },
];
const whenList = [
  'Кожа потеряла упругость и тонус',
  'Появились морщины и другие возрастные изменения',
  'Есть рубцы или следы после акне',
  'Тонус кожи снизился после похудения',
];
const steps = [
  { title: 'Консультация', text: 'Врач осмотрит кожу, определит зоны и расскажет о противопоказаниях.' },
  { title: 'Подготовка и обезболивание', text: 'Кожу подготовят к процедуре и проведут местную анестезию.' },
  { title: 'Процедура и восстановление', text: 'Врач проведёт воздействие, объяснит, как ухаживать за кожей после процедуры, и договорится о повторном визите, если он нужен.' },
];
const faq = [
  { q: 'Это больно?', a: 'Процедура проводится с местной анестезией. Ощущения зависят от зоны и индивидуальной чувствительности, подробности обсудите с врачом.' },
  { q: 'Как проходит восстановление?', a: 'В первые дни возможны покраснение и отёчность, их длительность индивидуальна. Что можно и нельзя делать после процедуры, врач расскажет подробно.' },
  { q: 'Когда виден результат?', a: 'Результат развивается постепенно в течение нескольких недель по мере обновления кожи. У каждого пациента по-разному.' },
  { q: 'Сколько нужно процедур?', a: 'Количество процедур и интервалы назначает врач после осмотра.' },
  { q: 'Чем отличается от Volnewmer?', a: 'Volnewmer — это RF-лифтинг без игл с охлаждаемой насадкой, а Morpheus 8 — игольчатый. Что подойдёт именно вам, решит врач на консультации.' },
];
const contra = [
  'беременность и грудное вскармливание',
  'онкологические заболевания',
  'воспаление, инфекция или высыпания в зоне процедуры',
  'кардиостимулятор и металлические импланты в зоне воздействия',
  'склонность к келоидным рубцам',
  'нарушения свёртываемости крови и приём препаратов, влияющих на неё',
  'обострение хронических и аутоиммунные заболевания',
];
---
<Base
  title="Игольчатый RF-лифтинг Morpheus 8 в Мурманске | Клиника эстетической косметологии A&J"
  description="Игольчатый RF-лифтинг на аппарате Morpheus 8 в клинике A&J в Мурманске: микроиглы и радиочастотное воздействие для кожи лица и тела. Запишитесь онлайн или по номеру 78-70-30"
>
  <section class="cs-hero">
    <Header />

    <div class="container">
      <nav class="cs-crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/cosmetology">Аппаратная косметология</a><span class="cs-crumbs__sep" aria-hidden="true">/</span><span aria-current="page">RF-лифтинг Morpheus 8</span>
      </nav>
    </div>

    <div class="container in-hero">
      <div class="in-hero__text">
        <p class="cs-eyebrow">Аппаратная косметология</p>
        <h1 class="cs-hero__title">Игольчатый RF-лифтинг <span>на аппарате Morpheus 8</span></h1>
        <p class="cs-hero__lead">Микроигольчатая терапия и радиочастотное воздействие для кожи лица и тела. Врач подберёт параметры и количество процедур на консультации.</p>
        <div class="cs-actions">
          <a class="cs-btn" href="#contact">Записаться на консультацию</a>
          <a class="cs-phone" href={site.phone.href}>
            <span class="cs-phone__label">или позвоните</span>
            <span class="cs-phone__num">{site.phone.display}</span>
          </a>
        </div>
      </div>
      <div class="in-hero__visual" aria-hidden="true">
        <img class="in-hero__letters" src={img('cosmLetters')} alt="" width="1183" height="821" aria-hidden="true" />
        <img class="in-hero__woman" src={img('promoWoman')} alt="" width="700" height="700" fetchpriority="high" aria-hidden="true" />
      </div>
    </div>

    <div class="cs-benefits">
      <ul class="container cs-benefits__list">
        {benefits.map((b) => (
          <li>
            <img src={img('star')} alt="" width="15" height="15" />
            <div><strong>{b.title}</strong><span>{b.text}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <main>
    <section class="container cs-intro">
        <p class="cs-eyebrow">О процедуре</p>
        <h2 class="cs-title">Что такое игольчатый RF-лифтинг</h2>
        <p class="cs-intro__text">Игольчатый RF-лифтинг — процедура, в которой микроиглы и радиочастотная энергия воздействуют на кожу и подкожные слои. Метод применяют для кожи лица, шеи, декольте и тела. Результат у каждого свой: он зависит от состояния кожи и параметров, которые подбирает врач.</p>
    </section>

    <section class="container dv">
      <div class="dv__card">
        <div class="dv__pic"><img src={img('deviceMorpheus')} alt="Аппарат Morpheus 8 для игольчатого RF-лифтинга" width="380" height="760" loading="lazy" /></div>
        <div class="dv__text">
          <p class="cs-eyebrow">Об аппарате</p>
          <h2>Morpheus 8</h2>
          <p>Аппарат для игольчатого RF-лифтинга InMode: радиочастотная энергия подаётся в кожу через микроиглы. Для лица и тела используются разные насадки, врач подбирает насадку и параметры.</p>
          <dl class="dv__list">
          <div><dt>Название</dt><dd>Morpheus 8 (InMode)</dd></div>
          <div><dt>Производитель</dt><dd>InMode Ltd, Израиль</dd></div>
          <div><dt>Технология</dt><dd>Микроигольчатая терапия и радиочастотное воздействие</dd></div>
          <div><dt>Насадки</dt><dd>Для лица и для тела; для тела есть насадка с иглами до 7 мм</dd></div>
          <div><dt>Зоны</dt><dd>Лицо, шея, декольте, тело (по рекомендации врача)</dd></div>
          <div><dt>Регистрация</dt><dd>[номер РЗН — владелец дошлёт]</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="container bio-block">
      <p class="cs-eyebrow">Принцип действия</p>
      <h2 class="cs-title">Как работает аппарат</h2>
      <ul class="bio-pair">
        {how.map((x) => <li><h3>{x.title}</h3><p>{x.text}</p></li>)}
      </ul>
    </section>

    <section class="container bio-block">
      <p class="cs-eyebrow">Зоны</p>
      <h2 class="cs-title">Какие зоны обрабатывают</h2>
      <ul class="bio-zones">
        {zones.map((z) => <li><h3>{z.title}</h3><p>{z.text}</p></li>)}
      </ul>
    </section>

    <section class="cs-results bio-results">
      <div class="container cs-results__inner">
        <div>
          <h2 class="cs-results__title">Когда стоит задуматься о процедуре</h2>
          <p class="cs-results__note">Нужна ли процедура именно вам, решит специалист.</p>
        </div>
        <ul class="cs-results__list">
          {whenList.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>

    <section class="container cs-steps">
      <h2 class="section-title">Как проходит процедура</h2>
      <ol class="cs-steps__list">
        {steps.map((s, i) => (
          <li>
            <span class="cs-steps__num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="container in-faq">
      <p class="cs-eyebrow">Вопросы и ответы</p>
      <h2 class="cs-title">Что обычно спрашивают</h2>
      <div class="in-faq__list">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container cs-med">
      <div class="cs-med__card">
        <h2>Когда процедура может быть невозможна</h2>
        <ul>
          {contra.map((c) => <li>{c}</li>)}
        </ul>
        <p>Это общий перечень, окончательное решение принимает врач. Имеются противопоказания. Необходима консультация специалиста.</p>
      </div>
      <div class="cs-med__card cs-med__card--alt">
        <h2>Другие процедуры для кожи</h2>
        <p class="in-cross__text">Врач может сочетать методы. Посмотрите, что ещё есть в клинике.</p>
        <p class="in-cross__links">
          <a href="/cosmetology">Аппаратная косметология →</a>
          <a href="/volnewmer">RF-лифтинг Volnewmer →</a>
          <a href="/biorevitalization">Биоревитализация →</a>
          <a href="/estetica">Эстетическая косметология →</a>
        </p>
      </div>
    </section>

    <Directions current="/cosmetology" />

    <section class="cs-cta">
      <div class="container cs-cta__inner">
        <div>
          <h2 class="cs-cta__title">Хотите узнать, подойдёт ли вам игольчатый RF-лифтинг?</h2>
          <p class="cs-cta__sub">Приходите на консультацию: осмотрим кожу и подберём параметры процедуры.</p>
          <p class="cs-cta__warn">Имеются противопоказания. Необходима консультация специалиста.</p>
        </div>
        <a class="cs-cta__btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
      </div>
    </section>

    <Contacts />
  </main>
  <Footer />
  <script is:inline src="/video-widget.js?v=1" data-src={videoUrl} defer></script>
</Base>

<style>
  /* Размеры шрифта — только из общей шкалы --fs-* (styles/global.css), 5 размеров */

  .cs-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: var(--w-regular);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wine);
  }
  .cs-eyebrow::before { content: ''; width: 40px; height: 1px; background: currentColor; }
  .cs-title { margin-top: 20px; font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }

  /* ---------- Первый экран ---------- */
  .cs-hero { position: relative; overflow: hidden; background: var(--white); }
  .cs-crumbs { display: flex; gap: 10px; padding-top: 40px; font-size: var(--fs-small); color: var(--muted); }
  .cs-crumbs > * { white-space: nowrap; }
  .cs-crumbs a { text-decoration: none; }
  .cs-crumbs a:hover { color: var(--wine); }
  .in-hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 40px; align-items: end; padding-top: 28px; padding-bottom: 0; }
  .cs-hero__title { margin-top: 20px; font-size: var(--fs-h1); line-height: 1.12; font-weight: var(--w-thin); }
  .cs-hero__title span { display: block; color: var(--wine); font-size: var(--fs-h2); line-height: 1.25; margin-top: 8px; }
  .cs-hero__lead { margin-top: 24px; max-width: 520px; color: var(--muted); }
  .in-hero__text { padding-bottom: 64px; }
  .in-hero__visual { position: relative; display: grid; justify-items: center; align-items: end; min-height: 440px; overflow: hidden; }
  .in-hero__letters { position: absolute; left: 50%; bottom: 0; width: 100%; max-width: 640px; height: auto; transform: translate(-50%, 14%); opacity: 0.28; clip-path: inset(0 0 14% 0); pointer-events: none; }
  .in-hero__woman { position: relative; width: 460px; max-width: 100%; height: auto; }

  .cs-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px 32px; margin-top: 32px; }
  .cs-btn,
  .cs-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    border-radius: 999px;
    font-family: var(--font);
    font-size: var(--fs-body);
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-btn { background: var(--wine); color: var(--white); }
  .cs-btn:hover { background: var(--graphite); }
  .cs-phone { display: grid; text-decoration: none; line-height: 1.2; }
  .cs-phone__label { font-size: var(--fs-small); color: var(--muted); }
  .cs-phone__num { font-family: var(--font); font-size: var(--fs-h3); letter-spacing: 0.5px; }
  .cs-phone:hover .cs-phone__num { color: var(--wine); }

  .cs-benefits { border-top: 1px solid var(--line); }
  .cs-benefits__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0 auto;
    padding-top: 32px;
    padding-bottom: 36px;
    list-style: none;
  }
  .cs-benefits__list li { display: flex; gap: 10px; font-size: var(--fs-small); line-height: 1.45; }
  .cs-benefits__list img { flex: none; margin-top: 5px; }
  .cs-benefits__list strong { display: block; font-family: var(--font); font-size: var(--fs-body); font-weight: var(--w-regular); }
  .cs-benefits__list span { color: var(--muted); }

  /* ---------- О направлении ---------- */
  .cs-intro { padding-top: 88px; }
  .cs-intro > * { max-width: 820px; }
  .cs-intro__text { margin-top: 24px; }

  /* ---------- Подбор по задаче ---------- */
  .cs-nav { padding-top: 72px; padding-bottom: 72px; }
  .cs-nav__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-nav__item { display: flex; flex-direction: column; gap: 14px; padding: 28px 28px 24px; background: var(--ivory); }
  .cs-nav__item h3 { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-light); }
  .cs-nav__item ul { display: flex; flex-wrap: wrap; gap: 8px; margin: auto 0 0; padding: 0; list-style: none; }
  .cs-nav__item a {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--wine);
    border-radius: 999px;
    font-size: var(--fs-small);
    color: var(--wine);
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-nav__item a:hover { background: var(--wine); color: var(--white); }

  /* ---------- Каталог ---------- */
  .cs-devices { padding-bottom: 80px; }
  .cs-devices__lead { margin-top: 16px; max-width: 640px; color: var(--muted); }
  .cs-devices__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-card { display: flex; flex-direction: column; padding: 36px; border: 1px solid var(--line); scroll-margin-top: 90px; }
  .cs-card h3 { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-regular); }
  .cs-card p { margin-top: 12px; color: var(--muted); }
  .cs-card p.cs-card__for { color: var(--graphite); }
  .cs-card__link { margin-top: auto; padding-top: 22px; font-family: var(--font); color: var(--wine); text-decoration: underline; text-underline-offset: 4px; }
  .cs-card__link:hover { color: var(--graphite); }
  .cs-card--soft { background: var(--ivory); border-color: var(--ivory); }
  .cs-card--soft p { color: var(--graphite); }
  .cs-all { margin-top: 32px; text-align: center; font-family: var(--font); }
  .cs-all a { color: var(--wine); text-decoration: underline; text-underline-offset: 4px; }

  /* ---------- Принципы (винная полоса) ---------- */
  .cs-results { background: var(--wine); color: var(--white); }
  .cs-results__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 64px; padding-top: 72px; padding-bottom: 72px; }
  .cs-results__title { font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }
  .cs-results__note { margin-top: 20px; max-width: 380px; color: rgba(255, 255, 255, 0.85); }
  .cs-results__list { margin: 0; padding: 0; list-style: none; }
  .cs-results__list li {
    padding: 16px 0 16px 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    background: url('/images/star.svg') 0 22px / 15px no-repeat;
    font-family: var(--font);
    font-size: var(--fs-h3);
    font-weight: var(--w-thin);
  }
  .cs-results__list li:first-child { padding-top: 0; background-position: 0 6px; }

  /* ---------- Шаги ---------- */
  .cs-steps { padding-top: 88px; padding-bottom: 72px; }
  .cs-steps__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-steps__num { display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--wine); border-radius: 50%; color: var(--wine); font-family: var(--font); font-size: var(--fs-body); }
  .cs-steps__list h3 { margin-top: 20px; font-size: var(--fs-h3); }
  .cs-steps__list p { margin-top: 10px; color: var(--muted); }

  /* ---------- Вопросы ---------- */
  .in-faq { padding-bottom: 88px; }
  .in-faq__list { max-width: 900px; margin-top: 32px; }
  .in-faq details { border-top: 1px solid var(--line); padding: 20px 0; }
  .in-faq details:last-child { border-bottom: 1px solid var(--line); }
  .in-faq summary { display: flex; justify-content: space-between; gap: 20px; cursor: pointer; list-style: none; font-family: var(--font); font-size: var(--fs-h3); font-weight: var(--w-light); }
  .in-faq summary::-webkit-details-marker { display: none; }
  .in-faq summary::after { content: '+'; flex: none; color: var(--wine); font-size: var(--fs-h3); line-height: 1; }
  .in-faq details[open] summary::after { content: '×'; }
  .in-faq details p { margin-top: 14px; max-width: 760px; color: var(--muted); }

  /* ---------- Противопоказания / аппаратные методы ---------- */
  .cs-med { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-bottom: 88px; }
