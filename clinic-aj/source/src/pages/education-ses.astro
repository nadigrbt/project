import CoursePage from '../components/CoursePage.astro';

const benefits = [
  { title: 'Переподготовка', text: 'Профессиональная переподготовка.' },
  { title: 'Диплом', text: 'Диплом государственного образца.' },
  { title: 'Для медсестёр', text: 'Работа медицинской сестры в косметологии.' },
  { title: 'На базе клиники', text: 'Обучение в клинике эстетической косметологии A&J.' },
];
const facts = [
  { value: 'Диплом', text: 'государственного образца по окончании' },
  { value: '9', text: 'видов косметологических процедур в программе' },
  { value: '8', text: 'изучаемых предметов' },
];
const procedures = [
  'Инъекционные методики',
  'Аппаратные методики',
  'Массажи лица и тела',
  'Косметический комплексный уход',
  'Процедуры по уходу за бровями и ресницами',
  'Химические пилинги',
  'Чистки (механические, аппаратные и комбинированные)',
  'Депиляция (шугаринг, ваксинг)',
  'Маникюр и педикюр',
];
const subjects = [
  'Организационно-правовые основы деятельности сестринского персонала',
  'Профессиональные стандарты в сфере здравоохранения',
  'История развития сестринского дела',
  'Теория и философия сестринского дела, стандарты медицинской помощи',
  'Особенности организации лекарственного обеспечения в системе медико-санитарной помощи',
  'Сестринская помощь в косметологии',
  'Особенности организации и оказания сестринской помощи в косметологии',
  'Современные сестринские технологии в косметологии',
];
const photos = [
  { key: 'eduSes1', alt: 'Аппаратная процедура в кабинете клиники A&J' },
  { key: 'eduSes2', alt: 'Специалист клиники проводит процедуру для лица' },
  { key: 'eduSes3', alt: 'Кабинет клиники A&J во время процедуры' },
] as const;
const faq = [
  { q: 'Какой документ выдают?', a: 'Диплом государственного образца о профессиональной переподготовке по программе «Сестринское дело в косметологии».' },
  { q: 'Какие процедуры может выполнять медицинская сестра?', a: 'Медицинским сёстрам разрешено выполнять многие виды косметологических процедур по назначению главного врача. Список видов процедур — выше на странице.' },
  { q: 'Кто может поступить?', a: 'Требования к поступающим уточняйте у администраторов.' },
