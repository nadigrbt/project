---
// Страница /education-cosmetic — курс «Косметолог-эстетист» учебного центра A&J (шаблон components/CoursePage.astro).
// Тексты со страницы Тильды. Убраны: цена 110 000 руб. (правило «без цен»), «Такое возможно в Мурманской области только на базе клиники A&J»,
// «современные и сертифицированные» аппараты (38-ФЗ, у LPG нет РЗН). Фото — со старой страницы.
import CoursePage from '../components/CoursePage.astro';

const benefits = [
  { title: 'Без медобразования', text: 'Медицинское образование для программы не требуется.' },
  { title: 'Свидетельство о профессии', text: 'Сведения вносятся в реестр ФРДО.' },
  { title: 'Практика на моделях', text: 'Моделей предоставляет клиника.' },
  { title: 'Рассрочка', text: 'Возможна оплата в рассрочку.' },
];
const facts = [
  { value: '275', text: 'академических часов в программе' },
  { value: '82', text: 'академических часа теории, около 30% программы' },
  { value: '193', text: 'академических часа практики, около 70% программы' },
];
const photos = [
  { key: 'eduCos1', alt: 'Косметолог клиники A&J проводит процедуру' },
  { key: 'eduCos2', alt: 'Аппаратная процедура: насадка на коже шеи' },
  { key: 'eduCos3', alt: 'Работа косметолога с моделью в кабинете клиники' },
] as const;
const faq = [
  { q: 'Нужно ли медицинское образование?', a: 'Нет, для программы «Косметолог-эстетист» медицинское образование не требуется.' },
  { q: 'Какой документ выдают?', a: 'Свидетельство о профессии согласно приказу Министерства просвещения РФ от 14 июля 2023 г. № 534. Это официальный документ, сведения о нём вносятся в ФРДО.' },
  { q: 'Как проходит теория?', a: 'Теорию дают для дистанционной работы: презентации, доклады и т. д. Практика проходит в клинике на аппаратах и с моделями.' },
  { q: 'Можно ли оплатить в рассрочку?', a: 'Да, возможна рассрочка. Подробности уточняйте у администраторов.' },
];
---
<CoursePage
  metaTitle="Курсы косметолога-эстетиста в Мурманске — учебный центр A&J"
  description="Обучение «Косметолог-эстетист» в учебном центре клиники A&J в Мурманске: 275 академических часов, практика на аппаратах и моделях. Без медицинского образования."
  crumb="Косметолог-эстетист"
  title="Косметолог-эстетист"
  subtitle="обучение профессии"
  lead="На базе клиники эстетической косметологии A&J можно пройти обучение по программе «Косметолог-эстетист» и получить официальное свидетельство о профессии. После обучения можно работать в косметологии и салонах красоты."
  benefits={benefits}
  facts={facts}
  photos={[...photos]}
  faq={faq}
>
  <section class="container bio-block">
    <p class="cs-eyebrow">О программе</p>
    <h2 class="cs-title">Ручные методики и аппаратные технологии</h2>
    <ul class="bio-pair">
      <li><h3>Теория</h3><p>82 академических часа теории — программа, составленная врачами клиники. Материалы подобраны так, чтобы дать базовые знания в области эстетической косметологии. Теорию дают для дистанционной работы: презентации, доклады и т. д.</p></li>
      <li><h3>Практика</h3><p>193 академических часа практики — работа с моделями и аппаратами клиники под руководством специалистов. Можно отработать полученные знания, задать вопросы и получить развёрнутые ответы.</p></li>
    </ul>
    <p>Программа включает ручные методики ухода за лицом и аппаратные технологии. В обучении используются аппараты Hydrafacial, Profacial, Heleo4 и LPG Cellu M6 Alliance.</p>
  </section>

  <section class="cs-results bio-results">
    <div class="container cs-results__inner">
      <div>
        <h2 class="cs-results__title">Документ об окончании</h2>
        <p class="cs-results__note">Официальный документ, который можно предъявить работодателю.</p>
      </div>
      <ul class="cs-results__list">
        <li>Свидетельство о профессии</li>
        <li>Согласно приказу Минпросвещения России от 14.07.2023 № 534</li>
        <li>Сведения вносятся в ФРДО — Федеральный реестр сведений о документах об образовании и (или) о квалификации, документах об обучении</li>
      </ul>
    </div>
  </section>
</CoursePage>
