---
// Страница /vrachi — «Врачи клиники» (28.10). Список врачей — data/doctors.ts, у каждого своя страница /vrach-<slug> (pages/[doctor].astro).
// Дизайн по образцу /orto (стили — styles/inner.css). Данные о врачах — только с ПроДокторов или от владельца, ничего не выдумываем.
// Для Яндекса: title/description с именами, разметка schema.org (MedicalClinic + сотрудники, список врачей, хлебные крошки), страница в sitemap.xml.
// Ссылки на страницу: меню в шапке и мобильное меню (site.ts → mainNav), подвал, полоса под первым экраном главной, «Что ещё есть в клинике» на направлениях.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Directions from '../components/Directions.astro';
import { site } from '../data/site';
import { img } from '../data/images';
import { doctors, doctorUrl, isIndexable, specialtyLine, experience } from '../data/doctors';
import { abs, breadcrumbsLd, clinicLd, doctorLd } from '../data/schema';
import '../styles/inner.css';

const PRODOCTOROV_CLINIC = 'https://prodoctorov.ru/murmansk/lpu/113320-aj/';

// Список строками сверху вниз: фото слева, сведения справа (решение владельца 28.10, вместо плитки)
const rows = doctors.map((d) => ({
  d,
  url: doctorUrl(d),
  photo: d.photo ? img(d.photo as any) : undefined,
  initials: d.name.split(' ').filter((w) => !w.startsWith('(')).slice(0, 2).map((w) => w[0]).join(''),
  spec: specialtyLine(d),
  exp: experience(d),
}));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    ...clinicLd(),
    sameAs: [...clinicLd().sameAs, PRODOCTOROV_CLINIC],
    employee: doctors.filter(isIndexable).map((d) => doctorLd(d, d.photo ? img(d.photo as any) : undefined)),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Врачи клиники A&J в Мурманске',
    itemListElement: doctors.filter(isIndexable).map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.name, url: abs(doctorUrl(d)) })),
  },
  breadcrumbsLd([{ name: 'Главная', href: '/' }, { name: 'Врачи', href: '/vrachi' }]),
];
---
<Base
  title="Врачи и косметологи клиники A&J в Мурманске: специалисты, стаж, запись"
  description="Врачи и специалисты клиники A&J в Мурманске: врач-косметолог и дерматолог, косметологи-эстетисты, массажист. Стаж и фото специалистов. Запишитесь онлайн или по номеру 78-70-30"
  jsonLd={jsonLd}
>
  <section class="cs-hero">
    <Header />

    <div class="container">
      <nav class="cs-crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Врачи</span>
      </nav>
    </div>

    <div class="container in-hero in-hero--noimg">
      <div class="in-hero__text">
        <p class="cs-eyebrow">Клиника A&amp;J · Мурманск</p>
        <h1 class="cs-hero__title">Врачи и специалисты <span>клиники A&amp;J в&nbsp;Мурманске</span></h1>
        <p class="cs-hero__lead">Выберите специалиста, чтобы узнать о нём подробнее: специальность, стаж и статьи. Или запишитесь на консультацию, и администратор поможет подобрать специалиста.</p>
        <div class="cs-actions">
          <a class="cs-btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
          <a class="cs-phone" href={site.phone.href}>
            <span class="cs-phone__label">или позвоните</span>
            <span class="cs-phone__num">{site.phone.display}</span>
          </a>
        </div>
      </div>
      <div class="in-hero__visual" aria-hidden="true">
        <img class="in-hero__letters" src={img('cosmLetters')} alt="" width="1183" height="821" aria-hidden="true" />
      </div>
    </div>
  </section>

  <main>
    <section class="container dl">
      <ul class="dl__list">
        {rows.map(({ d, url, photo, initials, spec, exp }) => (
          <li class="dl__row">
            <a class="dl__photo" href={url} tabindex="-1" aria-hidden="true">
              {photo
                ? <img src={photo} alt="" width="400" height="500" loading="lazy" />
                : <span class="dl__initials">{initials}</span>}
            </a>
            <div class="dl__info">
              {d.position && <p class="dl__pos">{d.position}</p>}
              <h2 class="dl__name"><a href={url}>{d.name}</a></h2>
              <p class="dl__spec">{spec || 'Специальность уточняется'}</p>
              {exp && <p class="dl__exp">{exp}</p>}
              <div class="dl__actions">
                <a class="dl__btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
                <a class="dl__more" href={url}>Подробнее<span class="dl__more-long"> о специалисте</span> →</a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="container cs-med">
      <div class="cs-med__card">
        <h2>Отзывы пациентов</h2>
        <p class="in-cross__text">Отзывы о специалистах клиники A&amp;J собраны на независимом сайте ПроДокторов.</p>
        <p class="in-cross__links"><a href={PRODOCTOROV_CLINIC} target="_blank" rel="noopener">Отзывы на ПроДокторов →</a></p>
        <p>Имеются противопоказания. Необходима консультация специалиста.</p>
      </div>
      <div class="cs-med__card cs-med__card--alt">
        <h2>Направления клиники</h2>
        <p class="in-cross__text">С чем можно прийти к нашим врачам.</p>
        <p class="in-cross__links">
          <a href="/cosmetology">Аппаратная косметология →</a>
          <a href="/injections">Инъекционная косметология →</a>
          <a href="/estetica">Эстетическая косметология →</a>
          <a href="/blog">Главный врач отвечает в блоге →</a>
        </p>
      </div>
    </section>

    <Directions />

    <section class="cs-cta">
      <div class="container cs-cta__inner">
        <div>
          <h2 class="cs-cta__title">Запишитесь на консультацию</h2>
          <p class="cs-cta__sub">Выберите удобное время онлайн или позвоните, администратор поможет подобрать специалиста.</p>
          <p class="cs-cta__warn">Имеются противопоказания. Необходима консультация специалиста.</p>
        </div>
        <a class="cs-cta__btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
      </div>
    </section>

    <Contacts />
  </main>
  <Footer />
</Base>

<style>
  .dl { padding-top: 56px; padding-bottom: 88px; }
  .dl__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .dl__row { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 40px; align-items: center; padding: 32px 0; border-bottom: 1px solid var(--line); }
  .dl__photo { display: grid; place-items: center; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 100px 100px 0 0; background: var(--ivory); text-decoration: none; }
  .dl__photo img { width: 100%; height: 100%; object-fit: cover; }
  .dl__initials { font-family: var(--font); font-size: var(--fs-h2); font-weight: var(--w-thin); letter-spacing: 4px; color: var(--wine); }
  .dl__pos { font-family: var(--font); font-size: var(--fs-small); letter-spacing: 2px; text-transform: uppercase; color: var(--wine); margin-bottom: 8px; }
  .dl__name { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-regular); }
  .dl__name a { text-decoration: none; }
  .dl__name a:hover { color: var(--wine); }
  .dl__spec { margin-top: 10px; }
  .dl__exp { margin-top: 4px; color: var(--muted); }
  .dl__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 22px; }
  .dl__btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 28px; border-radius: 999px; background: var(--wine); color: var(--white); font-family: var(--font); text-decoration: none; transition: background-color 0.2s; }
  .dl__btn:hover { background: var(--graphite); }
  .dl__more { font-family: var(--font); color: var(--wine); text-decoration: underline; text-underline-offset: 4px; }
  .dl__more:hover { color: var(--graphite); }
  @media (max-width: 959px) {
    .dl { padding-top: 32px; padding-bottom: 60px; }
    .dl__row { grid-template-columns: 110px minmax(0, 1fr); gap: 20px; align-items: start; padding: 24px 0; }
    .dl__photo { border-radius: 55px 55px 0 0; }
    .dl__actions { gap: 12px 20px; margin-top: 16px; }
    .dl__btn { min-height: 44px; padding: 0 22px; }
    .dl__more-long { display: none; }
  }
</style>
