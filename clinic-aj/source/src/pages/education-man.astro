---
// Страница /education-man — повышение квалификации для мастеров маникюра (покрытие PRO STYLE GEL), шаблон components/CoursePage.astro.
// Тексты со страницы Тильды. Убраны: цена 25 000 руб. (правило «без цен»), «инновационное», «новейшее», «переворачивает представления»,
// «безопасное и натуральное», «альтернативный выбор для аллергиков, астматиков, беременных и кормящих», «невероятная красота» (38-ФЗ).
// На старой главной учебного центра этот курс в списке не стоял, на новой /education добавлен четвёртой карточкой. Фото — со старой страницы; на первом экране только буквы A&J (крупный план ногтей без фона не вырезается).
import CoursePage from '../components/CoursePage.astro';

const benefits = [
  { title: '1 день', text: 'Длительность обучения.' },
  { title: 'Один на один', text: 'Преподаватель работает только с вами.' },
  { title: 'Удостоверение', text: 'Сведения вносятся в ФИС ФРДО.' },
  { title: 'Для мастеров', text: 'Для действующих мастеров маникюра.' },
];
const facts = [
  { value: '1 день', text: 'длительность обучения' },
  { value: '1 человек', text: 'в группе: преподаватель один на один с вами' },
  { value: 'ФИС ФРДО', text: 'удостоверение о повышении квалификации вносится в реестр' },
];
const features = [
  { title: 'Гипоаллергенный состав', text: 'По информации производителя, PRO STYLE GEL изготовлен из гипоаллергенных материалов и не содержит акрилов, мономеров и кислот.' },
  { title: 'Бережное снятие', text: 'Специальный размачивающий компонент помогает снимать покрытие бережно к ногтевой пластине.' },
  { title: 'Широкая палитра', text: 'Много цветов и оттенков для разных дизайнов.' },
  { title: 'Тонкое покрытие', text: 'За счёт тонкого нанесения маникюр выглядит естественно и при этом долго держится.' },
];
const photos = [
  { key: 'eduMan1', alt: 'Ногти до и после покрытия PRO STYLE GEL' },
  { key: 'eduMan2', alt: 'Маникюр с покрытием PRO STYLE GEL' },
  { key: 'eduMan3', alt: 'Витрина с покрытием PRO STYLE GEL в клинике A&J' },
] as const;
const faq = [
  { q: 'Для кого курс?', a: 'Для действующих мастеров маникюра, которые хотят освоить работу с покрытием PRO STYLE GEL.' },
  { q: 'Как проходит обучение?', a: 'Один день, один на один с преподавателем: он объяснит все тонкости и нюансы нанесения покрытия и ответит на вопросы.' },
  { q: 'Какой документ выдают?', a: 'Официальное удостоверение о повышении квалификации, сведения о нём вносятся в ФИС ФРДО.' },
];
---
<CoursePage
  metaTitle="Курс PRO STYLE GEL для мастеров маникюра в Мурманске — A&J"
  description="Повышение квалификации для мастеров маникюра в учебном центре клиники A&J в Мурманске: покрытие PRO STYLE GEL, индивидуально, удостоверение в ФИС ФРДО."
  crumb="Повышение квалификации для мастеров маникюра"
  title="PRO STYLE GEL"
  subtitle="для мастеров маникюра"
  lead="Курс повышения квалификации для действующих мастеров маникюра на базе клиники A&J: методика работы с гипоаллергенным покрытием PRO STYLE GEL. По окончании выдаётся удостоверение о повышении квалификации."
  benefits={benefits}
  facts={facts}
  photos={[...photos]}
  faq={faq}
>
  <section class="container bio-block">
    <p class="cs-eyebrow">О покрытии</p>
    <h2 class="cs-title">Особенности PRO STYLE GEL</h2>
    <ul class="bio-zones lm-zones">{features.map((f) => <li><h3>{f.title}</h3><p>{f.text}</p></li>)}</ul>
  </section>
</CoursePage>
