---
// Страница /clean — «Чистки лица», эстетическая косметология (по образцу /lazer, /lpg), 5 размеров шрифта (шкала --fs-*).
// Владелец 26.10: обязательно написать про все виды чисток и добавить блоки с аппаратами для чистки.
// Виды: ручная (текст с /estetica), комбинированная Christina Comodex (7 этапов, механическая + ультразвук), атравматическая Holy Land (9 этапов), аппаратные на PRO FACIAL и HydraFacial — со страницы Тильды /clean.
// Убраны «оригинальные аппараты», «прекрасные результаты», «активирует липолиз», «воздействует на жировые отложения», «ремоделирует коллаген», «сыворотка с фактором роста», «не имеет возрастных ограничений» (38-ФЗ);
// исправлены «HUDRA» → HydraFacial, «Ааквапилинг», «камедонов». HydraFacial Allegro — Edge Systems (США), РЗН 2016/3600 от 28.01.2016 (удостоверение от владельца 18.10), фото из каталога /cosmetology.
// PRO FACIAL — производитель и РЗН не подтверждены; фото от владельца 26.10 (device-profacial.webp), оно же в карусели и каталоге /cosmetology. Ультразвуковой скрабер — есть в клинике (владелец 26.10), модель не названа; фото device-scrubber.webp от владельца 26.10, только для /clean (на /cosmetology скрабера нет — решение владельца). Время процедур не пишем. Видео со старой страницы — плавающее окошко. Копию Тильды не делаем.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Directions from '../components/Directions.astro';
import { site } from '../data/site';
import { img } from '../data/images';

const videoUrl = 'https://cd75615.tw1.ru/clean.mp4';
const benefits = [
  { title: 'Консультация косметолога', text: 'Подберём вид чистки под тип и состояние кожи.' },
  { title: 'Пять видов чистки', text: 'Ручная, комбинированная, атравматическая и две аппаратные.' },
  { title: 'Профессиональная косметика', text: 'Christina Comodex и Holy Land.' },
  { title: 'Аппараты для чистки', text: 'PRO FACIAL и HydraFacial Allegro.' },
];
const types = [
  { id: 'manual', title: 'Ручная чистка лица', forWhat: 'Загрязнения, чёрные точки, неровная кожа.', text: 'Косметолог вручную очищает кожу от загрязнений и омертвевших клеток, удаляет чёрные точки и делает массаж. Используются специальные инструменты и косметика, подобранные под ваш тип кожи.', ind: [] },
  { id: 'comodex', title: 'Комбинированная чистка Christina Comodex', forWhat: 'Жирная и проблемная кожа.', text: 'Профессиональная линия Christina Comodex: 7 этапов нанесения косметических средств, механическая чистка инструментами и дополнительная чистка ультразвуком.', ind: ['жирная, проблемная кожа', 'акне, комедоны, сальные пробки', 'нездоровый цвет лица, воспаления, покраснения', 'расширенные поры'] },
  { id: 'holyland', title: 'Атравматическая чистка Holy Land', forWhat: 'Для сухой, жирной, нормальной и комбинированной кожи.', text: 'Протокол из 9 этапов на косметике Holy Land. Длительность зависит от состояния кожи.', ind: ['нездоровый цвет лица', 'сальные пробки, прыщи, угри', 'потеря эластичности и упругости', 'сухость, шелушение', 'широкие поры, бугристый рельеф'] },
  { id: 'profacial', title: 'Аппаратный уход PRO FACIAL', forWhat: 'Комплексный уход за один визит.', text: 'Четыре этапа на одном аппарате: аквапилинг, ионофорез, ультразвук и многополюсный RF-лифтинг.', ind: [] },
  { id: 'hydrafacial', title: 'Аппаратная чистка HydraFacial', forWhat: 'Очищение, отшелушивание и увлажнение.', text: 'Вакуумное очищение пор, мягкое отшелушивание и насыщение кожи увлажняющими сыворотками. Несколько программ под задачу.', ind: [] },
];
const profacial = [
  'Аквапилинг — бережное отшелушивание, глубокое очищение и увлажнение кожи специальной насадкой.',
  'Ионофорез — слабые токи улучшают микроциркуляцию и помогают активным веществам проникнуть в кожу.',
  'Ультразвук — стимулирует микроциркуляцию и лимфодренаж.',
  'Многополюсный RF-лифтинг — прогревает кожу, поддерживает её упругость и выработку коллагена.',
];
const hydra = [
  'Базовая: демакияж, эксфолиация, экстракция, гидратация, защита.',
  'Глубокое очищение: демакияж, эксфолиация, экстракция, механическое удаление комедонов, антисептическая маска, защита.',
  'Интенсивное увлажнение: демакияж, эксфолиация, увлажняющая сыворотка, гидратация, увлажняющая маска, защита.',
];
const whenList = [
  'Чёрные точки, комедоны, сальные пробки',
  'Расширенные поры и неровный рельеф',
  'Тусклый, нездоровый цвет лица',
  'Сухость, шелушение, усталый вид кожи',
  'Жирная или проблемная кожа, акне и постакне',
];
const steps = [
  { title: 'Консультация', text: 'Косметолог оценит тип и состояние кожи и подберёт вид чистки.' },
  { title: 'Чистка', text: 'Очищение, отшелушивание и удаление загрязнений по протоколу выбранной процедуры, затем успокаивающие и увлажняющие средства.' },
  { title: 'Рекомендации', text: 'Косметолог расскажет, как ухаживать за кожей после чистки и когда прийти снова.' },
];
const faq = [
  { q: 'Какую чистку выбрать?', a: 'Это зависит от типа и состояния кожи. Ручная и комбинированная подходят для жирной и проблемной кожи, атравматическая — для разных типов кожи, аппаратные сочетают очищение с уходом. Точнее подскажет косметолог на консультации.' },
  { q: 'Чем ручная чистка отличается от аппаратной?', a: 'При ручной чистке косметолог очищает кожу инструментами и руками, при аппаратной используется специальный прибор. Часто методы сочетают.' },
  { q: 'Будет ли покраснение после чистки?', a: 'После ручной и комбинированной чистки кожа может быть покрасневшей и чувствительной, обычно это быстро проходит. Реакция кожи индивидуальна, подробности расскажет косметолог.' },
  { q: 'Как часто нужно делать чистку?', a: 'Частоту подбирает косметолог в зависимости от типа кожи и выбранной процедуры.' },
];
const contra = [
  'острые воспалительные заболевания кожи в зоне процедуры',
  'герпес в стадии обострения',
  'повреждения кожи, свежие раны в зоне процедуры',
  'острые инфекционные заболевания, повышенная температура',
  'аллергия на компоненты косметических средств',
  'для аппаратных процедур с токами и RF: кардиостимулятор, металлические импланты в зоне процедуры, беременность',
];
---
<Base
  title="Чистка лица в Мурманске: ручная, атравматическая, HydraFacial | Клиника эстетической косметологии A&J"
  description="Чистки лица в клинике A&J в Мурманске: ручная, комбинированная Christina Comodex, атравматическая Holy Land, аппаратные PRO FACIAL и HydraFacial. Запишитесь онлайн или по номеру 78-70-30"
>
  <section class="cs-hero">
    <Header />

    <div class="container">
      <nav class="cs-crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/estetica">Эстетическая косметология</a><span class="cs-crumbs__sep" aria-hidden="true">/</span><span aria-current="page">Чистки лица</span>
      </nav>
    </div>

    <div class="container in-hero">
      <div class="in-hero__text">
        <p class="cs-eyebrow">Эстетическая косметология</p>
        <h1 class="cs-hero__title">Чистки лица <span>ручные и аппаратные</span></h1>
        <p class="cs-hero__lead">Процедуры, которые помогают очистить кожу от загрязнений и чёрных точек и улучшить её состояние. После чистки кожа выглядит более гладкой и свежей. Вид чистки косметолог подберёт на консультации.</p>
        <div class="cs-actions">
          <a class="cs-btn" href="#contact">Записаться на консультацию</a>
          <a class="cs-phone" href={site.phone.href}>
            <span class="cs-phone__label">или позвоните</span>
            <span class="cs-phone__num">{site.phone.display}</span>
          </a>
        </div>
      </div>
      <div class="in-hero__visual" aria-hidden="true">
        <img class="in-hero__letters" src={img('cosmLetters')} alt="" width="1183" height="821" aria-hidden="true" />
        <img class="in-hero__woman" src={img('cleanWoman')} alt="" width="700" height="700" fetchpriority="high" aria-hidden="true" />
      </div>
    </div>

    <div class="cs-benefits">
      <ul class="container cs-benefits__list">
        {benefits.map((b) => (
          <li>
            <img src={img('star')} alt="" width="15" height="15" />
            <div><strong>{b.title}</strong><span>{b.text}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <main>
    <section class="container cs-intro">
        <p class="cs-eyebrow">О процедуре</p>
        <h2 class="cs-title">Зачем нужна чистка лица</h2>
        <p class="cs-intro__text">Чистка помогает убрать загрязнения, чёрные точки и омертвевшие клетки, которые не смываются домашним уходом. В клинике есть ручная, комбинированная и атравматическая чистки на профессиональной косметике и аппаратные процедуры на PRO FACIAL и HydraFacial. Какой вид подойдёт вам, зависит от типа и состояния кожи. Результат у каждого свой.</p>
    </section>

    <section class="container cs-devices lz-devices">
      <p class="cs-eyebrow">Виды чисток</p>
      <h2 class="cs-title">Какие чистки мы делаем</h2>
      <ul class="cs-devices__grid">
        {types.map((t) => (
          <li class="cs-card" id={t.id}>
            <h3>{t.title}</h3>
            <p class="cs-card__for">{t.forWhat}</p>
            <p>{t.text}</p>
            {t.ind.length > 0 && <ul class="cl-ind">{t.ind.map((i) => <li>{i}</li>)}</ul>}
            {(t.id === 'profacial' || t.id === 'hydrafacial')
              ? <a class="cs-card__link" href={`#dv-${t.id}`}>Об аппарате →</a>
              : <a class="cs-card__link" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн →</a>}
          </li>
        ))}
      </ul>
    </section>

    <section class="container dv" id="dv-hydrafacial">
      <div class="dv__card">
        <div class="dv__pic"><img class="dv__img--wide" src={img('deviceHydrafacial')} alt="Аппарат HydraFacial Allegro для аппаратной чистки лица" width="640" height="597" loading="lazy" /></div>
        <div class="dv__text">
          <p class="cs-eyebrow">Аппарат для чистки</p>
          <h2>HydraFacial Allegro</h2>
          <p>Вакуумное очищение пор, мягкое отшелушивание и насыщение кожи увлажняющими сыворотками. Программу косметолог подбирает под задачу:</p>
          <ul class="cl-steps">{hydra.map((x) => <li>{x}</li>)}</ul>
          <dl class="dv__list">
          <div><dt>Производитель</dt><dd>Edge Systems, США</dd></div>
          <div><dt>Регистрация</dt><dd>РЗН 2016/3600 от 28.01.2016</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="container dv" id="dv-profacial">
      <div class="dv__card">
        <div class="dv__pic"><img class="dv__img--wide" src={img('deviceProfacial')} alt="Аппарат PRO FACIAL для аппаратной чистки и ухода за кожей лица" width="800" height="777" loading="lazy" /></div>
        <div class="dv__text">
          <p class="cs-eyebrow">Аппарат для чистки</p>
          <h2>PRO FACIAL</h2>
          <p>Позволяет за один визит последовательно провести четыре этапа ухода:</p>
          <ol class="cl-steps">{profacial.map((x) => <li>{x}</li>)}</ol>
          <dl class="dv__list">
          <div><dt>Регистрация</dt><dd></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="container dv" id="dv-scrubber">
      <div class="dv__card">
        <div class="dv__pic"><img class="dv__img--sm" src={img('deviceScrubber')} alt="Ультразвуковой скрабер для чистки лица" width="505" height="800" loading="lazy" /></div>
        <div class="dv__text">
          <p class="cs-eyebrow">Аппарат для чистки</p>
          <h2>Ультразвуковой скрабер</h2>
          <p>Металлическая лопатка-насадка колеблется с ультразвуковой частотой. Скрабер мягко очищает поверхность кожи и поры без механического давления. Косметолог использует его в комбинированной чистке и как отдельный этап ухода, режим подбирает под тип кожи.</p>
        </div>
      </div>
    </section>

    <section class="cs-results bio-results">
      <div class="container cs-results__inner">
        <div>
          <h2 class="cs-results__title">Когда стоит сделать чистку</h2>
          <p class="cs-results__note">Какой вид чистки нужен именно вам, подскажет косметолог.</p>
        </div>
        <ul class="cs-results__list">
          {whenList.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>

    <section class="container cs-steps">
      <h2 class="section-title">Как проходит процедура</h2>
      <ol class="cs-steps__list">
        {steps.map((s, i) => (
          <li>
            <span class="cs-steps__num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="container in-faq">
      <p class="cs-eyebrow">Вопросы и ответы</p>
      <h2 class="cs-title">Что обычно спрашивают</h2>
      <div class="in-faq__list">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container cs-med">
      <div class="cs-med__card">
        <h2>Когда процедура может быть невозможна</h2>
        <ul>
          {contra.map((c) => <li>{c}</li>)}
        </ul>
        <p>Это общий перечень, окончательное решение принимает специалист. Имеются противопоказания. Необходима консультация специалиста.</p>
      </div>
      <div class="cs-med__card cs-med__card--alt">
        <h2>Другие процедуры для кожи</h2>
        <p class="in-cross__text">Чистку часто сочетают с другими процедурами. Посмотрите, что ещё есть в клинике.</p>
        <p class="in-cross__links">
          <a href="/estetica">Эстетическая косметология →</a>
          <a href="/estetica#peel">Пилинги →</a>
          <a href="/heleo4">LED-терапия Heleo4 →</a>
          <a href="/biorevitalization">Биоревитализация →</a>
          <a href="/cosmetology">Аппаратная косметология →</a>
          <a href="/sale">Акции →</a>
        </p>
      </div>
    </section>

    <Directions current="/estetica" />

    <section class="cs-cta">
      <div class="container cs-cta__inner">
        <div>
          <h2 class="cs-cta__title">Не знаете, какую чистку выбрать?</h2>
          <p class="cs-cta__sub">Приходите на консультацию: косметолог оценит кожу и подберёт процедуру.</p>
          <p class="cs-cta__warn">Имеются противопоказания. Необходима консультация специалиста.</p>
        </div>
        <a class="cs-cta__btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
      </div>
    </section>

    <Contacts />
  </main>
  <Footer />
  <script is:inline src="/video-widget.js?v=1" data-src={videoUrl} defer></script>
</Base>

<style>
  /* Размеры шрифта — только из общей шкалы --fs-* (styles/global.css), 5 размеров */

  .cs-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: var(--w-regular);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wine);
  }
  .cs-eyebrow::before { content: ''; width: 40px; height: 1px; background: currentColor; }
  .cs-title { margin-top: 20px; font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }

  /* ---------- Первый экран ---------- */
  .cs-hero { position: relative; overflow: hidden; background: var(--white); }
  .cs-crumbs { display: flex; gap: 10px; padding-top: 40px; font-size: var(--fs-small); color: var(--muted); }
  .cs-crumbs > * { white-space: nowrap; }
  .cs-crumbs a { text-decoration: none; }
  .cs-crumbs a:hover { color: var(--wine); }
  .in-hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 40px; align-items: end; padding-top: 28px; padding-bottom: 0; }
  .cs-hero__title { margin-top: 20px; font-size: var(--fs-h1); line-height: 1.12; font-weight: var(--w-thin); }
  .cs-hero__title span { display: block; color: var(--wine); font-size: var(--fs-h2); line-height: 1.25; margin-top: 8px; }
  .cs-hero__lead { margin-top: 24px; max-width: 520px; color: var(--muted); }
  .in-hero__text { padding-bottom: 64px; }
  .in-hero__visual { position: relative; display: grid; justify-items: center; align-items: end; min-height: 440px; overflow: hidden; }
  .in-hero__letters { position: absolute; left: 50%; bottom: 0; width: 100%; max-width: 640px; height: auto; transform: translate(-50%, 14%); opacity: 0.28; clip-path: inset(0 0 14% 0); pointer-events: none; }
  .in-hero__woman { position: relative; width: 460px; max-width: 100%; height: auto; }

  .cs-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px 32px; margin-top: 32px; }
  .cs-btn,
  .cs-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    border-radius: 999px;
    font-family: var(--font);
    font-size: var(--fs-body);
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-btn { background: var(--wine); color: var(--white); }
  .cs-btn:hover { background: var(--graphite); }
  .cs-phone { display: grid; text-decoration: none; line-height: 1.2; }
  .cs-phone__label { font-size: var(--fs-small); color: var(--muted); }
  .cs-phone__num { font-family: var(--font); font-size: var(--fs-h3); letter-spacing: 0.5px; }
  .cs-phone:hover .cs-phone__num { color: var(--wine); }

  .cs-benefits { border-top: 1px solid var(--line); }
  .cs-benefits__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0 auto;
    padding-top: 32px;
    padding-bottom: 36px;
    list-style: none;
  }
  .cs-benefits__list li { display: flex; gap: 10px; font-size: var(--fs-small); line-height: 1.45; }
  .cs-benefits__list img { flex: none; margin-top: 5px; }
  .cs-benefits__list strong { display: block; font-family: var(--font); font-size: var(--fs-body); font-weight: var(--w-regular); }
  .cs-benefits__list span { color: var(--muted); }

  /* ---------- О направлении ---------- */
  .cs-intro { padding-top: 88px; }
  .cs-intro > * { max-width: 820px; }
  .cs-intro__text { margin-top: 24px; }

  /* ---------- Подбор по задаче ---------- */
  .cs-nav { padding-top: 72px; padding-bottom: 72px; }
