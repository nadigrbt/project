---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Promo from '../components/Promo.astro';
import Services from '../components/Services.astro';
import SiteSearch from '../components/SiteSearch.astro';
import Education from '../components/Education.astro';
import Gallery from '../components/Gallery.astro';
import About from '../components/About.astro';
import Contacts from '../components/Contacts.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';
import Footer from '../components/Footer.astro';

// Вопросы и ответы (15.11, SEO): адреса, график, лицензия — из data/site.ts, услуги — ссылки на страницы
const faq = [
  { q: 'Где находится клиника A&J в Мурманске?', a: 'У клиники три филиала: улица Карла Либкнехта, 28 (4 этаж, кабинет 411), улица Воровского, 5/23 (4 этаж, кабинет 413), и Кольский проспект, 97/3. Адреса на карте — в разделе «Контакты» внизу страницы.' },
  { q: 'Какой режим работы клиники?', a: `${site.schedule}.` },
  { q: 'Как записаться на приём?', a: 'Онлайн через кнопку «Записаться онлайн» или по номеру 78-70-30. Администратор поможет выбрать процедуру, специалиста и удобный филиал.' },
  { q: 'Есть ли у клиники медицинская лицензия?', a: `Да. ${site.legalName} (клиника A&J) работает по лицензии на медицинскую деятельность № ${site.license}.`, links: [{ href: '/license', label: 'Лицензия клиники' }] },
  { q: 'Какие услуги есть в клинике?', a: 'Аппаратная и инъекционная косметология, лазерная эпиляция, эстетическая косметология (чистки, пилинги, массаж), укрепление мышц тазового дна на кресле BTL Emsella, перманентный макияж, прокол ушей, подология и педикюр, индивидуальные ортопедические стельки.', links: [{ href: '/cosmetology', label: 'Аппаратная косметология' }, { href: '/injections', label: 'Инъекционная косметология' }, { href: '/lazer', label: 'Лазерная эпиляция' }, { href: '/estetica', label: 'Эстетическая косметология' }, { href: '/pedikur', label: 'Подология' }, { href: '/orto', label: 'Ортопедические стельки' }, { href: '/vrachi', label: 'Врачи клиники' }] },
  { q: 'Где почитать ответы врача о процедурах?', a: 'В блоге клиники: главный врач Валерия Смыкова отвечает на частые вопросы пациентов.', links: [{ href: '/blog', label: 'Блог клиники' }, { href: '/blog-botulino', label: 'Сколько держится ботулотоксин' }, { href: '/blog-lazer', label: 'Автозагар и лазерная эпиляция' }, { href: '/blog-ems1', label: 'Emsella при эндометриозе' }] },
  { q: 'Можно ли пройти обучение в клинике?', a: 'Да, при клинике работает учебный центр: курсы «Косметолог-эстетист», «Сестринское дело в косметологии», педикюр с введением в подологию и курс для мастеров маникюра.', links: [{ href: '/education', label: 'Учебный центр' }, { href: '/education-cosmetic', label: 'Косметолог-эстетист' }, { href: '/education-ses', label: 'Сестринское дело в косметологии' }, { href: '/education-ped', label: 'Курс педикюра' }, { href: '/education-man', label: 'Курс для мастеров маникюра' }] },
];
---
<Base
  title="Клиника косметологии и дерматологии A&J в Мурманске"
  description="Медицинская лицензия, специалисты с медицинским образованием, современные аппараты и сертифицированные препараты. Три адреса в Мурманске. Запись: 78-70-30"
  ogTitle="Медицинская клиника и эстетическая косметология A&J"
  ogDescription="Медицина и косметология в Мурманске. Специалисты с медицинским образованием. Лицензионное современное оборудование"
>
  <main>
    <Hero />
    <Promo />
    <!-- Поиск по сайту (18.11, по просьбе владельца — перед «Нашими услугами») -->
    <section class="home-search" aria-label="Поиск по сайту">
      <div class="container"><SiteSearch /></div>
    </section>
    <Services />
    <Education />
    <Gallery />
    <About />
    <Faq items={faq} />
    <Contacts />
  </main>
  <Footer />
</Base>

<style>
  /* Полоса с поиском на фоне «Наших услуг», без отдельной границы между ними */
  .home-search { background: var(--cream); padding: 80px 0 0; }
  .home-search :global(.ssearch) { max-width: none; }
  @media (max-width: 959px) { .home-search { padding-top: 48px; } }
</style>
