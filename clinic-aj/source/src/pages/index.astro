---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Promo from '../components/Promo.astro';
import Services from '../components/Services.astro';
import Education from '../components/Education.astro';
import Gallery from '../components/Gallery.astro';
import About from '../components/About.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Клиника эстетической косметологии A&J в Мурманске — 3 адреса"
  description="Аппаратная и инъекционная косметология, лазерная эпиляция, подология и учебный центр. Специалисты с медицинским образованием, лицензия. Запись: 78-70-30"
  ogTitle="Медицинская клиника и эстетическая косметология A&J"
  ogDescription="Медицина и косметология в Мурманске. Специалисты с медицинским образованием. Лицензионное современное оборудование"
>
  <main>
    <Hero />
    <Promo />
    <Services />
    <Education />
    <Gallery />
    <About />
    <Contacts />
  </main>
  <Footer />
</Base>
