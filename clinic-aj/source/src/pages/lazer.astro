---
// Страница /lazer — «Лазерная эпиляция», направление клиники (directions.ts), три аппарата: IXTRON-SPRINT (подробно — /lazer_aleksandrit), MeDioStar Monolith (/mediostar), Magic One 4000W.
// Дизайн по образцу /lpg, /emsella, 5 размеров шрифта. Тексты со страниц Тильды /lazer и /lazer_aleksandrit, освежены по 38-ФЗ: убраны «новейший», «одни из самых лучших и мощных», «сертифицированы и безопасны»,
// «безопасна и эффективна», «премиальный уровень», «максимально комфортной и безопасной», «признан одной из самых быстрых и безопасных платформ», «результат с первого сеанса», «подходит для всех типов кожи и волос»,
// «учтены недостатки прошлых поколений», «требует меньше процедур», «поколения 2025 года». Курс 6–10 процедур не пишем (число процедур не указываем, решение владельца). РЗН аппаратов эпиляции нет, не пишем.
// MeDioStar — «диодный двухволновой и александритовый лазеры в одном аппарате» (подтверждено владельцем 21.10). Филиалы — со старой страницы. Рекомендации перед процедурой — со старой страницы /lazer_aleksandrit.
// Противопоказания — как на /mediostar (подтверждены владельцем) + автозагар. SEO: страница /lazer_aleksandrit отдельная (решение владельца 21.10: люди ищут именно александритовый лазер), страницы ссылаются друг на друга.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Directions from '../components/Directions.astro';
import { site } from '../data/site';
import { img } from '../data/images';

const benefits = [
  { title: 'Три аппарата', text: 'Александритовый IXTRON-SPRINT, MeDioStar Monolith и диодный Magic One 4000W.' },
  { title: 'Подбор параметров', text: 'С учётом фототипа кожи, плотности и структуры волос и зоны.' },
  { title: 'Системы охлаждения', text: 'Помогают сделать процедуру мягче.' },
  { title: 'Медицинская клиника', text: 'Лицензия и специалисты с медицинским образованием.' },
];
const devices = [
  { id: 'ixtron', href: '/lazer_aleksandrit', title: 'Александритовый лазер IXTRON-SPRINT', forWhat: 'Эпиляция любых зон, в том числе больших: ноги, спина, руки.', text: 'Высокая частота вспышек и контактное охлаждение сапфировым кристаллом. Параметры энергии и глубины воздействия подбирают по фототипу.', branch: 'Только в филиале на Карла Либкнехта', link: 'Подробнее об александритовом лазере' },
  { id: 'mediostar', href: '/mediostar', title: 'MeDioStar Monolith', forWhat: 'Эпиляция больших и небольших зон.', text: 'Немецкий аппарат Asclepion: диодный двухволновой и александритовый лазеры в одном аппарате. Система охлаждения делает процедуру мягче.', branch: 'Только в филиале на Воровского (ТЦ «Меридиан»)', link: 'Подробнее об аппарате MeDioStar' },
  { id: 'magic', href: '', title: 'Диодный лазер Magic One 4000W', forWhat: 'Эпиляция разных зон тела и лица.', text: 'Диодный лазер для удаления нежелательных волос. Параметры и курс подбирает специалист.', branch: 'Только в филиале на Кольском проспекте', link: '' },
];
const how = [
  { title: 'Как работает лазер', text: 'Лазер воздействует на меланин в волосе и разрушает волосяной фолликул. Со временем волосы становятся тоньше и растут реже.' },
  { title: 'Почему нужен курс', text: 'Лазер работает только с волосами в активной фазе роста, поэтому одной процедуры недостаточно. Количество сеансов зависит от зоны, гормонального фона и особенностей роста волос.' },
];
const steps = [
  { title: 'Консультация', text: 'Специалист оценит зону, фототип кожи и волосы, расскажет о противопоказаниях и подготовке.' },
  { title: 'Процедура', text: 'Специалист подберёт параметры по фототипу и проведёт процедуру на выбранной зоне.' },
  { title: 'После процедуры', text: 'Вы получите рекомендации по уходу и график следующих посещений.' },
];
const faq = [
  { q: 'Какой аппарат выбрать?', a: 'Это решает специалист на консультации: он учтёт фототип кожи, цвет и структуру волос и зону. Каждый аппарат работает в своём филиале.' },
  { q: 'Сколько нужно процедур?', a: 'Количество сеансов индивидуально и зависит от зоны, гормонального фона и особенностей роста волос. Лазер работает с волосами в активной фазе роста, поэтому нужен курс. Его составит специалист.' },
  { q: 'Это больно?', a: 'Ощущения индивидуальны. Системы охлаждения аппаратов делают процедуру мягче, параметры специалист подбирает под вашу кожу.' },
  { q: 'Можно ли загорать?', a: 'Нет: активного загара нужно избегать за 2 недели до процедуры и 2 недели после неё. К загару относятся солнце, солярий и автозагар.' },
  { q: 'Какие зоны можно обработать?', a: 'Процедуру проводят на любых зонах, где вы хотите избавиться от нежелательных волос.' },
];
const contra = [
  'беременность и грудное вскармливание',
  'онкологические заболевания, подозрительные новообразования и родинки в зоне процедуры',
  'свежий загар, недавнее пребывание на солнце или в солярии, автозагар',
  'приём препаратов, повышающих чувствительность кожи к свету',
  'воспаление, инфекция, герпес в стадии обострения, раны в зоне процедуры',
  'склонность к образованию келоидных рубцов',
  'обострение хронических и аутоиммунные заболевания',
];
const prep = [
  'За 2–3 недели не удалять волосы воском, шугарингом или эпилятором.',
  'За 24 часа сбрить волосы в зоне процедуры.',
  'Избегать активного загара за 2 недели до процедуры и 2 недели после неё. К загару относятся активное солнце, солярий и автозагар.',
];
---
<Base
  title="Лазерная эпиляция в Мурманске — клиника A&J"
  description="Лазерная эпиляция в A&J (Мурманск) на трёх аппаратах: александритовый IXTRON-SPRINT, MeDioStar Monolith, диодный Magic One. Запишитесь онлайн или по номеру 78-70-30"
>
  <section class="cs-hero">
    <Header />

    <div class="container">
      <nav class="cs-crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Лазерная эпиляция</span>
      </nav>
    </div>

    <div class="container in-hero">
      <div class="in-hero__text">
        <p class="cs-eyebrow">Лазерная эпиляция</p>
        <h1 class="cs-hero__title">Лазерная эпиляция <span>на трёх аппаратах клиники</span></h1>
        <p class="cs-hero__lead">Удаление нежелательных волос на александритовом лазере IXTRON-SPRINT, аппарате MeDioStar Monolith и диодном лазере Magic One 4000W. Специалист подберёт аппарат и параметры на консультации.</p>
        <div class="cs-actions">
          <a class="cs-btn" href="#contact">Записаться на консультацию</a>
          <a class="cs-phone" href={site.phone.href}>
            <span class="cs-phone__label">или позвоните</span>
            <span class="cs-phone__num">{site.phone.display}</span>
          </a>
        </div>
      </div>
      <div class="in-hero__visual" aria-hidden="true">
        <img class="in-hero__letters" src={img('cosmLetters')} alt="" width="1183" height="821" aria-hidden="true" />
        <img class="in-hero__woman" src={img('promoWoman')} alt="" width="700" height="700" fetchpriority="high" aria-hidden="true" />
      </div>
    </div>

    <div class="cs-benefits">
      <ul class="container cs-benefits__list">
        {benefits.map((b) => (
          <li>
            <img src={img('star')} alt="" width="15" height="15" />
            <div><strong>{b.title}</strong><span>{b.text}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <main>
    <section class="container cs-intro">
        <p class="cs-eyebrow">О процедуре</p>
        <h2 class="cs-title">Лазерная эпиляция в A&amp;J</h2>
        <p class="cs-intro__text">Для удаления нежелательных волос в клинике используют три медицинских аппарата: александритовый лазер IXTRON-SPRINT, немецкий аппарат MeDioStar Monolith и диодный лазер Magic One 4000W. В клинике есть медицинская лицензия, процедуры проводят специалисты с медицинским образованием. Результат у каждого свой, он зависит от кожи, волос и курса.</p>
    </section>

    <section class="container cs-devices lz-devices">
      <p class="cs-eyebrow">Аппараты</p>
      <h2 class="cs-title">На чём проводим эпиляцию</h2>
      <ul class="cs-devices__grid">
        {devices.map((d) => (
          <li class="cs-card" id={d.id}>
            <h3>{d.title}</h3>
            <p class="cs-card__for">{d.forWhat}</p>
            <p>{d.text}</p>
            <p class="lz-branch">{d.branch}</p>
            {d.href
              ? <a class="cs-card__link" href={d.href}>{d.link} →</a>
              : <a class="cs-card__link" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн →</a>}
          </li>
        ))}
      </ul>
    </section>

    <section class="container bio-block">
      <p class="cs-eyebrow">Принцип действия</p>
      <h2 class="cs-title">Как работает лазерная эпиляция</h2>
      <ul class="bio-pair">
        {how.map((x) => <li><h3>{x.title}</h3><p>{x.text}</p></li>)}
      </ul>
    </section>

    <section class="container bio-block">
      <p class="cs-eyebrow">Подготовка</p>
      <h2 class="cs-title">Рекомендации перед процедурой</h2>
      <ul class="lz-list">
        {prep.map((p) => <li>{p}</li>)}
      </ul>
    </section>

    <section class="container cs-steps">
      <h2 class="section-title">Как проходит процедура</h2>
      <ol class="cs-steps__list">
        {steps.map((s, i) => (
          <li>
            <span class="cs-steps__num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="container in-faq">
      <p class="cs-eyebrow">Вопросы и ответы</p>
      <h2 class="cs-title">Что обычно спрашивают</h2>
      <div class="in-faq__list">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container cs-med">
      <div class="cs-med__card">
        <h2>Когда процедура может быть невозможна</h2>
        <ul>
          {contra.map((c) => <li>{c}</li>)}
        </ul>
        <p>Это общий перечень, окончательное решение принимает врач. Имеются противопоказания. Необходима консультация специалиста.</p>
      </div>
      <div class="cs-med__card cs-med__card--alt">
        <h2>Полезно почитать</h2>
        <p class="in-cross__text">Посмотрите, что ещё есть в клинике.</p>
        <p class="in-cross__links">
          <a href="/instructions#lazer">Памятка перед процедурой и после →</a>
          <a href="/lazer_aleksandrit">Александритовый лазер IXTRON-SPRINT →</a>
          <a href="/mediostar">Лазер MeDioStar Monolith →</a>
          <a href="/blog-lazer">Почему нельзя автозагар перед лазерной эпиляцией →</a>
          <a href="/cosmetology">Аппаратная косметология →</a>
          <a href="/sale">Акции →</a>
        </p>
      </div>
    </section>

    <Directions current="/lazer" />

    <section class="cs-cta">
      <div class="container cs-cta__inner">
        <div>
          <h2 class="cs-cta__title">Хотите узнать, какой лазер подойдёт вам?</h2>
          <p class="cs-cta__sub">Приходите на консультацию: оценим кожу и волосы и подберём аппарат и параметры.</p>
          <p class="cs-cta__warn">Имеются противопоказания. Необходима консультация специалиста.</p>
        </div>
        <a class="cs-cta__btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
      </div>
    </section>

    <Contacts />
  </main>
  <Footer />
</Base>

<style>
  /* Размеры шрифта — только из общей шкалы --fs-* (styles/global.css), 5 размеров */

  .cs-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: var(--w-regular);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wine);
  }
  .cs-eyebrow::before { content: ''; width: 40px; height: 1px; background: currentColor; }
  .cs-title { margin-top: 20px; font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }

  /* ---------- Первый экран ---------- */
  .cs-hero { position: relative; overflow: hidden; background: var(--white); }
  .cs-crumbs { display: flex; gap: 10px; padding-top: 40px; font-size: var(--fs-small); color: var(--muted); }
  .cs-crumbs > * { white-space: nowrap; }
  .cs-crumbs a { text-decoration: none; }
  .cs-crumbs a:hover { color: var(--wine); }
  .in-hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 40px; align-items: end; padding-top: 28px; padding-bottom: 0; }
  .cs-hero__title { margin-top: 20px; font-size: var(--fs-h1); line-height: 1.12; font-weight: var(--w-thin); }
  .cs-hero__title span { display: block; color: var(--wine); font-size: var(--fs-h2); line-height: 1.25; margin-top: 8px; }
  .cs-hero__lead { margin-top: 24px; max-width: 520px; color: var(--muted); }
  .in-hero__text { padding-bottom: 64px; }
  .in-hero__visual { position: relative; display: grid; justify-items: center; align-items: end; min-height: 440px; overflow: hidden; }
  .in-hero__letters { position: absolute; left: 50%; bottom: 0; width: 100%; max-width: 640px; height: auto; transform: translate(-50%, 14%); opacity: 0.28; clip-path: inset(0 0 14% 0); pointer-events: none; }
  .in-hero__woman { position: relative; width: 460px; max-width: 100%; height: auto; }

  .cs-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px 32px; margin-top: 32px; }
  .cs-btn,
  .cs-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    border-radius: 999px;
    font-family: var(--font);
    font-size: var(--fs-body);
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-btn { background: var(--wine); color: var(--white); }
  .cs-btn:hover { background: var(--graphite); }
  .cs-phone { display: grid; text-decoration: none; line-height: 1.2; }
  .cs-phone__label { font-size: var(--fs-small); color: var(--muted); }
  .cs-phone__num { font-family: var(--font); font-size: var(--fs-h3); letter-spacing: 0.5px; }
  .cs-phone:hover .cs-phone__num { color: var(--wine); }

  .cs-benefits { border-top: 1px solid var(--line); }
  .cs-benefits__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0 auto;
    padding-top: 32px;
    padding-bottom: 36px;
    list-style: none;
  }
  .cs-benefits__list li { display: flex; gap: 10px; font-size: var(--fs-small); line-height: 1.45; }
  .cs-benefits__list img { flex: none; margin-top: 5px; }
  .cs-benefits__list strong { display: block; font-family: var(--font); font-size: var(--fs-body); font-weight: var(--w-regular); }
  .cs-benefits__list span { color: var(--muted); }

  /* ---------- О направлении ---------- */
  .cs-intro { padding-top: 88px; }
  .cs-intro > * { max-width: 820px; }
  .cs-intro__text { margin-top: 24px; }

  /* ---------- Подбор по задаче ---------- */
  .cs-nav { padding-top: 72px; padding-bottom: 72px; }
  .cs-nav__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-nav__item { display: flex; flex-direction: column; gap: 14px; padding: 28px 28px 24px; background: var(--ivory); }
  .cs-nav__item h3 { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-light); }
  .cs-nav__item ul { display: flex; flex-wrap: wrap; gap: 8px; margin: auto 0 0; padding: 0; list-style: none; }
  .cs-nav__item a {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--wine);
    border-radius: 999px;
    font-size: var(--fs-small);
    color: var(--wine);
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-nav__item a:hover { background: var(--wine); color: var(--white); }

  /* ---------- Каталог ---------- */
  .cs-devices { padding-bottom: 80px; }
  .cs-devices__lead { margin-top: 16px; max-width: 640px; color: var(--muted); }
  .cs-devices__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-card { display: flex; flex-direction: column; padding: 36px; border: 1px solid var(--line); scroll-margin-top: 90px; }
  .cs-card h3 { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-regular); }
  .cs-card p { margin-top: 12px; color: var(--muted); }
  .cs-card p.cs-card__for { color: var(--graphite); }
  .cs-card__link { margin-top: auto; padding-top: 22px; font-family: var(--font); color: var(--wine); text-decoration: underline; text-underline-offset: 4px; }
  .cs-card__link:hover { color: var(--graphite); }
  .cs-card--soft { background: var(--ivory); border-color: var(--ivory); }
  .cs-card--soft p { color: var(--graphite); }
  .cs-all { margin-top: 32px; text-align: center; font-family: var(--font); }
  .cs-all a { color: var(--wine); text-decoration: underline; text-underline-offset: 4px; }

  /* ---------- Принципы (винная полоса) ---------- */
  .cs-results { background: var(--wine); color: var(--white); }
  .cs-results__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 64px; padding-top: 72px; padding-bottom: 72px; }
  .cs-results__title { font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }
  .cs-results__note { margin-top: 20px; max-width: 380px; color: rgba(255, 255, 255, 0.85); }
  .cs-results__list { margin: 0; padding: 0; list-style: none; }
  .cs-results__list li {
    padding: 16px 0 16px 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    background: url('/images/star.svg') 0 22px / 15px no-repeat;
    font-family: var(--font);
    font-size: var(--fs-h3);
    font-weight: var(--w-thin);
  }
  .cs-results__list li:first-child { padding-top: 0; background-position: 0 6px; }

  /* ---------- Шаги ---------- */
  .cs-steps { padding-top: 88px; padding-bottom: 72px; }
  .cs-steps__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-steps__num { display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--wine); border-radius: 50%; color: var(--wine); font-family: var(--font); font-size: var(--fs-body); }
  .cs-steps__list h3 { margin-top: 20px; font-size: var(--fs-h3); }
  .cs-steps__list p { margin-top: 10px; color: var(--muted); }

  /* ---------- Вопросы ---------- */
  .in-faq { padding-bottom: 88px; }
  .in-faq__list { margin-top: 32px; }
  .in-faq details { border-top: 1px solid var(--line); padding: 20px 0; }
  .in-faq details:last-child { border-bottom: 1px solid var(--line); }
