---
// Страница /orto — «Индивидуальные ортопедические стельки», дизайн по образцу /pedikur, 5 размеров шрифта (шкала --fs-*).
// Тексты — со страницы Тильды /orto (факты старого сайта владелец считает подтверждёнными, 27.10), проверены по 38-ФЗ: убрано «качественных»,
// «коррекция стопы при различных заболеваниях» смягчена до назначения стелек. Своих фото на старой странице нет — на первом экране только буквы A&J (на мобильном скрыты).
// Противопоказаний списком не даём, обязательная строка 38-ФЗ — в карточке «Важно знать» и в полосе записи. Видео нет.
// Ссылки на страницу: пункт «Создание индивидуальных ортопедических стелек» в услугах (services.ts), /pedikur (блок ссылок и FAQ). Копию Тильды не делаем.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Directions from '../components/Directions.astro';
import { site } from '../data/site';
import { img } from '../data/images';

const benefits = [
  { title: 'Индивидуально', text: 'Стельки изготавливают по вашей стопе.' },
  { title: 'Ортопедический техник', text: 'Изготовлением занимается ортопедический техник.' },
  { title: 'Осмотр и измерение', text: 'Работа начинается с осмотра и измерения стопы.' },
  { title: 'Особенности ходьбы', text: 'Специалист учитывает, как вы ходите.' },
];
const how = [
  { title: 'Что это', text: 'Индивидуальные ортопедические стельки изготавливает ортопедический техник. Они предназначены для поддержки и коррекции стопы при её деформациях и заболеваниях.' },
  { title: 'С чего начинается работа', text: 'Специалист осматривает и измеряет стопу, оценивает её строение и деформации, находит проблемные зоны и смотрит на особенности ходьбы. При необходимости для более точной оценки может понадобиться рентгенография или компьютерная томография стопы.' },
];
const tasks = [
  { title: 'Строение стопы', text: 'Оценка структуры и формы стопы.' },
  { title: 'Деформации', text: 'Учёт деформаций стопы.' },
  { title: 'Проблемные зоны', text: 'Поиск участков с повышенной нагрузкой.' },
  { title: 'Походка', text: 'Учёт особенностей ходьбы.' },
];
const whenList = [
  'Есть деформации стопы',
  'Нужна поддержка стопы при ходьбе',
  'Подолог рекомендовал ортопедические стельки',
  'Хочется стельки, сделанные под вашу стопу',
];
const steps = [
  { title: 'Осмотр и измерение', text: 'Специалист осматривает и измеряет стопу, оценивает её строение и деформации.' },
  { title: 'Оценка ходьбы', text: 'Находит проблемные зоны и смотрит на особенности ходьбы. При необходимости может понадобиться рентгенография или КТ стопы.' },
  { title: 'Изготовление', text: 'Ортопедический техник изготавливает стельки индивидуально по вашей стопе.' },
];
const faq = [
  { q: 'Кто изготавливает стельки?', a: 'Индивидуальные ортопедические стельки изготавливает ортопедический техник.' },
  { q: 'Нужны ли мне стельки?', a: 'Это решает специалист после осмотра стопы и оценки ходьбы.' },
  { q: 'Нужен ли рентген?', a: 'Не всегда. Рентгенография или КТ стопы может понадобиться для более точной оценки — об этом скажет специалист.' },
  { q: 'Можно ли совместить с педикюром?', a: 'В клинике есть гигиенический педикюр и приём подолога. Записаться можно на удобное время.' },
];
---
<Base
  title="Индивидуальные ортопедические стельки в Мурманске — клиника A&J"
  description="Ортопедические стельки на заказ в клиника эстетической косметологии A&J: осмотр и измерение стопы, оценка ходьбы, изготовление ортопедическим техником. Запись: 78-70-30"
>
  <section class="cs-hero">
    <Header />

    <div class="container">
      <nav class="cs-crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Ортопедические стельки</span>
      </nav>
    </div>

    <div class="container in-hero">
      <div class="in-hero__text">
        <p class="cs-eyebrow">Клиника A&amp;J</p>
        <h1 class="cs-hero__title">Ортопедические стельки <span>индивидуальное изготовление</span></h1>
        <p class="cs-hero__lead">Стельки по вашей стопе: осмотр и измерение, оценка ходьбы и изготовление ортопедическим техником.</p>
        <div class="cs-actions">
          <a class="cs-btn" href="#contact">Записаться на консультацию</a>
          <a class="cs-phone" href={site.phone.href}>
            <span class="cs-phone__label">или позвоните</span>
            <span class="cs-phone__num">{site.phone.display}</span>
          </a>
        </div>
      </div>
      <div class="in-hero__visual" aria-hidden="true">
        <img class="in-hero__letters" src={img('cosmLetters')} alt="" width="1183" height="821" aria-hidden="true" />
      </div>
    </div>

    <div class="cs-benefits">
      <ul class="container cs-benefits__list">
        {benefits.map((b) => (
          <li>
            <img src={img('star')} alt="" width="15" height="15" />
            <div><strong>{b.title}</strong><span>{b.text}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <main>
    <section class="container cs-intro">
        <p class="cs-eyebrow">О процедуре</p>
        <h2 class="cs-title">Стельки, сделанные под вашу стопу</h2>
        <p class="cs-intro__text">Индивидуальные ортопедические стельки изготавливает ортопедический техник. Они предназначены для поддержки и коррекции стопы при её деформациях и заболеваниях. Работа начинается с осмотра и измерения: специалист оценивает строение стопы, находит проблемные зоны и учитывает особенности ходьбы.</p>
    </section>

    <section class="container bio-block">
      <p class="cs-eyebrow">Как это работает</p>
      <h2 class="cs-title">Как изготавливают стельки</h2>
      <ul class="bio-pair">
        {how.map((x) => <li><h3>{x.title}</h3><p>{x.text}</p></li>)}
      </ul>
    </section>

    <section class="container bio-block">
      <p class="cs-eyebrow">Что входит</p>
      <h2 class="cs-title">Что учитывает специалист</h2>
      <ul class="bio-zones lm-zones">
        {tasks.map((z) => <li><h3>{z.title}</h3><p>{z.text}</p></li>)}
      </ul>
    </section>

    <section class="cs-results bio-results">
      <div class="container cs-results__inner">
        <div>
          <h2 class="cs-results__title">Когда стоит прийти</h2>
          <p class="cs-results__note">Нужны ли вам стельки, скажет специалист после осмотра.</p>
        </div>
        <ul class="cs-results__list">
          {whenList.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>

    <section class="container cs-steps">
      <h2 class="section-title">Как проходит процедура</h2>
      <ol class="cs-steps__list">
        {steps.map((s, i) => (
          <li>
            <span class="cs-steps__num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="container in-faq">
      <p class="cs-eyebrow">Вопросы и ответы</p>
      <h2 class="cs-title">Что обычно спрашивают</h2>
      <div class="in-faq__list">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container cs-med">
      <div class="cs-med__card">
        <h2>Важно знать</h2>
        <p class="in-cross__text">Стельки изготавливают индивидуально, после осмотра и измерения стопы. Нужны ли они вам, решает специалист.</p>
        <p>Имеются противопоказания. Необходима консультация специалиста.</p>
      </div>
      <div class="cs-med__card cs-med__card--alt">
        <h2>Что ещё есть в клинике</h2>
        <p class="in-cross__text">Процедуры можно сочетать. Посмотрите, что ещё есть в клинике.</p>
        <p class="in-cross__links">
          <a href="/pedikur">Подология и педикюр →</a>
          <a href="/lazer">Лазерная эпиляция →</a>
          <a href="/estetica">Эстетическая косметология →</a>
          <a href="/lpg">LPG-массаж →</a>
          <a href="/sale">Акции месяца →</a>
        </p>
      </div>
    </section>

    <Directions current="/orto" />

    <section class="cs-cta">
      <div class="container cs-cta__inner">
        <div>
          <h2 class="cs-cta__title">Запишитесь на изготовление стелек</h2>
          <p class="cs-cta__sub">Выберите удобное время онлайн или позвоните, администратор ответит на вопросы.</p>
          <p class="cs-cta__warn">Имеются противопоказания. Необходима консультация специалиста.</p>
        </div>
        <a class="cs-cta__btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
      </div>
    </section>

    <Contacts />
  </main>
  <Footer />
</Base>

<style>
  /* Размеры шрифта — только из общей шкалы --fs-* (styles/global.css), 5 размеров */

  .cs-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: var(--w-regular);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wine);
  }
  .cs-eyebrow::before { content: ''; width: 40px; height: 1px; background: currentColor; }
  .cs-title { margin-top: 20px; font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }

  /* ---------- Первый экран ---------- */
  .cs-hero { position: relative; overflow: hidden; background: var(--white); }
  .cs-crumbs { display: flex; gap: 10px; padding-top: 40px; font-size: var(--fs-small); color: var(--muted); }
  .cs-crumbs > * { white-space: nowrap; }
  .cs-crumbs a { text-decoration: none; }
  .cs-crumbs a:hover { color: var(--wine); }
  .in-hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 40px; align-items: end; padding-top: 28px; padding-bottom: 0; }
  .cs-hero__title { margin-top: 20px; font-size: var(--fs-h1); line-height: 1.12; font-weight: var(--w-thin); }
  .cs-hero__title span { display: block; color: var(--wine); font-size: var(--fs-h2); line-height: 1.25; margin-top: 8px; }
  .cs-hero__lead { margin-top: 24px; max-width: 520px; color: var(--muted); }
  .in-hero__text { padding-bottom: 64px; }
  .in-hero__visual { position: relative; display: grid; justify-items: center; align-items: end; min-height: 440px; overflow: hidden; }
  .in-hero__letters { position: absolute; left: 50%; bottom: 0; width: 100%; max-width: 640px; height: auto; transform: translate(-50%, 14%); opacity: 0.28; clip-path: inset(0 0 14% 0); pointer-events: none; }
  .in-hero__woman { position: relative; width: 460px; max-width: 100%; height: auto; }

  .cs-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px 32px; margin-top: 32px; }
  .cs-btn,
  .cs-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    border-radius: 999px;
    font-family: var(--font);
    font-size: var(--fs-body);
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-btn { background: var(--wine); color: var(--white); }
  .cs-btn:hover { background: var(--graphite); }
  .cs-phone { display: grid; text-decoration: none; line-height: 1.2; }
  .cs-phone__label { font-size: var(--fs-small); color: var(--muted); }
  .cs-phone__num { font-family: var(--font); font-size: var(--fs-h3); letter-spacing: 0.5px; }
  .cs-phone:hover .cs-phone__num { color: var(--wine); }

  .cs-benefits { border-top: 1px solid var(--line); }
  .cs-benefits__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0 auto;
    padding-top: 32px;
    padding-bottom: 36px;
    list-style: none;
  }
  .cs-benefits__list li { display: flex; gap: 10px; font-size: var(--fs-small); line-height: 1.45; }
  .cs-benefits__list img { flex: none; margin-top: 5px; }
  .cs-benefits__list strong { display: block; font-family: var(--font); font-size: var(--fs-body); font-weight: var(--w-regular); }
  .cs-benefits__list span { color: var(--muted); }

  /* ---------- О направлении ---------- */
  .cs-intro { padding-top: 88px; }
  .cs-intro > * { max-width: 820px; }
  .cs-intro__text { margin-top: 24px; }

  /* ---------- Подбор по задаче ---------- */
  .cs-nav { padding-top: 72px; padding-bottom: 72px; }
  .cs-nav__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-nav__item { display: flex; flex-direction: column; gap: 14px; padding: 28px 28px 24px; background: var(--ivory); }
  .cs-nav__item h3 { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-light); }
  .cs-nav__item ul { display: flex; flex-wrap: wrap; gap: 8px; margin: auto 0 0; padding: 0; list-style: none; }
  .cs-nav__item a {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--wine);
    border-radius: 999px;
    font-size: var(--fs-small);
    color: var(--wine);
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-nav__item a:hover { background: var(--wine); color: var(--white); }

  /* ---------- Каталог ---------- */
  .cs-devices { padding-bottom: 80px; }
  .cs-devices__lead { margin-top: 16px; max-width: 640px; color: var(--muted); }
  .cs-devices__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-card { display: flex; flex-direction: column; padding: 36px; border: 1px solid var(--line); scroll-margin-top: 90px; }
  .cs-card h3 { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-regular); }
  .cs-card p { margin-top: 12px; color: var(--muted); }
  .cs-card p.cs-card__for { color: var(--graphite); }
  .cs-card__link { margin-top: auto; padding-top: 22px; font-family: var(--font); color: var(--wine); text-decoration: underline; text-underline-offset: 4px; }
  .cs-card__link:hover { color: var(--graphite); }
  .cs-card--soft { background: var(--ivory); border-color: var(--ivory); }
  .cs-card--soft p { color: var(--graphite); }
  .cs-all { margin-top: 32px; text-align: center; font-family: var(--font); }
  .cs-all a { color: var(--wine); text-decoration: underline; text-underline-offset: 4px; }

  /* ---------- Принципы (винная полоса) ---------- */
  .cs-results { background: var(--wine); color: var(--white); }
  .cs-results__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 64px; padding-top: 72px; padding-bottom: 72px; }
  .cs-results__title { font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }
  .cs-results__note { margin-top: 20px; max-width: 380px; color: rgba(255, 255, 255, 0.85); }
  .cs-results__list { margin: 0; padding: 0; list-style: none; }
  .cs-results__list li {
    padding: 16px 0 16px 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    background: url('/images/star.svg') 0 22px / 15px no-repeat;
    font-family: var(--font);
    font-size: var(--fs-h3);
    font-weight: var(--w-thin);
  }
  .cs-results__list li:first-child { padding-top: 0; background-position: 0 6px; }

  /* ---------- Шаги ---------- */
  .cs-steps { padding-top: 88px; padding-bottom: 72px; }
  .cs-steps__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-steps__num { display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid var(--wine); border-radius: 50%; color: var(--wine); font-family: var(--font); font-size: var(--fs-body); }
  .cs-steps__list h3 { margin-top: 20px; font-size: var(--fs-h3); }
  .cs-steps__list p { margin-top: 10px; color: var(--muted); }

  /* ---------- Вопросы ---------- */
  .in-faq { padding-bottom: 88px; }
  .in-faq__list { margin-top: 32px; }
  .in-faq details { border-top: 1px solid var(--line); padding: 20px 0; }
  .in-faq details:last-child { border-bottom: 1px solid var(--line); }
  .in-faq summary { display: flex; justify-content: space-between; gap: 20px; cursor: pointer; list-style: none; font-family: var(--font); font-size: var(--fs-h3); font-weight: var(--w-light); }
  .in-faq summary::-webkit-details-marker { display: none; }
  .in-faq summary::after { content: '+'; flex: none; color: var(--wine); font-size: var(--fs-h3); line-height: 1; }
  .in-faq details[open] summary::after { content: '×'; }
  .in-faq details p { margin-top: 14px; max-width: 760px; color: var(--muted); }

  /* ---------- Противопоказания / аппаратные методы ---------- */
  .cs-med { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-bottom: 88px; }
  .cs-med__card { padding: 40px; background: var(--ivory); }
  .cs-med__card--alt { background: var(--white); border: 1px solid var(--line); }
  .cs-med__card h2 { font-size: var(--fs-h3); }
  .cs-med__card ul { margin: 20px 0 0; padding-left: 20px; }
  .cs-med__card li { padding: 4px 0; }
  .cs-med__card li::marker { color: var(--wine); }
  .cs-med__card p { margin-top: 16px; font-size: var(--fs-small); color: var(--muted); }
  .cs-med__card p.in-cross__text { margin-top: 20px; font-size: var(--fs-body); color: var(--graphite); }
  .in-cross__links { display: flex; flex-direction: column; gap: 10px; }
  .cs-med__card p.in-cross__links { font-size: var(--fs-body); }
  .in-cross__links a { font-family: var(--font); color: var(--wine); text-decoration: underline; text-underline-offset: 4px; }
  .in-cross__links a:hover { color: var(--graphite); }

  /* ---------- Запись (тёмная полоса) ---------- */
  .cs-cta { background: var(--graphite); color: var(--ivory); margin-bottom: 80px; }
  .cs-cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 40px; padding-top: 48px; padding-bottom: 52px; }
  .cs-cta__title { font-size: var(--fs-h2); line-height: 1.15; }
  .cs-cta__sub { margin-top: 10px; color: rgba(241, 234, 224, 0.8); }
  .cs-cta__warn { margin-top: 8px; font-size: var(--fs-small); letter-spacing: 0.5px; text-transform: uppercase; color: rgba(241, 234, 224, 0.6); }
  .cs-cta__btn { background: var(--ivory); color: var(--graphite); }
  .cs-cta__btn:hover { background: var(--wine); color: var(--white); }

  .bio-zones { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .bio-zones li { padding: 28px; background: var(--ivory); }
  .bio-zones h3 { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-regular); }
  .bio-zones p { margin-top: 12px; }
  .bio-zones { }
  .bio-block { padding-top: 88px; padding-bottom: 0; }
  .bio-results { margin-top: 88px; }
  .bio-block > p { margin-top: 24px; max-width: 820px; }
  .bio-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .bio-pair li { padding: 32px 36px; border: 1px solid var(--line); }
  .bio-pair h3 { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-regular); }
  .bio-pair p { margin-top: 12px; color: var(--muted); }

  @media (max-width: 1199px) {
    .cs-benefits__list { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 959px) {
    .cs-crumbs { padding-top: 24px; }
    .cs-crumbs { flex-wrap: wrap; gap: 4px 8px; }
    .cs-crumbs__sep { display: none; }
