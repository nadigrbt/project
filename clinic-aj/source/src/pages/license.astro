---
// Страница /license — «Лицензия клиники»: два изображения выписки из реестра лицензий со старой страницы Тильды (license-1/2.webp).
// По клику изображение открывается целиком. Ссылка — в подвале (legalLinks).
import DocPage from '../components/DocPage.astro';
import { img } from '../data/images';
const pages = [
  { key: 'license1', alt: 'Выписка из реестра лицензий ООО «Эстетика», страница 1' },
  { key: 'license2', alt: 'Выписка из реестра лицензий ООО «Эстетика», страница 2' },
] as const;
---
<DocPage
  path="/license"
  title="Лицензия клиники"
  lead="Выписка из реестра лицензий на медицинскую деятельность ООО «Эстетика» (клиника A&J). Нажмите на страницу, чтобы открыть её целиком."
  crumb="Лицензия клиники"
  metaTitle="Лицензия на медицинскую деятельность | Клиника эстетической косметологии A&J"
  description="Лицензия на медицинскую деятельность ООО «Эстетика» (клиника эстетической косметологии A&J, Мурманск): выписка из реестра лицензий."
>
  <ul class="doc__imgs">
    {pages.map((p) => (
      <li><a href={img(p.key)} target="_blank" rel="noopener"><img src={img(p.key)} alt={p.alt} width="1038" height="1460" loading="lazy" /></a></li>
    ))}
  </ul>
</DocPage>
