---
// Страница /education-ped — курс «Базовый педикюр с введением в подологию» учебного центра A&J (шаблон components/CoursePage.astro).
// Тексты со страницы Тильды. Убраны цена 120 000 руб. (правило «без цен») и «для успешной деятельности». Фото — со старой страницы.
import CoursePage from '../components/CoursePage.astro';

const benefits = [
  { title: 'Очно', text: 'Лекции и практика проходят в клинике.' },
  { title: 'Модели от клиники', text: 'Практика на моделях, которых предоставляет клиника.' },
  { title: 'Группа до 2 человек', text: 'Преподаватель уделяет внимание каждому.' },
  { title: 'Свидетельство', text: 'Государственного образца, вносится в реестр.' },
];
const facts = [
  { value: '30%', text: 'теории — лекции очно' },
  { value: '70%', text: 'практики на моделях' },
  { value: 'до 2', text: 'человек в группе' },
];
const photos = [
  { key: 'eduPed1', alt: 'Практика: работа со стопой' },
  { key: 'eduPed2', alt: 'Аппаратная обработка стоп' },
  { key: 'eduPed3', alt: 'Кабинет подологии клиники A&J' },
] as const;
const faq = [
  { q: 'Какой документ выдают?', a: 'Официальное свидетельство о профессии государственного образца, сведения о нём вносятся в реестр.' },
  { q: 'Как проходит практика?', a: 'Очно, с моделями от клиники: проблемные стопы, эстетический педикюр, подология.' },
  { q: 'Сколько человек в группе?', a: 'До двух человек, поэтому преподаватель может уделить достаточно внимания каждому.' },
];
---
<CoursePage
  metaTitle="Курсы педикюра с основами подологии в Мурманске — учебный центр A&J"
  description="Курс «Базовый педикюр с введением в подологию» в учебном центре клиники A&J: очно, 70% практики на моделях, группа до 2 человек, свидетельство о профессии."
  crumb="Базовый педикюр с введением в подологию"
  title="Базовый педикюр"
  subtitle="с введением в подологию"
  lead="На базе клиники эстетической косметологии A&J можно пройти обучение по программе «Базовый педикюр с введением в подологию». По окончании выдаётся официальное свидетельство о профессии государственного образца, сведения вносятся в реестр."
  benefits={benefits}
  facts={facts}
  photos={[...photos]}
  faq={faq}
>
  <section class="cs-results bio-results">
    <div class="container cs-results__inner">
      <div>
        <h2 class="cs-results__title">Что отрабатывают на практике</h2>
        <p class="cs-results__note">Курс даёт знания и навыки для работы мастером педикюра с погружением в подологию. Всё обучение проходит очно, с моделями от клиники.</p>
      </div>
      <ul class="cs-results__list">
        <li>Проблемные стопы</li>
        <li>Эстетический педикюр</li>
        <li>Подология</li>
      </ul>
    </div>
  </section>
</CoursePage>
