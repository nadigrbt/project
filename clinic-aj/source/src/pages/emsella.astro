---
// Страница /emsella — «Укрепление мышц тазового дна на аппарате BTL Emsella», направление клиники (в directions.ts — «Тазовое дно»), дизайн по образцу /micro, /lpg, 5 размеров шрифта (шкала --fs-*).
// Тексты — со страницы Тильды /emsella, освежены и проверены: убраны цена в описании («от 1800 ₽»), «клинически доказанный», «помогает решить все те вопросы», «эффективность обусловлена»,
// «лечение» и «профилактика и лечение простатита», «уходят хронические боли», «уходит простатит», «возвращается контроль над мочеиспусканием» как обещание результата (38-ФЗ).
// Время сеанса (28 минут), частота и число процедур в курсе (6–10) не пишем: время процедур не подтверждено, курс назначает врач. Сроки после родов и ГВ — не пишем, решает врач.
// Технология HIFEM — со старой страницы. Производитель BTL Industries. РЗН владелец дошлёт, строка пустая. Фото аппарата нет (device-btl.webp — это BTL-6000, не Emsella), блок «Об аппарате» без фото до получения.
// Противопоказания мои (типичные для Emsella) + эндометриоз и аденомиоз из статьи главного врача /blog-ems1, подтвердить. Старые фото 2023 не переносим. Копию Тильды не делаем.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Directions from '../components/Directions.astro';
import { site } from '../data/site';
import { img } from '../data/images';

const benefits = [
  { title: 'Консультация врача', text: 'Врач соберёт анамнез, оценит показания и противопоказания.' },
  { title: 'Процедура в одежде', text: 'Вы просто располагаетесь на кресле аппарата.' },
  { title: 'Технология HIFEM', text: 'Сфокусированное электромагнитное поле высокой интенсивности.' },
  { title: 'Для женщин и мужчин', text: 'Программу подбирает врач под вашу задачу.' },
];
const how = [
  { title: 'Что это', text: 'BTL Emsella — медицинский аппарат в виде кресла. Он использует высокоинтенсивное сфокусированное электромагнитное поле (HIFEM) для стимуляции мышц тазового дна.' },
  { title: 'Как это работает', text: 'Электромагнитное поле вызывает сокращения всей области мышц тазового дна, тренирует их и помогает восстановить нервно-мышечный контроль. Количество и частоту процедур назначает врач.' },
];
const women = [
  { title: 'Недержание мочи', text: 'Применяют при недержании мочи, в том числе стрессовом.' },
  { title: 'Слабость мышц тазового дна', text: 'Укрепление мышц тазового дна.' },
  { title: 'После родов', text: 'Восстановление мышц тазового дна после родов. Когда можно начинать, решит врач.' },
  { title: 'Интимное здоровье', text: 'Применяют в программах при сексуальной дисфункции. Решение принимает врач.' },
];
const men = [
  { title: 'Недержание мочи', text: 'Применяют при недержании мочи.' },
  { title: 'Мышцы тазового дна', text: 'Укрепление мышц и улучшение кровообращения в области малого таза.' },
  { title: 'Интимное здоровье', text: 'Применяют в программах для улучшения качества интимной жизни.' },
  { title: 'Простатит и тазовая боль', text: 'Применяют в комплексной программе по назначению врача.' },
];
const whenList = [
  'Беспокоит подтекание мочи при кашле, смехе или нагрузке',
  'Нужно восстановить мышцы тазового дна после родов',
  'Хочется улучшить качество интимной жизни',
  'Врач рекомендовал укрепить мышцы тазового дна',
];
const steps = [
  { title: 'Консультация', text: 'Врач расспросит о жалобах и здоровье, расскажет о противопоказаниях и составит план.' },
  { title: 'Процедура', text: 'Вы садитесь на кресло аппарата в одежде, врач настраивает интенсивность. Во время процедуры чувствуются сокращения мышц.' },
  { title: 'Курс', text: 'Количество и частоту процедур назначает врач. После курса он оценит результат и даст рекомендации.' },
];
const faq = [
  { q: 'Что я почувствую?', a: 'Сокращения мышц тазового дна и покалывание. Интенсивность настраивают под вас, если что-то беспокоит, скажите врачу во время процедуры.' },
  { q: 'Нужно ли раздеваться?', a: 'Нет, процедура проходит в одежде: вы просто располагаетесь на кресле.' },
  { q: 'Сколько нужно процедур?', a: 'Количество процедур и интервалы назначает врач после консультации.' },
  { q: 'Когда виден результат?', a: 'Результат у каждого свой, обычно его оценивают после курса процедур.' },
  { q: 'Можно ли при эндометриозе или аденомиозе?', a: 'Нет, при этих диагнозах процедура противопоказана. Подробно об этом рассказывает главный врач клиники в статье блога.', link: { href: '/blog-ems1', text: 'Читать статью →' } },
];
const contra = [
  'беременность',
  'кардиостимулятор, металлические и электронные импланты в области таза',
  'медная внутриматочная спираль',
  'онкологические заболевания',
  'эндометриоз и аденомиоз',
  'недавние операции в области таза',
  'кровотечения, менструация',
  'острые воспалительные и инфекционные заболевания, повышенная температура',
];
---
<Base
  title="Укрепление мышц тазового дна на аппарате BTL Emsella в Мурманске | Клиника эстетической косметологии A&J"
  description="Укрепление мышц тазового дна на аппарате BTL Emsella в клинике A&J в Мурманске: для женщин и мужчин, процедура в одежде. Запишитесь онлайн или по номеру 78-70-30"
>
  <section class="cs-hero">
    <Header />

    <div class="container">
      <nav class="cs-crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Укрепление мышц тазового дна</span>
      </nav>
    </div>

    <div class="container in-hero">
      <div class="in-hero__text">
        <p class="cs-eyebrow">Тазовое дно</p>
        <h1 class="cs-hero__title">Укрепление мышц тазового дна <span>на аппарате BTL Emsella</span></h1>
        <p class="cs-hero__lead">Электромагнитная стимуляция мышц тазового дна для женщин и мужчин. Процедура проходит в одежде, вы просто располагаетесь на кресле. Программу подбирает врач на консультации.</p>
        <div class="cs-actions">
          <a class="cs-btn" href="#contact">Записаться на консультацию</a>
          <a class="cs-phone" href={site.phone.href}>
            <span class="cs-phone__label">или позвоните</span>
            <span class="cs-phone__num">{site.phone.display}</span>
          </a>
        </div>
      </div>
      <div class="in-hero__visual" aria-hidden="true">
        <img class="in-hero__letters" src={img('cosmLetters')} alt="" width="1183" height="821" aria-hidden="true" />
        <img class="in-hero__woman" src={img('promoWoman')} alt="" width="700" height="700" fetchpriority="high" aria-hidden="true" />
      </div>
    </div>

    <div class="cs-benefits">
      <ul class="container cs-benefits__list">
        {benefits.map((b) => (
          <li>
            <img src={img('star')} alt="" width="15" height="15" />
            <div><strong>{b.title}</strong><span>{b.text}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <main>
    <section class="container cs-intro">
        <p class="cs-eyebrow">О процедуре</p>
        <h2 class="cs-title">Что такое BTL Emsella</h2>
        <p class="cs-intro__text">BTL Emsella — медицинская технология, а не косметологическая услуга. За одну процедуру аппарат вызывает тысячи сокращений мышц тазового дна. Её применяют, чтобы укрепить эти мышцы и восстановить контроль над ними. Подходит ли процедура вам, решает врач после консультации, результат у каждого свой.</p>
    </section>

    <section class="container dv">
      <div class="dv__card dv__card--text">
        <div class="dv__text">
          <p class="cs-eyebrow">Об аппарате</p>
          <h2>BTL Emsella</h2>
          <p>Кресло с электромагнитной стимуляцией мышц тазового дна. Вы сидите в одежде, а врач настраивает интенсивность под вас.</p>
          <dl class="dv__list">
          <div><dt>Название</dt><dd>BTL Emsella</dd></div>
          <div><dt>Производитель</dt><dd>BTL Industries</dd></div>
          <div><dt>Технология</dt><dd>HIFEM, высокоинтенсивное сфокусированное электромагнитное поле</dd></div>
          <div><dt>Для кого</dt><dd>Женщины и мужчины</dd></div>
          <div><dt>Регистрация</dt><dd></dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section class="container bio-block">
      <p class="cs-eyebrow">Принцип действия</p>
      <h2 class="cs-title">Как работает аппарат</h2>
      <ul class="bio-pair">
        {how.map((x) => <li><h3>{x.title}</h3><p>{x.text}</p></li>)}
      </ul>
    </section>

    <section class="container bio-block">
      <p class="cs-eyebrow">Для женщин</p>
      <h2 class="cs-title">С чем работает процедура у женщин</h2>
      <ul class="bio-zones lm-zones">
        {women.map((z) => <li><h3>{z.title}</h3><p>{z.text}</p></li>)}
      </ul>
    </section>

    <section class="container bio-block">
      <p class="cs-eyebrow">Для мужчин</p>
      <h2 class="cs-title">С чем работает процедура у мужчин</h2>
      <ul class="bio-zones lm-zones">
        {men.map((z) => <li><h3>{z.title}</h3><p>{z.text}</p></li>)}
      </ul>
    </section>

    <section class="cs-results bio-results">
      <div class="container cs-results__inner">
        <div>
          <h2 class="cs-results__title">Когда стоит обратиться к врачу</h2>
          <p class="cs-results__note">Нужна ли процедура именно вам, решит врач.</p>
        </div>
        <ul class="cs-results__list">
          {whenList.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>

    <section class="container cs-steps">
      <h2 class="section-title">Как проходит процедура</h2>
      <ol class="cs-steps__list">
        {steps.map((s, i) => (
          <li>
            <span class="cs-steps__num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="container in-faq">
      <p class="cs-eyebrow">Вопросы и ответы</p>
      <h2 class="cs-title">Что обычно спрашивают</h2>
      <div class="in-faq__list">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}{f.link && <> <a class="in-faq__link" href={f.link.href}>{f.link.text}</a></>}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container cs-med">
      <div class="cs-med__card">
        <h2>Когда процедура может быть невозможна</h2>
        <ul>
          {contra.map((c) => <li>{c}</li>)}
        </ul>
        <p>Это общий перечень, окончательное решение принимает врач. Имеются противопоказания. Необходима консультация специалиста.</p>
      </div>
      <div class="cs-med__card cs-med__card--alt">
        <h2>Полезно почитать</h2>
        <p class="in-cross__text">Ответы главного врача и другие направления клиники.</p>
        <p class="in-cross__links">
          <a href="/blog-ems1">Можно ли Emsella при эндометриозе и аденомиозе →</a>
          <a href="/blog">Блог клиники →</a>
          <a href="/cosmetology">Аппаратная косметология →</a>
          <a href="/sale">Акции →</a>
        </p>
      </div>
    </section>

    <Directions current="/emsella" />

    <section class="cs-cta">
      <div class="container cs-cta__inner">
        <div>
          <h2 class="cs-cta__title">Хотите узнать, подойдёт ли вам Emsella?</h2>
          <p class="cs-cta__sub">Приходите на консультацию: врач расспросит о жалобах и составит план процедур.</p>
          <p class="cs-cta__warn">Имеются противопоказания. Необходима консультация специалиста.</p>
        </div>
        <a class="cs-cta__btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
      </div>
    </section>

    <Contacts />
  </main>
  <Footer />
</Base>

<style>
  /* Размеры шрифта — только из общей шкалы --fs-* (styles/global.css), 5 размеров */

  .cs-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: var(--w-regular);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wine);
  }
  .cs-eyebrow::before { content: ''; width: 40px; height: 1px; background: currentColor; }
  .cs-title { margin-top: 20px; font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }

  /* ---------- Первый экран ---------- */
  .cs-hero { position: relative; overflow: hidden; background: var(--white); }
  .cs-crumbs { display: flex; gap: 10px; padding-top: 40px; font-size: var(--fs-small); color: var(--muted); }
  .cs-crumbs > * { white-space: nowrap; }
  .cs-crumbs a { text-decoration: none; }
  .cs-crumbs a:hover { color: var(--wine); }
  .in-hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 40px; align-items: end; padding-top: 28px; padding-bottom: 0; }
  .cs-hero__title { margin-top: 20px; font-size: var(--fs-h1); line-height: 1.12; font-weight: var(--w-thin); }
  .cs-hero__title span { display: block; color: var(--wine); font-size: var(--fs-h2); line-height: 1.25; margin-top: 8px; }
  .cs-hero__lead { margin-top: 24px; max-width: 520px; color: var(--muted); }
  .in-hero__text { padding-bottom: 64px; }
  .in-hero__visual { position: relative; display: grid; justify-items: center; align-items: end; min-height: 440px; overflow: hidden; }
  .in-hero__letters { position: absolute; left: 50%; bottom: 0; width: 100%; max-width: 640px; height: auto; transform: translate(-50%, 14%); opacity: 0.28; clip-path: inset(0 0 14% 0); pointer-events: none; }
  .in-hero__woman { position: relative; width: 460px; max-width: 100%; height: auto; }

  .cs-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px 32px; margin-top: 32px; }
  .cs-btn,
  .cs-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    border-radius: 999px;
    font-family: var(--font);
    font-size: var(--fs-body);
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-btn { background: var(--wine); color: var(--white); }
  .cs-btn:hover { background: var(--graphite); }
  .cs-phone { display: grid; text-decoration: none; line-height: 1.2; }
  .cs-phone__label { font-size: var(--fs-small); color: var(--muted); }
  .cs-phone__num { font-family: var(--font); font-size: var(--fs-h3); letter-spacing: 0.5px; }
  .cs-phone:hover .cs-phone__num { color: var(--wine); }

  .cs-benefits { border-top: 1px solid var(--line); }
  .cs-benefits__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0 auto;
    padding-top: 32px;
    padding-bottom: 36px;
    list-style: none;
  }
  .cs-benefits__list li { display: flex; gap: 10px; font-size: var(--fs-small); line-height: 1.45; }
  .cs-benefits__list img { flex: none; margin-top: 5px; }
  .cs-benefits__list strong { display: block; font-family: var(--font); font-size: var(--fs-body); font-weight: var(--w-regular); }
  .cs-benefits__list span { color: var(--muted); }

  /* ---------- О направлении ---------- */
  .cs-intro { padding-top: 88px; }
  .cs-intro > * { max-width: 820px; }
  .cs-intro__text { margin-top: 24px; }

  /* ---------- Подбор по задаче ---------- */
  .cs-nav { padding-top: 72px; padding-bottom: 72px; }
  .cs-nav__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-nav__item { display: flex; flex-direction: column; gap: 14px; padding: 28px 28px 24px; background: var(--ivory); }
  .cs-nav__item h3 { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-light); }
  .cs-nav__item ul { display: flex; flex-wrap: wrap; gap: 8px; margin: auto 0 0; padding: 0; list-style: none; }
  .cs-nav__item a {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--wine);
    border-radius: 999px;
    font-size: var(--fs-small);
    color: var(--wine);
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-nav__item a:hover { background: var(--wine); color: var(--white); }

  /* ---------- Каталог ---------- */
  .cs-devices { padding-bottom: 80px; }
  .cs-devices__lead { margin-top: 16px; max-width: 640px; color: var(--muted); }
  .cs-devices__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-card { display: flex; flex-direction: column; padding: 36px; border: 1px solid var(--line); scroll-margin-top: 90px; }
  .cs-card h3 { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-regular); }
  .cs-card p { margin-top: 12px; color: var(--muted); }
  .cs-card p.cs-card__for { color: var(--graphite); }
  .cs-card__link { margin-top: auto; padding-top: 22px; font-family: var(--font); color: var(--wine); text-decoration: underline; text-underline-offset: 4px; }
  .cs-card__link:hover { color: var(--graphite); }
  .cs-card--soft { background: var(--ivory); border-color: var(--ivory); }
  .cs-card--soft p { color: var(--graphite); }
  .cs-all { margin-top: 32px; text-align: center; font-family: var(--font); }
  .cs-all a { color: var(--wine); text-decoration: underline; text-underline-offset: 4px; }

  /* ---------- Принципы (винная полоса) ---------- */
  .cs-results { background: var(--wine); color: var(--white); }
  .cs-results__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 64px; padding-top: 72px; padding-bottom: 72px; }
  .cs-results__title { font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }
  .cs-results__note { margin-top: 20px; max-width: 380px; color: rgba(255, 255, 255, 0.85); }
  .cs-results__list { margin: 0; padding: 0; list-style: none; }
  .cs-results__list li {
    padding: 16px 0 16px 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    background: url('/images/star.svg') 0 22px / 15px no-repeat;
    font-family: var(--font);
    font-size: var(--fs-h3);
    font-weight: var(--w-thin);
  }
  .cs-results__list li:first-child { padding-top: 0; background-position: 0 6px; }

  /* ---------- Шаги ---------- */
  .cs-steps { padding-top: 88px; padding-bottom: 72px; }
  .cs-steps__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin: 40px 0 0; padding: 0; list-style: none; }
