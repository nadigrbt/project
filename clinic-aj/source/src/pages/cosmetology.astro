---
// Страница /cosmetology — новый дизайн по образцу /volnewmer (эталон для страниц аппаратов), 5 размеров шрифта (шкала --fs-*).
// Тексты — со страницы Тильды, освежены и проверены по фактам (analysis/cosmetology-fact-check.md): убраны «безболезненно», «единственный в городе», «российская запатентованная» и т. п.
// Копия страницы с Тильды для сравнения — cosmetology-tilda.astro (/cosmetology-tilda).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { img, type ImageKey } from '../data/images';

const benefits = [
  { title: 'Подбор под вашу задачу', text: 'Сначала консультация и анамнез, потом процедуры — а не наоборот.' },
  { title: 'Оригинальные аппараты', text: 'Asclepion, LPG Systems, InMode, Classys, Asterasys, Energist — ведущие производители.' },
  { title: 'Врачи с медицинским образованием', text: 'Специалисты постоянно проходят обучение и следят за новинками.' },
  { title: 'Три адреса в Мурманске', text: 'Принимаем ежедневно с 9:00 до 21:00, без выходных.' },
];
const goals = [
  { title: 'Подтянуть кожу и овал лица', items: [['volnewmer', 'Volnewmer'], ['liftera', 'Liftera'], ['morpheus', 'Morpheus 8'], ['micro', 'Микротоки']] },
  { title: 'Омолодить кожу и улучшить её качество', items: [['neogen', 'NeoGen'], ['lumecca', 'Lumecca'], ['mediostar', 'MeDioStar']] },
  { title: 'Пигментация и сосудистые проявления', items: [['lumecca', 'Lumecca'], ['mediostar', 'MeDioStar'], ['acne', 'Консультация']] },
  { title: 'Акне и проблемная кожа', items: [['heleo', 'Heleo4'], ['acne', 'Консультация']] },
  { title: 'Целлюлит, отёки и тонус тела', items: [['lpg', 'LPG-массаж'], ['morpheus', 'Morpheus 8']] },
  { title: 'Не знаю, что мне подойдёт', items: [['acne', 'Записаться на консультацию']] },
];
const devices = [
  { id: 'volnewmer', href: '/volnewmer', title: 'RF-лифтинг Volnewmer', forWhat: 'Подтяжка и уплотнение кожи лица и шеи без операции.', text: 'Монополярная радиочастотная энергия прогревает глубокие слои кожи и запускает выработку коллагена. Аппарат Classys (Корея), насадка с водяным охлаждением, восстановление минимальное.' },
  { id: 'liftera', href: '/smas', title: 'SMAS-лифтинг Liftera', forWhat: 'Подтяжка овала лица и шеи.', text: 'Фокусированный ультразвук (HIFU) воздействует на глубокие слои кожи без разрезов. Аппарат Asterasys (Корея). Эффект нарастает постепенно, в течение нескольких месяцев; во время процедуры возможен лёгкий дискомфорт.' },
  { id: 'morpheus', href: '/rf', title: 'Игольчатый RF-лифтинг Morpheus 8', forWhat: 'Тонус и упругость кожи лица и тела, морщины, рубцы и постакне.', text: 'Аппарат InMode: радиочастотные микроиглы стимулируют коллаген и эластин. Процедура минимально инвазивная — проводится с местной анестезией, в первые дни возможны покраснение и отёчность. Для тела есть насадка с иглами до 7 мм.' },
  { id: 'neogen', href: '/neogen', title: 'Плазменное омоложение NeoGen', forWhat: 'Подтяжка, разглаживание морщин, улучшение рельефа кожи.', text: 'Аппарат Energist (Великобритания) создаёт азотную плазму — контролируемный нагрев тканей запускает регенерацию. Срок восстановления зависит от выбранного режима, врач расскажет об этом на консультации.' },
  { id: 'lumecca', href: '/lumecca', title: 'Фотоомоложение IPL InMode Lumecca', forWhat: 'Пигментные пятна, сосудистые звёздочки, покраснения, тон и текстура кожи.', text: 'Интенсивный импульсный свет. Обычно нужно несколько процедур; после — важна защита от солнца. Для комфорта возможна местная анестезия.' },
  { id: 'mediostar', href: '/mediostar', title: 'Лазер MeDioStar Monolith', forWhat: 'Эпиляция, осветление и омоложение кожи.', text: 'Диодный лазер Asclepion (Германия) с контактным охлаждением кожи. Подбор параметров и количество процедур определяет врач на консультации.' },
  { id: 'heleo', href: '/heleo4', title: 'LED-терапия Heleo4', forWhat: 'Акне, состояние и тон кожи.', text: 'Аппарат Heleo Pro LED российского производства: лечение светом разных цветов спектра. Процедура не требует восстановления и подходит как самостоятельно, так и в комплексе с другими методами.' },
  { id: 'lpg', href: '/lpg', title: 'LPG-массаж Cellu M6 Alliance', forWhat: 'Целлюлит, отёки, тонус кожи.', text: 'Аппаратный массаж компании LPG Systems (Франция): вакуумные насадки улучшают кровообращение и тонус кожи, помогают уменьшить отёчность. Заметный результат обычно появляется после нескольких процедур.' },
  { id: 'micro', href: '/micro', title: 'Микротоки Bio-Ultimate Platinum', forWhat: 'Тонус мышц лица и шеи, отёчность, цвет лица.', text: 'Аппарат Micro Current Technology (США): слабые токи стимулируют мышцы и кровообращение. Процедура комфортная и не требует длительного восстановления.' },
];
// Карусель на первом экране: порядок как в макете, стартовый аппарат — Volnewmer (индекс 1)
const slides: { id: string; name: string; text: string; key: ImageKey; w: number; h: number }[] = [
  { id: 'lpg', name: 'LPG-массаж Cellu M6 Alliance', text: 'Аппаратный массаж лица и тела: кровообращение, тонус кожи, отёки, целлюлит.', key: 'deviceLpg', w: 582, h: 760 },
  { id: 'volnewmer', name: 'RF-лифтинг Volnewmer', text: 'Подтяжка и уплотнение кожи лица и шеи без операции.', key: 'deviceVolnewmer', w: 222, h: 760 },
  { id: 'liftera', name: 'SMAS-лифтинг Liftera', text: 'Ультразвуковая подтяжка овала лица и шеи.', key: 'deviceLiftera', w: 380, h: 760 },
  { id: 'heleo', name: 'LED-терапия Heleo4', text: 'Свет разных цветов для кожи: акне и общее состояние.', key: 'deviceHeleo', w: 652, h: 760 },
  { id: 'morpheus', name: 'Morpheus 8', text: 'Игольчатый RF-лифтинг: тонус и упругость кожи лица и тела.', key: 'deviceMorpheus', w: 403, h: 760 },
  { id: 'lumecca', name: 'InMode Lumecca', text: 'Фотоомоложение: пигментация, покраснения, тон кожи.', key: 'deviceLumecca', w: 405, h: 760 },
  { id: 'mediostar', name: 'MeDioStar Monolith', text: 'Диодный лазер: эпиляция и омоложение кожи.', key: 'deviceMediostar', w: 430, h: 760 },
  { id: 'neogen', name: 'NeoGen', text: 'Плазменное омоложение: рельеф и упругость кожи.', key: 'deviceNeogen', w: 334, h: 760 },
  { id: 'micro', name: 'Bio-Ultimate Platinum', text: 'Микротоки: тонус мышц лица, отёчность.', key: 'deviceMicro', w: 700, h: 391 },
].map((x) => ({ ...x, href: '' }));
slides.forEach((x) => { x.href = devices.find((d) => d.id === x.id)!.href; });
const steps = [
  { title: 'Консультация', text: 'Врач соберёт анамнез, выслушает пожелания и оценит состояние кожи.' },
  { title: 'Индивидуальный план', text: 'Подберём аппарат или сочетание процедур и домашний уход под вашу задачу.' },
  { title: 'Процедуры', text: 'Проводим курс и следим за результатом. Если аппарат вам не подходит, скажем об этом сразу.' },
];
const principles = [
  'Подчёркиваем вашу естественную красоту',
  'Специалисты постоянно учатся',
  'Следим за новинками в аппаратной косметологии',
  'Подбираем процедуры индивидуально',
];
const photos: { key: ImageKey; alt: string }[] = [
  { key: 'cosm1', alt: 'Врач с насадкой аппарата во время процедуры' },
  { key: 'cosm3', alt: 'Аппарат Heleo4 в кабинете клиники A&J' },
  { key: 'vol2', alt: 'Насадка аппарата на линии подбородка' },
  { key: 'vol4', alt: 'Аппарат в кабинете клиники A&J' },
];
---
<Base
  title="Аппаратная косметология в Мурманске | Клиника эстетической косметологии A&J"
  description="Аппаратная косметология для лица и тела в клинике A&J в Мурманске: RF-лифтинг, SMAS-лифтинг, лазер, фотоомоложение, LED-терапия, LPG-массаж. Запишитесь онлайн или по номеру 78-70-30"
>
  <section class="cs-hero">
    <Header />

    <div class="container cs-hero__top">
      <nav class="cs-crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Аппаратная косметология</span>
      </nav>
      <p class="cs-eyebrow">Аппаратная косметология</p>
      <h1 class="cs-hero__title">Лицо и тело <span>современные аппараты под вашу задачу</span></h1>
      <p class="cs-hero__lead">Подтяжка, омоложение, работа с пигментацией, акне и целлюлитом. Врач подберёт процедуру на консультации, чтобы подчеркнуть вашу естественную красоту.</p>
    </div>

    <div class="cs-show" id="cs-show">
      <img class="cs-show__letters" src={img('heroLetters')} alt="" width="1200" height="608" aria-hidden="true" />
      <button type="button" class="cs-show__arr cs-show__arr--l" id="cs-prev" aria-label="Предыдущий аппарат" hidden>&#8592;</button>
      <button type="button" class="cs-show__arr cs-show__arr--r" id="cs-next" aria-label="Следующий аппарат" hidden>&#8594;</button>
      <div class="cs-show__track" id="cs-track" role="region" aria-roledescription="карусель" aria-label="Аппараты клиники" tabindex="0">
        {slides.map((x, i) => (
          <a class="cs-show__slide" href={x.href} data-i={i} data-name={x.name} data-text={x.text} aria-label={x.name}>
            <img src={img(x.key)} alt={x.name} width={x.w} height={x.h} loading={i < 3 ? 'eager' : 'lazy'} />
          </a>
        ))}
      </div>
    </div>

    <div class="container cs-hero__bottom">
      <div class="cs-cap" aria-live="polite">
        <p class="cs-cap__name" id="cs-name">{slides[1].name}</p>
        <p class="cs-cap__text" id="cs-text">{slides[1].text}</p>
        <a class="cs-card__link" id="cs-link" href={slides[1].href}>Подробнее о процедуре →</a>
      </div>
      <div class="cs-dots" id="cs-dots">
        {slides.map((x, i) => <button type="button" aria-label={x.name} aria-current={i === 1 ? 'true' : 'false'} data-i={i}></button>)}
      </div>

      <div class="cs-actions">
        <a class="cs-btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться на консультацию</a>
        <a class="cs-phone" href={site.phone.href}>
          <span class="cs-phone__label">или позвоните</span>
          <span class="cs-phone__num">{site.phone.display}</span>
        </a>
      </div>
    </div>

    <div class="cs-benefits">
      <ul class="container cs-benefits__list">
        {benefits.map((b) => (
          <li>
            <img src={img('star')} alt="" width="15" height="15" />
            <div><strong>{b.title}</strong><span>{b.text}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <main>
    <!-- Что вы хотите изменить -->
    <section class="container cs-nav">
      <p class="cs-eyebrow">Подбор по задаче</p>
      <h2 class="cs-title">Что вы хотите изменить?</h2>
      <ul class="cs-nav__list">
        {goals.map((g) => (
          <li class="cs-nav__item">
            <h3>{g.title}</h3>
            <ul>{g.items.map(([id, name]) => <li><a href={`#${id}`}>{name}</a></li>)}</ul>
          </li>
        ))}
      </ul>
    </section>

    <!-- Каталог аппаратов -->
    <section class="cs-devices">
      <div class="container">
        <h2 class="section-title">Наши аппараты и процедуры</h2>
        <p class="cs-devices__lead">В клинике A&amp;J работают на сертифицированных аппаратах ведущих производителей. Какой подойдёт именно вам — решит врач на консультации.</p>
        <ul class="cs-devices__grid">
          {devices.map((d) => (
            <li class="cs-card" id={d.id}>
              <h3>{d.title}</h3>
              <p>{d.forWhat} {d.text}</p>
              <a class="cs-card__link" href={d.href}>Подробнее о процедуре →</a>
            </li>
          ))}
          <li class="cs-card cs-card--soft" id="acne">
            <h3>Аппаратное лечение акне и сосудистых проявлений</h3>
            <p>Здесь нет одного «лучшего» метода: у каждого свои преимущества, и подходит он не всем. Врач соберёт анамнез, подберёт процедуры и индивидуальный уход за кожей.</p>
            <a class="cs-card__link" href={site.bookingUrl} target="_blank" rel="noopener">Записаться на консультацию →</a>
          </li>
        </ul>
        <p class="cs-all">Все процедуры клиники — <a href="/">на главной странице</a></p>
      </div>
    </section>

    <!-- Принципы (винная полоса) -->
    <section class="cs-results">
      <div class="container cs-results__inner">
        <div>
          <h2 class="cs-results__title">Наша задача — подчеркнуть вашу естественную красоту и сохранить молодость</h2>
        </div>
        <ul class="cs-results__list">
          {principles.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>

    <!-- Как проходит -->
    <section class="container cs-steps">
      <h2 class="section-title">Как мы работаем</h2>
      <ol class="cs-steps__list">
        {steps.map((s, i) => (
          <li>
            <span class="cs-steps__num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Фото -->
    <section class="cs-photos" aria-label="Фото из клиники">
      <ul class="container cs-photos__list">
        {photos.map((p) => <li><img src={img(p.key)} alt={p.alt} width="600" height="800" loading="lazy" /></li>)}
      </ul>
    </section>

    <!-- Запись -->
    <section class="cs-cta">
      <div class="container cs-cta__inner">
        <div>
          <h2 class="cs-cta__title">Не знаете, что подойдёт вашей коже?</h2>
          <p class="cs-cta__sub">Приходите на консультацию: соберём анамнез, выслушаем пожелания и подберём процедуры.</p>
          <p class="cs-cta__warn">Имеются противопоказания. Необходима консультация специалиста.</p>
        </div>
        <a class="cs-cta__btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
      </div>
    </section>

    <Contacts />
  </main>
  <Footer />

  <script is:inline src="/cosmetology-carousel.js?v=1" defer></script>
</Base>

<style>
  /* Размеры шрифта — только из общей шкалы --fs-* (styles/global.css), 5 размеров */

  /* Общие элементы — как на первом экране главной */
  .cs-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: var(--w-regular);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wine);
  }
  .cs-eyebrow::before { content: ''; width: 40px; height: 1px; background: currentColor; }
  .cs-title { margin-top: 20px; font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }

  /* ---------- Первый экран ---------- */
  .cs-hero { position: relative; overflow: hidden; background: var(--white); }
  .cs-hero__top { display: flex; flex-direction: column; align-items: center; padding-top: 40px; text-align: center; }
  .cs-crumbs { display: flex; align-self: flex-start; gap: 10px; margin-bottom: 36px; text-align: left; font-size: var(--fs-small); color: var(--muted); }
  .cs-crumbs a { text-decoration: none; }
  .cs-crumbs a:hover { color: var(--wine); }
  .cs-hero .cs-eyebrow { justify-content: center; }
  .cs-hero .cs-eyebrow::after { content: ''; width: 40px; height: 1px; background: currentColor; }
  .cs-hero__title { margin-top: 20px; font-size: var(--fs-h1); line-height: 1.12; font-weight: var(--w-thin); }
  .cs-hero__title span { display: block; color: var(--wine); font-size: var(--fs-h2); line-height: 1.25; margin-top: 8px; }
  .cs-hero__lead { margin-top: 24px; max-width: 520px; color: var(--muted); }

  /* ---------- Карусель аппаратов ---------- */
  .cs-show { position: relative; margin-top: 16px; }
  .cs-show__letters { position: absolute; left: 50%; bottom: 0; width: 66%; max-width: 1000px; height: auto; transform: translateX(-50%); opacity: 0.9; pointer-events: none; }
  .cs-show__track {
    --sw: 340px;
    position: relative;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-inline: calc(50% - var(--sw) / 2);
  }
  .cs-show__track::-webkit-scrollbar { display: none; }
  .cs-show__track:focus-visible { outline: 2px solid var(--wine); outline-offset: -2px; }
  .cs-show__slide {
    flex: 0 0 var(--sw);
    height: 470px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 24px 22px;
    position: relative;
    scroll-snap-align: center;
    opacity: 0.38;
    transform: scale(0.72);
    transform-origin: 50% 100%;
    transition: opacity 0.35s, transform 0.35s;
  }
  .cs-show__slide.is-on { opacity: 1; transform: scale(1); }
  .cs-show__slide img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; filter: drop-shadow(0 18px 18px rgba(38, 35, 35, 0.18)); }
  .cs-show__slide::after { content: ''; position: absolute; left: 18%; right: 18%; bottom: 10px; height: 14px; border-radius: 50%; background: radial-gradient(closest-side, rgba(38, 35, 35, 0.18), transparent); }
  .cs-show__arr {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 52px;
    height: 52px;
    margin-top: -26px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 1px solid var(--wine);
    border-radius: 50%;
    background: var(--white);
    color: var(--wine);
    font-family: var(--font);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-show__arr[hidden] { display: none; }
  .cs-show__arr:hover { background: var(--wine); color: var(--white); }
  .cs-show__arr:focus-visible { outline: 2px solid var(--graphite); outline-offset: 2px; }
  .cs-show__arr--l { left: max(16px, calc(50% - 560px)); }
  .cs-show__arr--r { right: max(16px, calc(50% - 560px)); }

  .cs-hero__bottom { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .cs-cap { min-height: 150px; padding-top: 8px; }
  .cs-cap__name { font-family: var(--font); font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-light); }
  .cs-cap__text { margin: 8px auto 0; max-width: 520px; color: var(--muted); }
  .cs-cap .cs-card__link { display: inline-block; margin-top: 12px; padding-top: 0; }
  .cs-dots { display: flex; justify-content: center; padding: 6px 0 18px; }
  .cs-dots button { width: 24px; height: 24px; padding: 8px; border: 0; background: var(--line); background-clip: content-box; border-radius: 12px; cursor: pointer; transition: width 0.2s; }
  .cs-dots button[aria-current='true'] { width: 38px; background: var(--wine); background-clip: content-box; }

  .cs-actions { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 20px 32px; margin-top: 8px; padding-bottom: 48px; }
  .cs-btn,
  .cs-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    border-radius: 999px;
