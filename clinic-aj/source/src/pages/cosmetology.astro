---
// Страница /cosmetology — новый дизайн по образцу /volnewmer (эталон для страниц аппаратов), 5 размеров шрифта (шкала --fs-*).
// Тексты — со страницы Тильды, освежены и проверены по фактам (analysis/cosmetology-fact-check.md): убраны «безболезненно», «единственный в городе», «российская запатентованная» и т. п.
// Копия страницы с Тильды для сравнения — cosmetology-tilda.astro (/cosmetology-tilda).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { img, type ImageKey } from '../data/images';

const benefits = [
  { title: 'Подбор под вашу задачу', text: 'Сначала консультация и анамнез, потом процедуры — а не наоборот.' },
  { title: 'Оригинальные аппараты', text: 'Asclepion, LPG Systems, InMode, Classys, Asterasys, Energist — ведущие производители.' },
  { title: 'Врачи с медицинским образованием', text: 'Специалисты постоянно проходят обучение и следят за новинками.' },
  { title: 'Три адреса в Мурманске', text: 'Принимаем ежедневно с 9:00 до 21:00, без выходных.' },
];
const goals = [
  { title: 'Подтянуть кожу и овал лица', items: [['volnewmer', 'Volnewmer'], ['liftera', 'Liftera'], ['morpheus', 'Morpheus 8'], ['micro', 'Микротоки']] },
  { title: 'Омолодить кожу и улучшить её качество', items: [['neogen', 'NeoGen'], ['lumecca', 'Lumecca'], ['mediostar', 'MeDioStar']] },
  { title: 'Пигментация и сосудистые проявления', items: [['lumecca', 'Lumecca'], ['mediostar', 'MeDioStar'], ['acne', 'Консультация']] },
  { title: 'Акне и проблемная кожа', items: [['heleo', 'Heleo4'], ['acne', 'Консультация']] },
  { title: 'Целлюлит, отёки и тонус тела', items: [['lpg', 'LPG-массаж'], ['morpheus', 'Morpheus 8']] },
  { title: 'Не знаю, что мне подойдёт', items: [['acne', 'Записаться на консультацию']] },
];
const devices = [
  { id: 'volnewmer', href: '/volnewmer', tag: 'RF-лифтинг', title: 'Volnewmer', forWhat: 'Подтяжка и уплотнение кожи лица и шеи без операции.', text: 'Монополярная радиочастотная энергия прогревает глубокие слои кожи и запускает выработку коллагена. Аппарат Classys (Корея), насадка с водяным охлаждением, восстановление минимальное.' },
  { id: 'liftera', href: '/smas', tag: 'Ультразвуковой SMAS-лифтинг', title: 'Liftera', forWhat: 'Подтяжка овала лица и шеи.', text: 'Фокусированный ультразвук (HIFU) воздействует на глубокие слои кожи без разрезов. Аппарат Asterasys (Корея). Эффект нарастает постепенно, в течение нескольких месяцев; во время процедуры возможен лёгкий дискомфорт.' },
  { id: 'morpheus', href: '/rf', tag: 'Игольчатый RF-лифтинг', title: 'Morpheus 8', forWhat: 'Тонус и упругость кожи лица и тела, морщины, рубцы и постакне.', text: 'Аппарат InMode: радиочастотные микроиглы стимулируют коллаген и эластин. Процедура минимально инвазивная — проводится с местной анестезией, в первые дни возможны покраснение и отёчность. Для тела есть насадка с иглами до 7 мм.' },
  { id: 'neogen', href: '/neogen', tag: 'Плазменное омоложение', title: 'NeoGen', forWhat: 'Подтяжка, разглаживание морщин, улучшение рельефа кожи.', text: 'Аппарат Energist (Великобритания) создаёт азотную плазму — контролируемный нагрев тканей запускает регенерацию. Срок восстановления зависит от выбранного режима, врач расскажет об этом на консультации.' },
  { id: 'lumecca', href: '/lumecca', tag: 'Фотоомоложение IPL', title: 'InMode Lumecca', forWhat: 'Пигментные пятна, сосудистые звёздочки, покраснения, тон и текстура кожи.', text: 'Интенсивный импульсный свет. Обычно нужно несколько процедур; после — важна защита от солнца. Для комфорта возможна местная анестезия.' },
  { id: 'mediostar', href: '/mediostar', tag: 'Лазер', title: 'MeDioStar Monolith', forWhat: 'Эпиляция, осветление и омоложение кожи.', text: 'Диодный лазер Asclepion (Германия) с контактным охлаждением кожи. Подбор параметров и количество процедур определяет врач на консультации.' },
  { id: 'heleo', href: '/heleo4', tag: 'LED-терапия', title: 'Heleo4', forWhat: 'Акне, состояние и тон кожи.', text: 'Лечение светом разных цветов спектра. Процедура не требует восстановления и подходит как самостоятельно, так и в комплексе с другими методами.' },
  { id: 'lpg', href: '/lpg', tag: 'LPG-массаж лица и тела', title: 'LPG Cellu M6 Alliance', forWhat: 'Целлюлит, отёки, тонус кожи.', text: 'Аппаратный массаж компании LPG Systems (Франция): вакуумные насадки улучшают кровообращение и тонус кожи, помогают уменьшить отёчность. Заметный результат обычно появляется после нескольких процедур.' },
  { id: 'micro', href: '/micro', tag: 'Микротоковая терапия', title: 'Bio-Ultimate Platinum DELUXE', forWhat: 'Тонус мышц лица и шеи, отёчность, цвет лица.', text: 'Слабые токи стимулируют мышцы и кровообращение. Процедура комфортная и не требует длительного восстановления.' },
];
const steps = [
  { title: 'Консультация', text: 'Врач соберёт анамнез, выслушает пожелания и оценит состояние кожи.' },
  { title: 'Индивидуальный план', text: 'Подберём аппарат или сочетание процедур и домашний уход под вашу задачу.' },
  { title: 'Процедуры', text: 'Проводим курс и следим за результатом. Если аппарат вам не подходит, скажем об этом сразу.' },
];
const principles = [
  'Подчёркиваем вашу естественную красоту',
  'Специалисты постоянно учатся',
  'Следим за новинками в аппаратной косметологии',
  'Подбираем процедуры индивидуально',
];
const photos: { key: ImageKey; alt: string }[] = [
  { key: 'cosm1', alt: 'Врач с насадкой аппарата во время процедуры' },
  { key: 'cosm3', alt: 'Аппарат Heleo4 в кабинете клиники A&J' },
  { key: 'vol2', alt: 'Насадка аппарата на линии подбородка' },
  { key: 'vol4', alt: 'Аппарат в кабинете клиники A&J' },
];
---
<Base
  title="Аппаратная косметология в Мурманске | Клиника эстетической косметологии A&J"
  description="Аппаратная косметология для лица и тела в клинике A&J в Мурманске: RF-лифтинг, SMAS-лифтинг, лазер, фотоомоложение, LED-терапия, LPG-массаж. Запишитесь онлайн или по номеру 78-70-30"
>
  <section class="cs-hero">
    <Header />

    <div class="container cs-hero__top">
      <div class="cs-hero__text">
        <nav class="cs-crumbs" aria-label="Хлебные крошки">
          <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Аппаратная косметология</span>
        </nav>
        <p class="cs-eyebrow">Аппаратная косметология</p>
        <h1 class="cs-hero__title">Лицо и тело <span>современные аппараты под вашу задачу</span></h1>
        <p class="cs-hero__lead">Подтяжка, омоложение, работа с пигментацией, акне и целлюлитом. Врач подберёт процедуру на консультации, чтобы подчеркнуть вашу естественную красоту.</p>

        <div class="cs-actions">
          <a class="cs-btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться на консультацию</a>
          <a class="cs-phone" href={site.phone.href}>
            <span class="cs-phone__label">или позвоните</span>
            <span class="cs-phone__num">{site.phone.display}</span>
          </a>
        </div>
      </div>

      <div class="cs-hero__visual" aria-hidden="true">
        <img class="cs-hero__letters" src={img('heroLetters')} alt="" width="1200" height="608" />
        <img class="cs-hero__doctors" src={img('heroDoctors')} alt="" width="600" height="838" fetchpriority="high" />
      </div>
    </div>

    <div class="cs-benefits">
      <ul class="container cs-benefits__list">
        {benefits.map((b) => (
          <li>
            <img src={img('star')} alt="" width="15" height="15" />
            <div><strong>{b.title}</strong><span>{b.text}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <main>
    <!-- Что вы хотите изменить -->
    <section class="container cs-nav">
      <p class="cs-eyebrow">Подбор по задаче</p>
      <h2 class="cs-title">Что вы хотите изменить?</h2>
      <ul class="cs-nav__list">
        {goals.map((g) => (
          <li class="cs-nav__item">
            <h3>{g.title}</h3>
            <ul>{g.items.map(([id, name]) => <li><a href={`#${id}`}>{name}</a></li>)}</ul>
          </li>
        ))}
      </ul>
    </section>

    <!-- Каталог аппаратов -->
    <section class="cs-devices">
      <div class="container">
        <h2 class="section-title">Наши аппараты и процедуры</h2>
        <p class="cs-devices__lead">В клинике A&amp;J работают на сертифицированных аппаратах ведущих производителей. Какой подойдёт именно вам — решит врач на консультации.</p>
        <ul class="cs-devices__grid">
          {devices.map((d) => (
            <li class="cs-card" id={d.id}>
              <span class="cs-card__tag">{d.tag}</span>
              <h3>{d.title}</h3>
              <p class="cs-card__for">{d.forWhat}</p>
              <p>{d.text}</p>
              <a class="cs-card__link" href={d.href}>Подробнее о процедуре →</a>
            </li>
          ))}
          <li class="cs-card cs-card--soft" id="acne">
            <span class="cs-card__tag">Консультация</span>
            <h3>Аппаратное лечение акне и сосудистых проявлений</h3>
            <p>Здесь нет одного «лучшего» метода: у каждого свои преимущества, и подходит он не всем. Врач соберёт анамнез, подберёт процедуры и индивидуальный уход за кожей.</p>
            <a class="cs-card__link" href={site.bookingUrl} target="_blank" rel="noopener">Записаться на консультацию →</a>
          </li>
        </ul>
        <p class="cs-all">Все процедуры клиники — <a href="/">на главной странице</a></p>
      </div>
    </section>

    <!-- Принципы (винная полоса) -->
    <section class="cs-results">
      <div class="container cs-results__inner">
        <div>
          <h2 class="cs-results__title">Наша задача — подчеркнуть вашу естественную красоту и сохранить молодость</h2>
        </div>
        <ul class="cs-results__list">
          {principles.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>

    <!-- Как проходит -->
    <section class="container cs-steps">
      <h2 class="section-title">Как мы работаем</h2>
      <ol class="cs-steps__list">
        {steps.map((s, i) => (
          <li>
            <span class="cs-steps__num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Фото -->
    <section class="cs-photos" aria-label="Фото из клиники">
      <ul class="container cs-photos__list">
        {photos.map((p) => <li><img src={img(p.key)} alt={p.alt} width="600" height="800" loading="lazy" /></li>)}
      </ul>
    </section>

    <!-- Запись -->
    <section class="cs-cta">
      <div class="container cs-cta__inner">
        <div>
          <h2 class="cs-cta__title">Не знаете, что подойдёт вашей коже?</h2>
          <p class="cs-cta__sub">Приходите на консультацию: соберём анамнез, выслушаем пожелания и подберём процедуры.</p>
          <p class="cs-cta__warn">Имеются противопоказания. Необходима консультация специалиста.</p>
        </div>
        <a class="cs-cta__btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
      </div>
    </section>

    <Contacts />
  </main>
  <Footer />
</Base>

<style>
  /* Размеры шрифта — только из общей шкалы --fs-* (styles/global.css), 5 размеров */

  /* Общие элементы — как на первом экране главной */
  .cs-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: var(--w-regular);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wine);
  }
  .cs-eyebrow::before { content: ''; width: 40px; height: 1px; background: currentColor; }
  .cs-title { margin-top: 20px; font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }

  /* ---------- Первый экран ---------- */
  .cs-hero { position: relative; overflow: hidden; background: var(--white); }
  .cs-hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 40px;
    min-height: 600px;
  }
  .cs-hero__text { position: relative; z-index: 2; padding: 40px 0 64px; }
  .cs-crumbs { display: flex; gap: 10px; margin-bottom: 36px; font-size: var(--fs-small); color: var(--muted); }
  .cs-crumbs a { text-decoration: none; }
  .cs-crumbs a:hover { color: var(--wine); }
  .cs-hero__title { margin-top: 28px; font-size: var(--fs-h1); line-height: 1.12; font-weight: var(--w-thin); }
  .cs-hero__title span { display: block; color: var(--wine); font-size: var(--fs-h2); line-height: 1.25; margin-top: 8px; }
  .cs-hero__lead { margin-top: 28px; max-width: 460px; color: var(--muted); }

  .cs-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px 32px; margin-top: 40px; }
  .cs-btn,
  .cs-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    border-radius: 999px;
    font-family: var(--font);
    font-size: var(--fs-body);
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-btn { background: var(--wine); color: var(--white); }
  .cs-btn:hover { background: var(--graphite); }
  .cs-phone { display: grid; text-decoration: none; line-height: 1.2; }
  .cs-phone__label { font-size: var(--fs-small); color: var(--muted); }
  .cs-phone__num { font-family: var(--font); font-size: var(--fs-h3); letter-spacing: 0.5px; }
  .cs-phone:hover .cs-phone__num { color: var(--wine); }

  /* Девушка и аппарат на фоне большого логотипа A&J — как врачи на главной */
  .cs-hero__visual { position: relative; z-index: 1; }
  .cs-hero__visual img { position: absolute; bottom: 0; max-width: none; }
  .cs-hero__letters { left: 50%; width: 1000px; transform: translateX(-50%); }
  .cs-hero__doctors { left: 50%; width: 420px; transform: translateX(-44%); }
  .cs-hero__device { right: 0; width: 260px; }

  .cs-benefits { border-top: 1px solid var(--line); }
  .cs-benefits__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0 auto;
    padding-top: 32px;
    padding-bottom: 36px;
    list-style: none;
  }
  .cs-benefits__list li { display: flex; gap: 10px; font-size: var(--fs-small); line-height: 1.45; }
  .cs-benefits__list img { flex: none; margin-top: 5px; }
  .cs-benefits__list strong { display: block; font-family: var(--font); font-size: var(--fs-body); font-weight: var(--w-regular); }
  .cs-benefits__list span { color: var(--muted); }

  /* ---------- Что такое Volnewmer ---------- */
  .cs-about { background: var(--ivory); padding: 88px 0; }
  .cs-about__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 64px; align-items: start; }
  .cs-about__p { margin-top: 24px; }
  .cs-about__p--lead { margin-top: 0; font-size: var(--fs-h3); line-height: 1.5; }
  .cs-about__p strong { font-weight: var(--w-medium); }
  .cs-about__reg { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); font-size: var(--fs-small); color: var(--muted); }

  /* ---------- Проблемы ---------- */
  .cs-problems { padding: 88px 0 72px; }
  .cs-problems__title { --title-line: var(--line); }
  .cs-problems__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 64px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .cs-problems__list li {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font);
    font-size: var(--fs-h3);
    font-weight: var(--w-thin);
  }
  .cs-problems__num { flex: none; font-size: var(--fs-small); color: var(--wine); letter-spacing: 1px; }

  /* ---------- Результат (винная полоса) ---------- */
  .cs-results { background: var(--wine); color: var(--white); }
  .cs-results__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 64px;
    padding-top: 72px;
    padding-bottom: 72px;
  }
  .cs-results__title { font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }
  .cs-results__note { margin-top: 20px; max-width: 380px; color: rgba(255, 255, 255, 0.85); }
  .cs-results__list { margin: 0; padding: 0; list-style: none; }
  .cs-results__list li {
    padding: 16px 0 16px 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    background: url('/images/star.svg') 0 22px / 15px no-repeat;
    font-family: var(--font);
    font-size: var(--fs-h3);
    font-weight: var(--w-thin);
  }
  .cs-results__list li:first-child { padding-top: 0; background-position: 0 6px; }

  /* ---------- Шаги ---------- */
  .cs-steps { padding-top: 88px; padding-bottom: 72px; }
  .cs-steps__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-steps__num {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--wine);
    border-radius: 50%;
    color: var(--wine);
    font-family: var(--font);
    font-size: var(--fs-body);
  }
  .cs-steps__list h3 { margin-top: 20px; font-size: var(--fs-h3); }
  .cs-steps__list p { margin-top: 10px; color: var(--muted); }

  /* ---------- Фото ---------- */
  .cs-photos__list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin: 0 auto; list-style: none; }
  .cs-photos__list img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }

  /* ---------- Показания / противопоказания ---------- */
  .cs-med { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-top: 88px; padding-bottom: 88px; }
  .cs-med__card { padding: 40px; background: var(--ivory); }
  .cs-med__card--alt { background: var(--white); border: 1px solid var(--line); }
  .cs-med__card h2 { font-size: var(--fs-h3); }
  .cs-med__card ul { margin: 20px 0 0; padding-left: 20px; }
  .cs-med__card li { padding: 4px 0; }
  .cs-med__card li::marker { color: var(--wine); }
  .cs-med__card p { margin-top: 16px; font-size: var(--fs-small); color: var(--muted); }


  /* ---------- Запись (тёмная полоса) ---------- */
  .cs-cta { background: var(--graphite); color: var(--ivory); margin-bottom: 80px; }
  .cs-cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 40px; padding-top: 48px; padding-bottom: 52px; }
  .cs-cta__title { font-size: var(--fs-h2); line-height: 1.15; }
  .cs-cta__sub { margin-top: 10px; color: rgba(241, 234, 224, 0.8); }
  .cs-cta__warn { margin-top: 8px; font-size: var(--fs-small); letter-spacing: 0.5px; text-transform: uppercase; color: rgba(241, 234, 224, 0.6); }
  .cs-cta__btn { background: var(--ivory); color: var(--graphite); }
