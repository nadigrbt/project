    { href: '/instructions#bio', label: 'Памятка перед процедурой и после' },
    { href: '/injections', label: 'Инъекционная косметология' },
    { href: '/biorevitalization', label: 'Биоревитализация' },
    { href: '/plazma', label: 'Плазмолифтинг' },
    { href: '/kollagenoterapiya', label: 'Коллагенотерапия' },
    { href: '/cosmetology', label: 'Аппаратная косметология' },
  ]}
  ctaTitle="Хотите узнать, подойдёт ли вам мезотерапия?"
