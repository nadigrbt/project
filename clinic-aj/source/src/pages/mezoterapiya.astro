// «уменьшает морщины и глубину носогубных складок», «помогает в борьбе с пигментацией», «быстро насыщается». Названия препаратов, время и число процедур не пишем.
// Зона вокруг глаз — со страницы акций (/sale). Отчёт — analysis/injections-pages-fact-check.md.
import ProcedurePage from '../components/ProcedurePage.astro';
---
<ProcedurePage
  title="Мезотерапия лица в Мурманске | Клиника эстетической косметологии A&J"
  description="Мезотерапия лица, шеи и декольте в клинике A&J в Мурманске: микроинъекции витаминов и аминокислот, состав подбирает врач. Запишитесь онлайн или по номеру 78-70-30"
  path="/mezoterapiya"
  crumb="Мезотерапия"
  h1="Мезотерапия"
  h1Accent="микроинъекции для кожи"
  lead="Витамины, аминокислоты и другие активные вещества вводятся в кожу микроинъекциями. Состав и курс врач подбирает на консультации под вашу задачу."
  benefits={[
    { title: 'Консультация перед процедурой', text: 'Врач оценит состояние кожи, подберёт состав и расскажет о противопоказаниях.' },
    { title: 'Врачи с медицинским образованием', text: 'Специалисты постоянно учатся и работают индивидуально.' },
    { title: 'Сертифицированные препараты', text: 'Подбираем под вашу кожу и задачу, а не по шаблону.' },
    { title: 'Три адреса в Мурманске', text: 'Принимаем ежедневно с 9:00 до 21:00, без выходных.' },
  ]}
  introTitle="Что такое мезотерапия"
  intro="Мезотерапия — малоинвазивная процедура, при которой в кожу тонкими иглами вводят комплексы витаминов, аминокислот, минералов и других активных веществ. Её применяют в уходе за кожей лица, шеи и декольте. Результат у каждого свой: он зависит от исходного состояния кожи и курса, который назначает врач."
  how={[
    { title: 'Что вводят', text: 'Коктейль из витаминов, аминокислот, минералов и других активных веществ. Состав врач подбирает под задачу и состояние кожи, а не по шаблону.' },
    { title: 'Как проходит', text: 'Препарат вводится в кожу микроинъекциями тонкой иглой в выбранных зонах. Обычно назначают курс, число процедур и интервалы определяет врач.' },
  ]}
  zonesEyebrow="Зоны"
  zonesTitle="С какими зонами работаем"
  zones={[
    { title: 'Лицо', text: 'Тусклый цвет, сниженный тонус, мелкие морщины, неровная текстура кожи.' },
    { title: 'Кожа вокруг глаз', text: 'Тонкая кожа, мелкие морщинки, уставший вид.' },
    { title: 'Шея и декольте', text: 'Сухость и снижение упругости кожи.' },
  ]}
  whenList={[
    'Кожа выглядит тусклой и уставшей',
    'Снизился тонус, появились мелкие морщины',
    'Неровная текстура кожи',
    'Хочется поддержать кожу при смене сезона или в рамках регулярного ухода',
  ]}
  steps={[
    { title: 'Консультация', text: 'Врач выслушает пожелания, оценит состояние кожи и расскажет о противопоказаниях.' },
    { title: 'Подбор состава', text: 'Врач подберёт состав, зоны и схему курса. Если процедура вам не нужна, скажем об этом сразу.' },
    { title: 'Процедура и наблюдение', text: 'Врач проведёт процедуру, объяснит уход после неё и договорится о повторном визите, если он нужен.' },
  ]}
  faq={[
    { q: 'Чем мезотерапия отличается от биоревитализации?', a: 'При биоревитализации в кожу вводят гиалуроновую кислоту, а при мезотерапии — коктейль из витаминов, аминокислот и других веществ, состав которого подбирают под задачу. Какой метод подойдёт вам, решит врач на консультации.' },
    { q: 'Это больно?', a: 'Ощущения индивидуальны: используются тонкие иглы. Если вы беспокоитесь, обсудите обезболивание с врачом до процедуры.' },
    { q: 'Сколько нужно процедур?', a: 'Обычно мезотерапию проводят курсом. Число процедур и интервалы назначает врач после осмотра.' },
    { q: 'Что будет после процедуры?', a: 'В местах инъекций возможны небольшие покраснение, отёчность и следы от уколов, обычно они проходят в течение нескольких дней. Как ухаживать за кожей после процедуры, расскажет врач.' },
    { q: 'Как подготовиться?', a: 'Врач расскажет о подготовке на консультации. Сообщите о принимаемых лекарствах и о процедурах, которые вы делали в последнее время.' },
  ]}
  contra={[
    'беременность и грудное вскармливание',
    'воспаление, инфекция или высыпания в зоне процедуры',
    'аллергия на компоненты препарата',
    'нарушения свёртываемости крови',
    'онкологические заболевания',
    'обострение хронических заболеваний',
  ]}
