---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Страница не найдена — клиника A&J" description="Такой страницы нет на сайте клиники A&J в Мурманске" noindex>
  <Header />
  <main class="nf container">
    <h1>Страница не найдена</h1>
    <p>Возможно, она переехала. Начните с <a href="/">главной</a> или позвоните нам: <a href="tel:+78152787030">78-70-30</a>.</p>
  </main>
  <Footer />
</Base>

<style>
  .nf { padding-top: 100px; padding-bottom: 60px; }
  .nf h1 { font-size: 45px; line-height: 59px; }
  .nf p { margin-top: 20px; }
</style>
