---
// Страница /estetica — новый дизайн в стиле /injections, 5 размеров шрифта (шкала --fs-*).
// Тексты — со страницы Тильды /estetica, освежены и проверены: убраны «единственном в городе», «эффективный метод борьбы с возрастными изменениями»,
// «заметные результаты после нескольких процедур», «устранить морщины», «уменьшить пигментацию», «не вызывает боли», «более эффективной, чем ручная», цена в описании для поиска (38-ФЗ).
// Копию Тильды не делаем (решение владельца 18.10).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Directions from '../components/Directions.astro';
import { site } from '../data/site';
import { img } from '../data/images';

const benefits = [
  { title: 'Консультация перед процедурой', text: 'Косметолог оценит состояние кожи, подберёт процедуру и расскажет о противопоказаниях.' },
  { title: 'Специалисты с медицинским образованием', text: 'Врачи и косметологи постоянно учатся и работают индивидуально.' },
  { title: 'Профессиональное оборудование', text: 'LPG-массаж и микротоковая терапия на аппаратах клиники.' },
  { title: 'Три адреса в Мурманске', text: 'Принимаем ежедневно с 9:00 до 21:00, без выходных.' },
];
const goals = [
  { title: 'Очистить кожу', items: [['clean-manual', 'Ручная чистка'], ['clean-hw', 'Аппаратная чистка']] },
  { title: 'Обновить текстуру и тон кожи', items: [['peel', 'Пилинги'], ['clean-hw', 'Аппаратная чистка']] },
  { title: 'Улучшить тонус кожи лица и шеи', items: [['micro', 'Микротоковая терапия'], ['lpg', 'LPG-массаж']] },
  { title: 'Снять отёчность и усталость', items: [['lpg', 'LPG-массаж'], ['vibro', 'Вибрационный массаж'], ['micro', 'Микротоковая терапия']] },
  { title: 'Поработать с телом и объёмами', items: [['anticell', 'Антицеллюлитный массаж'], ['lpg', 'LPG-массаж'], ['vibro', 'Вибрационный массаж']] },
  { title: 'Ухаживать за интимной зоной', items: [['intim', 'Интимный пилинг']] },
];
const procedures: { id: string; href: string; title: string; forWhat: string; text: string }[] = [
  { id: 'anticell', href: '', title: 'Ручной антицеллюлитный массаж', forWhat: 'Тонус кожи тела, отёчность, ощущение тяжести.', text: 'Массаж выполняется вручную с кремами и маслами разными массажными техниками. Помогает улучшить кровообращение и состояние кожи. Технику и зоны косметолог подбирает на консультации.' },
  { id: 'vibro', href: '', title: 'Вибрационный массаж', forWhat: 'Мышечное напряжение, отёчность, тонус кожи.', text: 'На кожу и мышцы воздействует вибрация специального прибора. Такой массаж помогает улучшить кровообращение, снять напряжение в мышцах и поддержать тонус кожи.' },
  { id: 'lpg', href: '/lpg', title: 'LPG-массаж лица и тела', forWhat: 'Тонус кожи, отёчность, неровный рельеф кожи на теле.', text: 'Массаж на аппарате LPG Cellu M6 Alliance: вакуумные насадки мягко воздействуют на кожу и подкожные ткани. Процедура помогает улучшить кровообращение и тонус кожи и уменьшить отёчность. Курс и количество процедур подбирает специалист.' },
  { id: 'peel', href: '', title: 'Пилинги', forWhat: 'Тусклый цвет лица, неровная текстура кожи, возрастные изменения.', text: 'Химические пилинги обновляют верхние слои кожи и помогают улучшить её текстуру. В клинике работают с пилингами pH Formula, Biorepeel, PRX, Sesderma и DSA. Какой подойдёт именно вам, определит косметолог на консультации.' },
  { id: 'intim', href: '/intim-piling', title: 'Интимный пилинг', forWhat: 'Уход за кожей интимной зоны.', text: 'Пилинг Lactyferrin intimate peel для ухода за кожей интимной зоны. Показания и противопоказания обсудит специалист на консультации.' },
  { id: 'clean-manual', href: '/clean', title: 'Ручная чистка лица', forWhat: 'Загрязнения, чёрные точки, неровная кожа.', text: 'Косметолог вручную очищает кожу от загрязнений и омертвевших клеток, удаляет чёрные точки и делает массаж. Используются специальные инструменты и косметика, подобранные под ваш тип кожи.' },
  { id: 'clean-hw', href: '/clean', title: 'Аппаратная чистка лица', forWhat: 'Чёрные точки, омертвевшие клетки, проблемная кожа.', text: 'Очищение проводится на специальном аппарате: он помогает удалить загрязнения и омертвевшие клетки и улучшить кровообращение. При необходимости чистку дополняют другими процедурами. Ручная или аппаратная, подскажет косметолог.' },
  { id: 'micro', href: '/micro', title: 'Микротоковая терапия', forWhat: 'Тонус лица и шеи, отёчность, усталый вид.', text: 'Процедура на аппарате Bio-Ultimate Platinum: слабые микротоки воздействуют на мышцы лица и шеи. Помогает улучшить кровообращение, уменьшить отёчность и поддержать тонус кожи. Восстановление, как правило, не требуется.' },
];
const principles = [
  'Подбираем процедуру под вашу кожу',
  'Объясняем, как проходит процедура и что делать после неё',
  'Рассказываем, чем процедуры отличаются друг от друга',
  'Не предлагаем лишнего',
];
const steps = [
  { title: 'Консультация', text: 'Косметолог выслушает пожелания, оценит состояние кожи и расскажет о противопоказаниях.' },
  { title: 'Индивидуальный план', text: 'Подберём процедуры и их порядок. Если процедура вам не нужна, скажем об этом сразу.' },
  { title: 'Процедура и уход', text: 'Проводим процедуру, объясняем домашний уход и договариваемся о повторном визите, если он нужен.' },
];
const faq = [
  { q: 'Чем ручная чистка отличается от аппаратной?', a: 'При ручной чистке косметолог очищает кожу вручную, при аппаратной используется специальный прибор. Какой вариант подойдёт вам, зависит от состояния кожи, это подскажет специалист.' },
  { q: 'Нужна ли подготовка к пилингу?', a: 'Да, обычно кожу готовят заранее, а после пилинга нужен особый уход и защита от солнца. Косметолог расскажет, как подготовиться и что делать после процедуры.' },
  { q: 'Нужно ли восстановление?', a: 'Это зависит от процедуры. После чистки и пилинга кожа может быть покрасневшей или чувствительной, после массажей и микротоковой терапии восстановление, как правило, не нужно. Подробности расскажет специалист.' },
  { q: 'Сколько процедур нужно?', a: 'Количество процедур и интервалы подбирает специалист после осмотра: они зависят от задачи и состояния кожи.' },
  { q: 'Нужна ли консультация перед процедурой?', a: 'Да. Перед процедурой косметолог оценивает состояние кожи, уточняет противопоказания и подбирает схему.' },
];
const contra = [
  'беременность и грудное вскармливание',
  'воспаление, высыпания, герпес или повреждения кожи в зоне процедуры',
  'онкологические заболевания',
  'аллергия на компоненты косметики и препаратов',
  'кардиостимулятор и металлические импланты (для аппаратных методик)',
  'варикоз, тромбофлебит и острые воспаления (для массажей)',
];
---
<Base
  title="Чистки, пилинги и массажи в Мурманске | Клиника эстетической косметологии A&J"
  description="Эстетическая косметология в клинике A&J в Мурманске: чистки и пилинги лица, массажи, LPG и микротоковая терапия. Запишитесь онлайн или по номеру 78-70-30"
>
  <section class="cs-hero">
    <Header />

    <div class="container">
      <nav class="cs-crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Эстетическая косметология</span>
      </nav>
    </div>

    <div class="container in-hero">
      <div class="in-hero__text">
        <p class="cs-eyebrow">Эстетическая косметология</p>
        <h1 class="cs-hero__title">Эстетическая косметология <span>забота о красоте и здоровье кожи</span></h1>
        <p class="cs-hero__lead">Чистки и пилинги лица, массажи, LPG и микротоковая терапия. Косметолог подберёт процедуры на консультации.</p>
        <div class="cs-actions">
          <a class="cs-btn" href="#contact">Записаться на консультацию</a>
          <a class="cs-phone" href={site.phone.href}>
            <span class="cs-phone__label">или позвоните</span>
            <span class="cs-phone__num">{site.phone.display}</span>
          </a>
        </div>
      </div>
      <div class="in-hero__visual" aria-hidden="true">
        <img class="in-hero__letters" src={img('cosmLetters')} alt="" width="1183" height="821" />
        <img class="in-hero__woman" src={img('promoWoman')} alt="" width="700" height="700" fetchpriority="high" />
      </div>
    </div>

    <div class="cs-benefits">
      <ul class="container cs-benefits__list">
        {benefits.map((b) => (
          <li>
            <img src={img('star')} alt="" width="15" height="15" />
            <div><strong>{b.title}</strong><span>{b.text}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <main>
    <!-- О направлении -->
    <section class="container cs-intro">
      <p class="cs-eyebrow">О направлении</p>
      <h2 class="cs-title">Бережный уход за кожей и телом</h2>
      <p class="cs-intro__text">Эстетическая косметология — это процедуры, которые помогают поддерживать здоровье и красивый вид кожи: очищение, обновление, массажи и аппаратные методики. Они не требуют хирургического вмешательства. Результат у каждого свой, поэтому специалист сначала знакомится с вашей кожей и пожеланиями, а уже потом предлагает процедуры.</p>
    </section>

    <!-- Что вы хотите изменить -->
    <section class="container cs-nav">
      <p class="cs-eyebrow">Подбор по задаче</p>
      <h2 class="cs-title">Что вы хотите изменить?</h2>
      <ul class="cs-nav__list">
        {goals.map((g) => (
          <li class="cs-nav__item">
            <h3>{g.title}</h3>
            <ul>{g.items.map(([id, name]) => <li><a href={`#${id}`}>{name}</a></li>)}</ul>
          </li>
        ))}
      </ul>
    </section>

    <!-- Каталог процедур -->
    <section class="cs-devices">
      <div class="container">
        <h2 class="section-title">Наши процедуры</h2>
        <p class="cs-devices__lead">Какая процедура подойдёт именно вам, решит специалист на консультации: у каждой есть показания и противопоказания.</p>
        <ul class="cs-devices__grid">
          {procedures.map((d) => (
            <li class="cs-card" id={d.id}>
              <h3>{d.title}</h3>
              <p class="cs-card__for">{d.forWhat}</p>
              <p>{d.text}</p>
              {d.href
                ? <a class="cs-card__link" href={d.href}>Подробнее о процедуре →</a>
                : <a class="cs-card__link" href="#contact">Записаться на консультацию →</a>}
            </li>
          ))}
          <li class="cs-card cs-card--soft" id="consult">
            <h3>Не знаете, с чего начать?</h3>
            <p>Косметолог оценит состояние кожи и предложит план: какие процедуры нужны, в каком порядке и что подойдёт в домашнем уходе.</p>
            <a class="cs-card__link" href="#contact">Записаться на консультацию →</a>
          </li>
        </ul>
        <p class="cs-all">Все процедуры клиники — <a href="/">на главной странице</a></p>
      </div>
    </section>

    <!-- Принципы (винная полоса) -->
    <section class="cs-results">
      <div class="container cs-results__inner">
        <div>
          <h2 class="cs-results__title">Здоровая и ухоженная кожа</h2>
          <p class="cs-results__note">Наша задача — помочь коже выглядеть свежо и ухоженно.</p>
        </div>
        <ul class="cs-results__list">
          {principles.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>

    <!-- Как проходит -->
    <section class="container cs-steps">
      <h2 class="section-title">Как мы работаем</h2>
      <ol class="cs-steps__list">
        {steps.map((s, i) => (
          <li>
            <span class="cs-steps__num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Вопросы -->
    <section class="container in-faq">
      <p class="cs-eyebrow">Вопросы и ответы</p>
      <h2 class="cs-title">Что обычно спрашивают</h2>
      <div class="in-faq__list">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Противопоказания + аппаратные методы -->
    <section class="container cs-med">
      <div class="cs-med__card">
        <h2>Когда процедуры могут быть невозможны</h2>
        <ul>
          {contra.map((c) => <li>{c}</li>)}
        </ul>
        <p>Это общий перечень: у каждой процедуры и препарата он свой. Имеются противопоказания. Необходима консультация специалиста.</p>
      </div>
      <div class="cs-med__card cs-med__card--alt">
        <h2>Другие направления</h2>
        <p class="in-cross__text">Если нужны другие методы, в клинике есть инъекционная и аппаратная косметология.</p>
        <p class="in-cross__links">
          <a href="/injections">Инъекционная косметология →</a>
          <a href="/cosmetology">Аппаратная косметология →</a>
          <a href="/volnewmer">RF-лифтинг Volnewmer →</a>
        </p>
      </div>
    </section>

    <Directions current="/estetica" />

    <!-- Запись -->
    <section class="cs-cta">
      <div class="container cs-cta__inner">
        <div>
          <h2 class="cs-cta__title">Хотите узнать, что подойдёт вашей коже?</h2>
          <p class="cs-cta__sub">Приходите на консультацию: подберём процедуры и расскажем, как всё проходит.</p>
          <p class="cs-cta__warn">Имеются противопоказания. Необходима консультация специалиста.</p>
        </div>
        <a class="cs-cta__btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
      </div>
    </section>

    <Contacts />
  </main>
  <Footer />
</Base>

<style>
  /* Размеры шрифта — только из общей шкалы --fs-* (styles/global.css), 5 размеров */

  .cs-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: var(--w-regular);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wine);
  }
  .cs-eyebrow::before { content: ''; width: 40px; height: 1px; background: currentColor; }
  .cs-title { margin-top: 20px; font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }

  /* ---------- Первый экран ---------- */
  .cs-hero { position: relative; overflow: hidden; background: var(--white); }
  .cs-crumbs { display: flex; gap: 10px; padding-top: 40px; font-size: var(--fs-small); color: var(--muted); }
  .cs-crumbs a { text-decoration: none; }
  .cs-crumbs a:hover { color: var(--wine); }
  .in-hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 40px; align-items: end; padding-top: 28px; padding-bottom: 0; }
  .cs-hero__title { margin-top: 20px; font-size: var(--fs-h1); line-height: 1.12; font-weight: var(--w-thin); }
  .cs-hero__title span { display: block; color: var(--wine); font-size: var(--fs-h2); line-height: 1.25; margin-top: 8px; }
  .cs-hero__lead { margin-top: 24px; max-width: 520px; color: var(--muted); }
  .in-hero__text { padding-bottom: 64px; }
  .in-hero__visual { position: relative; display: grid; justify-items: center; align-items: end; min-height: 440px; }
  .in-hero__letters { position: absolute; left: 50%; bottom: 0; width: 100%; max-width: 640px; height: auto; transform: translate(-50%, 14%); opacity: 0.28; clip-path: inset(0 0 14% 0); pointer-events: none; }
  .in-hero__woman { position: relative; width: 460px; max-width: 100%; height: auto; }

  .cs-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px 32px; margin-top: 32px; }
  .cs-btn,
  .cs-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    border-radius: 999px;
    font-family: var(--font);
    font-size: var(--fs-body);
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-btn { background: var(--wine); color: var(--white); }
  .cs-btn:hover { background: var(--graphite); }
  .cs-phone { display: grid; text-decoration: none; line-height: 1.2; }
  .cs-phone__label { font-size: var(--fs-small); color: var(--muted); }
  .cs-phone__num { font-family: var(--font); font-size: var(--fs-h3); letter-spacing: 0.5px; }
  .cs-phone:hover .cs-phone__num { color: var(--wine); }

  .cs-benefits { border-top: 1px solid var(--line); }
  .cs-benefits__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0 auto;
    padding-top: 32px;
    padding-bottom: 36px;
    list-style: none;
  }
  .cs-benefits__list li { display: flex; gap: 10px; font-size: var(--fs-small); line-height: 1.45; }
  .cs-benefits__list img { flex: none; margin-top: 5px; }
  .cs-benefits__list strong { display: block; font-family: var(--font); font-size: var(--fs-body); font-weight: var(--w-regular); }
  .cs-benefits__list span { color: var(--muted); }

  /* ---------- О направлении ---------- */
  .cs-intro { padding-top: 88px; }
  .cs-intro > * { max-width: 820px; }
  .cs-intro__text { margin-top: 24px; }

  /* ---------- Подбор по задаче ---------- */
  .cs-nav { padding-top: 72px; padding-bottom: 72px; }
  .cs-nav__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-nav__item { display: flex; flex-direction: column; gap: 14px; padding: 28px 28px 24px; background: var(--ivory); }
  .cs-nav__item h3 { font-size: var(--fs-h3); line-height: 1.2; font-weight: var(--w-light); }
  .cs-nav__item ul { display: flex; flex-wrap: wrap; gap: 8px; margin: auto 0 0; padding: 0; list-style: none; }
  .cs-nav__item a {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--wine);
    border-radius: 999px;
    font-size: var(--fs-small);
    color: var(--wine);
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .cs-nav__item a:hover { background: var(--wine); color: var(--white); }

  /* ---------- Каталог ---------- */
  .cs-devices { padding-bottom: 80px; }
  .cs-devices__lead { margin-top: 16px; max-width: 640px; color: var(--muted); }
  .cs-devices__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .cs-card { display: flex; flex-direction: column; padding: 36px; border: 1px solid var(--line); scroll-margin-top: 90px; }
