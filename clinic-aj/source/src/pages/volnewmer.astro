---
// Страница /volnewmer — новый дизайн в стиле главной (первый экран Hero.astro от 16.10).
// Тексты — со страницы Тильды, проверены по фактам (analysis/volnewmer-fact-check.md). Где фактов нет — заглушки [в квадратных скобках].
// Копия страницы с Тильды для сравнения — volnewmer-tilda.astro (/volnewmer-tilda).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contacts from '../components/Contacts.astro';
import Footer from '../components/Footer.astro';
import Directions from '../components/Directions.astro';
import { site } from '../data/site';
import { img, type ImageKey } from '../data/images';

const benefits = [
  { title: 'Без операции', text: 'Лифтинг-эффект без разрезов, наркоза и длительной реабилитации.' },
  { title: 'Комфортно', text: 'Насадка с водяным охлаждением защищает поверхность кожи. Обычно обходятся без обезболивания.' },
  { title: 'Минимум восстановления', text: 'Можно сразу вернуться к обычным делам. Лёгкое покраснение проходит само.' },
  { title: 'Разные зоны', text: 'Лицо и шея, а также [какие зоны тела делают в A&J — уточнить].' },
];
const problems = [
  'Снижение упругости кожи лица и шеи',
  'Нечеткий овал лица',
  'Возрастное провисание тканей',
  'Морщины и складки',
  'Дряблость кожи',
  'Возрастные изменения в области подбородка и шеи',
  'Потеря тонуса кожи после похудения',
];
const results = [
  'Более четкий контур лица',
  'Подтянутая и упругая кожа',
  'Менее выраженные морщины',
  'Более плотная и качественная кожа',
  'Свежий и молодой внешний вид',
];
const steps = [
  { title: 'Консультация', text: 'Врач-косметолог оценивает состояние кожи и подбирает параметры воздействия.' },
  { title: 'Процедура', text: 'Специалист обрабатывает выбранную зону насадкой аппарата. Вы чувствуете тепло, кожу защищает охлаждение.' },
  { title: 'После', text: 'Можно сразу вернуться к обычным делам. Возможны лёгкое покраснение и отёк, они проходят за несколько часов или дней.' },
];
const indications = [
  'Возрастные изменения кожи',
  'Снижение тургора и эластичности',
  'Появление морщин',
  'Нечеткий овал лица',
  'Дряблость кожи лица и шеи',
  'Профилактика возрастных изменений',
];
const contraindications = [
  'Беременность и период лактации',
  'Онкологические заболевания',
  'Острые инфекционные заболевания',
  'Кардиостимулятор и некоторые металлические импланты',
  'Воспалительные процессы в зоне воздействия',
];
const photos: { key: ImageKey; alt: string }[] = [
  { key: 'vol2', alt: 'Насадка Volnewmer на линии подбородка' },
  { key: 'vol3', alt: 'Экран аппарата Volnewmer' },
  { key: 'vol4', alt: 'Аппарат Volnewmer в кабинете клиники' },
  { key: 'vol5', alt: 'Процедура Volnewmer в клинике A&J' },
];
---
<Base
  title="RF-лифтинг Volnewmer в Мурманске | Клиника эстетической косметологии A&J"
  description="Volnewmer — RF-лифтинг нового поколения: подтяжка и уплотнение кожи без операции. Теперь в клинике A&J в Мурманске."
>
  <section class="vr-hero">
    <Header />

    <div class="container vr-hero__top">
      <div class="vr-hero__text">
        <nav class="vr-crumbs" aria-label="Хлебные крошки">
          <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/cosmetology">Аппаратная косметология</a>
        </nav>
        <p class="vr-eyebrow">Теперь в&nbsp;A&amp;J</p>
        <h1 class="vr-hero__title">RF-лифтинг Volnewmer <span>подтяжка кожи без&nbsp;операции</span></h1>
        <p class="vr-hero__lead">Радиочастотная энергия прогревает глубокие слои кожи и&nbsp;запускает выработку коллагена и&nbsp;эластина. Кожа становится плотнее, подтянутее и&nbsp;выглядит заметно моложе.</p>

        <div class="vr-actions">
          <a class="vr-btn" href="#contact">Записаться на консультацию</a>
          <a class="vr-phone" href={site.phone.href}>
            <span class="vr-phone__label">или позвоните</span>
            <span class="vr-phone__num">{site.phone.display}</span>
          </a>
        </div>
      </div>

      <div class="vr-hero__visual" aria-hidden="true">
        <img class="vr-hero__letters" src={img('heroLetters')} alt="" width="1200" height="608" />
        <img class="vr-hero__woman" src={img('promoWoman')} alt="" width="700" height="700" fetchpriority="high" />
        <img class="vr-hero__device" src={img('promoDevice')} alt="" width="800" height="800" />
      </div>
    </div>

    <div class="vr-benefits">
      <ul class="container vr-benefits__list">
        {benefits.map((b) => (
          <li>
            <img src={img('star')} alt="" width="15" height="15" />
            <div><strong>{b.title}</strong><span>{b.text}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <main>
    <!-- Что такое Volnewmer -->
    <section class="vr-about">
      <div class="container vr-about__grid">
        <div>
          <p class="vr-eyebrow">О процедуре</p>
          <h2 class="vr-title">Что такое Volnewmer</h2>
        </div>
        <div>
          <p class="vr-about__p vr-about__p--lead"><strong>Volnewmer (Волньюмер)</strong> — современная технология радиочастотного лифтинга (RF-лифтинга), которая помогает улучшить качество кожи, повысить её упругость и&nbsp;добиться выраженного эффекта подтяжки без хирургического вмешательства и&nbsp;длительного восстановления.</p>
          <p class="vr-about__p">Это оригинальный аппарат корейской компании Classys с&nbsp;монополярным RF. Во время процедуры контролируемая радиочастотная энергия прогревает глубокие слои кожи, стимулируя естественную выработку коллагена и&nbsp;эластина.</p>
          <p class="vr-about__reg">Аппарат радиочастотный терапевтический VOLNEWMER, модель VM1-M100, производитель Classys Inc. (Республика Корея). Регистрационное удостоверение Росздравнадзора №&nbsp;РЗН&nbsp;2024/23175 от&nbsp;24&nbsp;июля 2024&nbsp;года.</p>
        </div>
      </div>
    </section>

    <!-- Какие задачи решает -->
    <section class="vr-problems">
      <div class="container">
        <h2 class="section-title vr-problems__title">Какие проблемы помогает решить</h2>
        <ol class="vr-problems__list">
          {problems.map((p, i) => (
            <li><span class="vr-problems__num">{String(i + 1).padStart(2, '0')}</span>{p}</li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Результат -->
    <section class="vr-results">
      <div class="container vr-results__inner">
        <div>
          <h2 class="vr-results__title">Результат курса</h2>
          <p class="vr-results__note">Эффект нарастает постепенно по&nbsp;мере выработки нового коллагена и&nbsp;может сохраняться длительное время.</p>
        </div>
        <ul class="vr-results__list">
          {results.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>

    <!-- Как проходит -->
    <section class="container vr-steps">
      <h2 class="section-title">Как проходит процедура</h2>
      <ol class="vr-steps__list">
        {steps.map((s, i) => (
          <li>
            <span class="vr-steps__num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Фото -->
    <section class="vr-photos" aria-label="Фото процедуры Volnewmer">
      <ul class="container vr-photos__list">
        {photos.map((p) => <li><img src={img(p.key)} alt={p.alt} width="600" height="800" loading="lazy" /></li>)}
      </ul>
    </section>

    <!-- Показания и противопоказания -->
    <section class="container vr-med">
      <div class="vr-med__card">
        <h2>Показания</h2>
        <ul>{indications.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="vr-med__card vr-med__card--alt">
        <h2>Противопоказания</h2>
        <ul>{contraindications.map((t) => <li>{t}</li>)}</ul>
        <p>Точный перечень противопоказаний определяется врачом на&nbsp;консультации.</p>
      </div>
    </section>

    <Directions />

    <!-- Запись -->
    <section class="vr-cta">
      <div class="container vr-cta__inner">
        <div>
          <h2 class="vr-cta__title">Запишитесь на&nbsp;консультацию</h2>
          <p class="vr-cta__sub">Врач оценит состояние кожи и&nbsp;подскажет, подходит ли вам Volnewmer.</p>
          <p class="vr-cta__warn">Имеются противопоказания. Необходима консультация специалиста.</p>
        </div>
        <a class="vr-cta__btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
      </div>
    </section>

    <Contacts />
  </main>
  <Footer />
</Base>

<style>
  /* Размеры шрифта — только из общей шкалы --fs-* (styles/global.css), 5 размеров */

  /* Общие элементы — как на первом экране главной */
  .vr-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: var(--w-regular);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wine);
  }
  .vr-eyebrow::before { content: ''; width: 40px; height: 1px; background: currentColor; }
  .vr-title { margin-top: 20px; font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }

  /* ---------- Первый экран ---------- */
  .vr-hero { position: relative; overflow: hidden; background: var(--white); }
  .vr-hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 40px;
    min-height: 600px;
  }
  .vr-hero__text { position: relative; z-index: 2; padding: 40px 0 64px; }
  .vr-crumbs { display: flex; gap: 10px; margin-bottom: 36px; font-size: var(--fs-small); color: var(--muted); }
  .vr-crumbs a { text-decoration: none; }
  .vr-crumbs a:hover { color: var(--wine); }
  .vr-hero__title { margin-top: 28px; font-size: var(--fs-h1); line-height: 1.12; font-weight: var(--w-thin); }
  .vr-hero__title span { display: block; color: var(--wine); font-size: var(--fs-h2); line-height: 1.25; margin-top: 8px; }
  .vr-hero__lead { margin-top: 28px; max-width: 460px; color: var(--muted); }

  .vr-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px 32px; margin-top: 40px; }
  .vr-btn,
  .vr-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    border-radius: 999px;
    font-family: var(--font);
    font-size: var(--fs-body);
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
  }
  .vr-btn { background: var(--wine); color: var(--white); }
  .vr-btn:hover { background: var(--graphite); }
  .vr-phone { display: grid; text-decoration: none; line-height: 1.2; }
  .vr-phone__label { font-size: var(--fs-small); color: var(--muted); }
  .vr-phone__num { font-family: var(--font); font-size: var(--fs-h3); letter-spacing: 0.5px; }
  .vr-phone:hover .vr-phone__num { color: var(--wine); }

  /* Девушка и аппарат на фоне большого логотипа A&J — как врачи на главной */
  .vr-hero__visual { position: relative; z-index: 1; }
  .vr-hero__visual img { position: absolute; bottom: 0; max-width: none; }
  .vr-hero__letters { left: 50%; width: 1000px; transform: translateX(-50%); }
  .vr-hero__woman { left: 0; width: 360px; }
  .vr-hero__device { right: 0; width: 260px; }

  .vr-benefits { border-top: 1px solid var(--line); }
  .vr-benefits__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin: 0 auto;
    padding-top: 32px;
    padding-bottom: 36px;
    list-style: none;
  }
  .vr-benefits__list li { display: flex; gap: 10px; font-size: var(--fs-small); line-height: 1.45; }
  .vr-benefits__list img { flex: none; margin-top: 5px; }
  .vr-benefits__list strong { display: block; font-family: var(--font); font-size: var(--fs-body); font-weight: var(--w-regular); }
  .vr-benefits__list span { color: var(--muted); }

  /* ---------- Что такое Volnewmer ---------- */
  .vr-about { background: var(--ivory); padding: 88px 0; }
  .vr-about__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 64px; align-items: start; }
  .vr-about__p { margin-top: 24px; }
  .vr-about__p--lead { margin-top: 0; font-size: var(--fs-h3); line-height: 1.5; }
  .vr-about__p strong { font-weight: var(--w-medium); }
  .vr-about__reg { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); font-size: var(--fs-small); color: var(--muted); }

  /* ---------- Проблемы ---------- */
  .vr-problems { padding: 88px 0 72px; }
  .vr-problems__title { --title-line: var(--line); }
  .vr-problems__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 64px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .vr-problems__list li {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font);
    font-size: var(--fs-h3);
    font-weight: var(--w-thin);
  }
  .vr-problems__num { flex: none; font-size: var(--fs-small); color: var(--wine); letter-spacing: 1px; }

  /* ---------- Результат (винная полоса) ---------- */
  .vr-results { background: var(--wine); color: var(--white); }
  .vr-results__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 64px;
    padding-top: 72px;
    padding-bottom: 72px;
  }
  .vr-results__title { font-size: var(--fs-h2); line-height: 1.15; font-weight: var(--w-thin); }
  .vr-results__note { margin-top: 20px; max-width: 380px; color: rgba(255, 255, 255, 0.85); }
  .vr-results__list { margin: 0; padding: 0; list-style: none; }
  .vr-results__list li {
    padding: 16px 0 16px 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    background: url('/images/star.svg') 0 22px / 15px no-repeat;
    font-family: var(--font);
    font-size: var(--fs-h3);
    font-weight: var(--w-thin);
  }
  .vr-results__list li:first-child { padding-top: 0; background-position: 0 6px; }

  /* ---------- Шаги ---------- */
  .vr-steps { padding-top: 88px; padding-bottom: 72px; }
  .vr-steps__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin: 40px 0 0; padding: 0; list-style: none; }
  .vr-steps__num {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--wine);
    border-radius: 50%;
    color: var(--wine);
    font-family: var(--font);
    font-size: var(--fs-body);
  }
  .vr-steps__list h3 { margin-top: 20px; font-size: var(--fs-h3); }
  .vr-steps__list p { margin-top: 10px; color: var(--muted); }

  /* ---------- Фото ---------- */
  .vr-photos__list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin: 0 auto; list-style: none; }
  .vr-photos__list img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }

  /* ---------- Показания / противопоказания ---------- */
  .vr-med { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-top: 88px; padding-bottom: 88px; }
  .vr-med__card { padding: 40px; background: var(--ivory); }
  .vr-med__card--alt { background: var(--white); border: 1px solid var(--line); }
  .vr-med__card h2 { font-size: var(--fs-h3); }
  .vr-med__card ul { margin: 20px 0 0; padding-left: 20px; }
  .vr-med__card li { padding: 4px 0; }
  .vr-med__card li::marker { color: var(--wine); }
  .vr-med__card p { margin-top: 16px; font-size: var(--fs-small); color: var(--muted); }


  /* ---------- Запись (тёмная полоса) ---------- */
  .vr-cta { background: var(--graphite); color: var(--ivory); margin-bottom: 80px; }
  .vr-cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 40px; padding-top: 48px; padding-bottom: 52px; }
  .vr-cta__title { font-size: var(--fs-h2); line-height: 1.15; }
  .vr-cta__sub { margin-top: 10px; color: rgba(241, 234, 224, 0.8); }
  .vr-cta__warn { margin-top: 8px; font-size: var(--fs-small); letter-spacing: 0.5px; text-transform: uppercase; color: rgba(241, 234, 224, 0.6); }
  .vr-cta__btn { background: var(--ivory); color: var(--graphite); }
  .vr-cta__btn:hover { background: var(--wine); color: var(--white); }

  /* ---------- Планшет ---------- */
  @media (max-width: 1199px) {
    .vr-hero__letters { width: 820px; }
    .vr-hero__woman { width: 300px; }
    .vr-hero__device { width: 210px; }
    .vr-benefits__list { grid-template-columns: 1fr 1fr; }
  }

  /* ---------- Мобильный ---------- */
  @media (max-width: 959px) {
    .vr-hero__top { grid-template-columns: 1fr; gap: 0; min-height: 0; }
    .vr-hero__text { padding: 24px 0 0; }
    .vr-crumbs { margin-bottom: 24px; }
    .vr-eyebrow { letter-spacing: 1.5px; }
    .vr-hero__title { margin-top: 18px; font-size: var(--fs-h1); }
    main :global(.section-title) { font-size: var(--fs-h2); line-height: 1.25; }
    .vr-btn { width: 100%; }
    .vr-hero__visual { height: 340px; margin-top: 32px; }
    .vr-hero__letters { width: 640px; }
    .vr-hero__woman { width: 250px; left: -10px; }
    .vr-hero__device { width: 170px; right: -10px; }
    .vr-benefits__list { grid-template-columns: 1fr; gap: 18px; }
    .vr-about, .vr-problems { padding: 60px 0; }
    .vr-about__grid, .vr-results__inner, .vr-med { grid-template-columns: 1fr; gap: 32px; }
    .vr-problems__list { grid-template-columns: 1fr; }
    .vr-results__inner { padding-top: 56px; padding-bottom: 56px; }
    .vr-steps { padding-top: 60px; padding-bottom: 56px; }
    .vr-steps__list { grid-template-columns: 1fr; gap: 28px; }
    .vr-photos__list { grid-template-columns: 1fr 1fr; gap: 10px; }
    .vr-med { padding-top: 60px; padding-bottom: 60px; }
    .vr-med__card { padding: 28px 22px; }
    .vr-cta__btn { width: 100%; }
  }
</style>
