---
import { img, type ImageKey } from '../data/images';

// Фото филиала на Карла Либкнехта, 28 — показываются как «сторис».
// Чтобы добавить фото: положите webp в public/images, впишите его в images.ts и сюда.
const photos: { key: ImageKey; alt: string }[] = [
  { key: 'clinicLounge', alt: 'Зона ожидания с зеркалами' },
  { key: 'clinicLogo', alt: 'Логотип A&J и цветы на ресепшене' },
  { key: 'clinicVolnewmer', alt: 'Аппарат Volnewmer в кабинете' },
  { key: 'clinicWashbasins', alt: 'Раковины и подсветка' },
  { key: 'clinicTeam', alt: 'Администраторы на ресепшене' },
  { key: 'clinicBalloons', alt: 'Праздник в клинике A&J' },
  { key: 'clinicHall', alt: 'Холл клиники' },
  { key: 'clinicTerminal', alt: 'Ресепшен с логотипом A&J' },
];
---
<section class="stories" id="gallery" aria-labelledby="stories-title">
  <div class="container">
    <div class="stories__head">
      <div>
        <h2 class="stories__title" id="stories-title">Клиника, в&nbsp;которую хочется возвращаться</h2>
        <p class="stories__caption">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          Фотографии филиала на&nbsp;ул.&nbsp;Карла Либкнехта,&nbsp;28
        </p>
      </div>
      <div class="stories__nav">
        <button class="stories__btn" type="button" data-prev aria-label="Предыдущее фото">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button class="stories__btn" type="button" data-next aria-label="Следующее фото">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <div class="stories__progress" aria-hidden="true">
      {photos.map(() => <span class="stories__seg"><span class="stories__fill"></span></span>)}
    </div>
  </div>

  <div class="stories__viewport" tabindex="0" role="region" aria-roledescription="карусель" aria-label="Фото клиники, листайте влево и вправо" data-viewport>
    <ul class="stories__track" data-track>
      {photos.map((p, i) => (
        <li class="story" data-index={i}>
          <img src={img(p.key)} alt={p.alt} width="640" height="1138" loading="lazy" draggable="false" />
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const AUTOPLAY_MS = 3500;   // как часто листается сама
  const RESUME_MS = 6000;     // через сколько продолжить после касания

  document.querySelectorAll<HTMLElement>('.stories').forEach((root) => {
    const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const segs = Array.from(root.querySelectorAll<HTMLElement>('.stories__seg'));
    const originals = Array.from(track.children) as HTMLElement[];
    const n = originals.length;
    if (!n) return;

    // Бесконечная лента: копии слева и справа, показываем среднюю.
    const makeClones = () => originals.map((li) => {
      const c = li.cloneNode(true) as HTMLElement;
      c.setAttribute('aria-hidden', 'true');
      c.querySelector('img')?.setAttribute('loading', 'eager');
      return c;
    });
    track.prepend(...makeClones());
    track.append(...makeClones());

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let step = 0;      // ширина карточки + отступ
    let setWidth = 0;  // ширина одного полного набора
    let current = -1;

    const measure = () => {
      const a = track.children[0] as HTMLElement;
      const b = track.children[1] as HTMLElement;
      step = b.offsetLeft - a.offsetLeft;
      setWidth = step * n;
    };
    const jumpTo = (left: number) => {
      viewport.style.scrollSnapType = 'none';
      viewport.scrollLeft = left;
      requestAnimationFrame(() => { viewport.style.scrollSnapType = ''; });
    };

    // Возвращаем в средний набор, если ушли в копии
    const recenter = () => {
      const x = viewport.scrollLeft;
      if (x < setWidth * 0.5) jumpTo(x + setWidth);
      else if (x >= setWidth * 1.5) jumpTo(x - setWidth);
    };

    const updateProgress = () => {
      const idx = ((Math.round(viewport.scrollLeft / step) % n) + n) % n;
      if (idx === current) return;
      current = idx;
      segs.forEach((s, i) => {
        s.classList.toggle('is-done', i < idx);
        s.classList.remove('is-active');
      });
      const seg = segs[idx];
      if (seg) { void seg.offsetWidth; seg.classList.add('is-active'); }
    };

    let scrollTimer = 0;
    viewport.addEventListener('scroll', () => {
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => { recenter(); updateProgress(); }, 120);
    }, { passive: true });

    // Автопрокрутка
    let timer = 0;
    let pausedUntil = 0;
    const next = (dir = 1) => viewport.scrollBy({ left: step * dir, behavior: reduceMotion ? 'auto' : 'smooth' });
    const tick = () => {
      if (Date.now() >= pausedUntil && !document.hidden && !dragging) next(1);
    };
    const start = () => {
      window.clearInterval(timer);
      if (!reduceMotion) timer = window.setInterval(tick, AUTOPLAY_MS);
      root.classList.toggle('is-static', reduceMotion);
    };
    const pause = () => { pausedUntil = Date.now() + RESUME_MS; root.classList.add('is-paused'); window.setTimeout(() => { if (Date.now() >= pausedUntil) root.classList.remove('is-paused'); }, RESUME_MS + 50); };

    root.querySelector('[data-prev]')!.addEventListener('click', () => { pause(); next(-1); });
    root.querySelector('[data-next]')!.addEventListener('click', () => { pause(); next(1); });
    viewport.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); pause(); next(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); pause(); next(-1); }
    });
    viewport.addEventListener('touchstart', pause, { passive: true });
    viewport.addEventListener('wheel', pause, { passive: true });

    // Перетаскивание мышью на компьютере (на телефоне свайп работает сам)
    let dragging = false, startX = 0, startLeft = 0, moved = false;
    viewport.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true; moved = false; startX = e.clientX; startLeft = viewport.scrollLeft;
      viewport.style.scrollSnapType = 'none';
      viewport.classList.add('is-dragging');
      viewport.setPointerCapture(e.pointerId);
      pause();
    });
    viewport.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      viewport.scrollLeft = startLeft - dx;
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      viewport.classList.remove('is-dragging');
      const target = Math.round(viewport.scrollLeft / step) * step;
      viewport.scrollTo({ left: target, behavior: 'smooth' });
      window.setTimeout(() => { viewport.style.scrollSnapType = ''; }, 400);
    };
    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);
    viewport.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);

    const init = () => { measure(); jumpTo(setWidth); current = -1; updateProgress(); };
    window.addEventListener('resize', () => {
      const idx = current < 0 ? 0 : current;
      measure(); jumpTo(setWidth + idx * step);
    });

    // Листаем только когда блок на экране
    const io = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) start(); else window.clearInterval(timer);
    }, { threshold: 0.3 });
    init();
    io.observe(root);
  });
</script>

<style>
  .stories { padding: 100px 0 110px; background: var(--white); overflow: hidden; }

  .stories__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
  }
  .stories__title {
    max-width: 680px;
    font-family: var(--font);
    font-weight: var(--w-thin);
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.08;
  }
  .stories__caption {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: 16px;
    color: var(--muted);
  }
  .stories__caption svg { color: var(--wine); flex: none; }

  .stories__nav { display: flex; gap: 10px; }
  .stories__btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--ink-2);
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .stories__btn:hover { background: var(--ink-2); color: var(--white); }

  /* Полоски прогресса, как в сторис */
  .stories__progress {
    display: flex;
    gap: 6px;
    margin-top: 36px;
  }
  .stories__seg {
    position: relative;
    flex: 1;
    height: 3px;
    border-radius: 3px;
    background: var(--line);
    overflow: hidden;
  }
  .stories__fill {
    position: absolute;
    inset: 0;
    background: var(--wine);
    transform: scaleX(0);
    transform-origin: left;
  }
  .stories__seg.is-done .stories__fill { transform: scaleX(1); }
  .stories__seg.is-active .stories__fill { animation: story-fill 3.5s linear forwards; }
  .stories.is-paused .stories__seg.is-active .stories__fill,
  .stories.is-static .stories__seg.is-active .stories__fill { animation: none; transform: scaleX(1); }
  @keyframes story-fill { to { transform: scaleX(1); } }

  /* Лента */
  .stories__viewport {
    margin-top: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
    padding: 0 max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    scroll-padding: 0 max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
  }
  .stories__viewport::-webkit-scrollbar { display: none; }
  .stories__viewport.is-dragging { cursor: grabbing; }
  .stories__viewport:focus-visible { outline: 2px solid var(--wine); outline-offset: 4px; }

  .stories__track {
    display: flex;
    gap: 16px;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .story {
    position: relative;
    flex: none;
    width: 270px;
    aspect-ratio: 9 / 16;
    border-radius: 22px;
    overflow: hidden;
    background: var(--ivory);
    scroll-snap-align: start;
    user-select: none;
  }
  .story img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    transition: transform 0.6s ease;
  }
  .story:hover img { transform: scale(1.03); }

  @media (max-width: 959px) {
    .stories { padding: 64px 0 72px; }
    .stories__nav { display: none; }
    .stories__progress { margin-top: 24px; }
    .story { width: 62vw; max-width: 300px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .story img { transition: none; }
  }
</style>
