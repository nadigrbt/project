---
// Блок «Отзывы» — лучшие отзывы на 5 звёзд с Яндекс Карт, переключатель по филиалам.
// Стоит только на главной, под картой (вставляется внутрь «Контактов»).
// Тексты отзывов — в src/data/reviews.ts.
import { site, branchUrl } from '../data/site';
import { reviews } from '../data/reviews';

const groups = reviews
  .filter((g) => g.reviews.length && site.branches[g.branch])
  .map((g) => {
    const b = site.branches[g.branch];
    // ссылка на вкладку отзывов карточки филиала, если есть карточка
    const all = b.yandex ? b.yandex.replace(/\/?$/, '/') + 'reviews/' : branchUrl(b);
    // ссылки «Все отзывы на …»: Яндекс и 2ГИС — свои у филиала, ПроДокторов — общая страница сети
    const links = [
      { label: 'Яндекс Картах', href: all },
      ...(b.twogis ? [{ label: '2ГИС', href: b.twogis }] : []),
      ...(site.prodoctorovUrl ? [{ label: 'ПроДокторов', href: site.prodoctorovUrl }] : []),
    ];
    return { ...g, address: b.address.replace(/^Мурманск,\s*/, ''), links };
  });
const star = 'M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z';
---
{groups.length > 0 && (
<div class="reviews" id="reviews" data-reviews>
  <h2 class="section-title reviews__title">Отзывы</h2>

  <div class="reviews__head">
    <p class="reviews__sub">Отзывы наших пациентов на&nbsp;Яндекс Картах. Выберите филиал:</p>
    <div class="reviews__tabs" role="tablist" aria-label="Филиалы">
      {groups.map((g, i) => (
        <button class="reviews__tab" type="button" role="tab" id={`rv-tab-${i}`} aria-controls={`rv-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{g.tab}</button>
      ))}
    </div>
  </div>

  {groups.map((g, i) => (
    <div class="reviews__panel" role="tabpanel" id={`rv-panel-${i}`} aria-labelledby={`rv-tab-${i}`} hidden={i !== 0}>
      <div class="reviews__bar">
        <p class="reviews__addr">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          {g.address}
        </p>
        <div class="reviews__nav">
          <button class="reviews__btn" type="button" data-prev aria-label="Предыдущие отзывы">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <button class="reviews__btn" type="button" data-next aria-label="Следующие отзывы">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <ul class="reviews__track" data-track tabindex="0" aria-label={`Отзывы о филиале ${g.address}, листайте вправо`}>
        {g.reviews.map((r) => (
          <li class:list={['review', { 'review--stub': r.placeholder }]}>
            <div class="review__top">
              <span class="review__avatar" aria-hidden="true">{r.placeholder ? '?' : r.author.trim().charAt(0).toUpperCase()}</span>
              <div>
                <p class="review__author">{r.author}</p>
                <p class="review__date">{r.date}</p>
              </div>
            </div>
            <p class="review__stars" role="img" aria-label="Оценка 5 из 5">
              {[0, 1, 2, 3, 4].map(() => <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d={star} /></svg>)}
            </p>
            <p class="review__text" data-text>{r.text}</p>
            <button class="review__more" type="button" data-more hidden aria-expanded="false">Читать полностью</button>
          </li>
        ))}
      </ul>

      <ul class="reviews__links">
        {g.links.map((l) => (
          <li>
            <a class="arrow-link" href={l.href} target="_blank" rel="noopener">
              <span class="arrow-link__text">Все отзывы на&nbsp;{l.label}</span>
              <svg class="arrow-link__arrow" viewBox="0 0 50 6" aria-hidden="true"><path d="M0 3h48M45 0.5L49 3l-4 2.5" fill="none" stroke="currentColor" stroke-width="1"/></svg>
              <span class="visually-hidden"> (откроется в новом окне)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role=tabpanel]'));

    // «Читать полностью» — только у отзывов, которые не влезли в 7 строк
    const checkLong = (panel: HTMLElement) => panel.querySelectorAll<HTMLElement>('.review').forEach((card) => {
      const text = card.querySelector<HTMLElement>('[data-text]')!;
      const more = card.querySelector<HTMLButtonElement>('[data-more]')!;
      if (card.classList.contains('is-open')) return;
      more.hidden = text.scrollHeight <= text.clientHeight + 2;
    });

    // Стрелки листают ленту на одну карточку; гаснут на краях
    const setupNav = (panel: HTMLElement) => {
      const track = panel.querySelector<HTMLElement>('[data-track]')!;
      const prev = panel.querySelector<HTMLButtonElement>('[data-prev]')!;
      const next = panel.querySelector<HTMLButtonElement>('[data-next]')!;
      const step = () => (track.firstElementChild as HTMLElement | null)?.offsetWidth ?? track.clientWidth;
      const gap = () => parseFloat(getComputedStyle(track).columnGap) || 0;
      const update = () => {
        const max = track.scrollWidth - track.clientWidth;
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= max - 2;
        panel.querySelector<HTMLElement>('.reviews__nav')!.hidden = max <= 2;
      };
      prev.addEventListener('click', () => track.scrollBy({ left: -(step() + gap()), behavior: 'smooth' }));
      next.addEventListener('click', () => track.scrollBy({ left: step() + gap(), behavior: 'smooth' }));
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', () => { update(); checkLong(panel); });
      return update;
    };
    const updaters = panels.map(setupNav);

    root.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((btn) => btn.addEventListener('click', () => {
      const card = btn.closest('.review')!;
      const open = card.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Свернуть' : 'Читать полностью';
    }));

    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
      });
      if (focus) tabs[i].focus();
      updaters[i]();
      checkLong(panels[i]);
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k === 'ArrowRight' || k === 'ArrowLeft' || k === 'Home' || k === 'End') {
          e.preventDefault();
          const n = tabs.length;
          select(k === 'Home' ? 0 : k === 'End' ? n - 1 : (i + (k === 'ArrowRight' ? 1 : -1) + n) % n, true);
        }
      });
    });
    select(0);
  });
</script>

<style>
  .reviews { margin-top: 84px; }

  .reviews__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
    margin-top: 16px;
  }
  .reviews__sub { max-width: 440px; }

  /* Переключатель филиалов — «пилюли», выбранная залита графитом */
  .reviews__tabs { display: flex; flex-wrap: wrap; gap: 10px; }
  .reviews__tab {
    height: 44px;
    padding: 0 22px;
    border: 1px solid var(--ink);
    border-radius: 30px;
    background: transparent;
    color: var(--ink);
    font-family: var(--font);
    font-size: var(--fs-small);
    font-weight: var(--w-regular);
    letter-spacing: normal;
    cursor: pointer;
    transition: background-color .2s, color .2s;
  }
  .reviews__tab:hover { background: var(--ivory); }
  .reviews__tab[aria-selected='true'] { background: var(--ink); color: var(--white); }

  .reviews__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 36px;
    min-height: 52px;
  }
  .reviews__addr { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: var(--fs-small); }
  .reviews__addr svg { flex: none; }
  .reviews__nav { display: flex; gap: 12px; }
  .reviews__nav[hidden] { display: none; }
  .reviews__btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color .2s, color .2s, opacity .2s;
  }
  .reviews__btn:hover:not(:disabled) { background: var(--ink); color: var(--white); }
  .reviews__btn:disabled { opacity: .3; cursor: default; }

  /* Лента карточек: по 3 на компьютере, листается стрелками или свайпом */
  .reviews__track {
    --per: 3;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--per) - 1) * 24px) / var(--per));
    gap: 24px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .reviews__track::-webkit-scrollbar { display: none; }

  .review {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px;
    border-radius: 24px;
    background: var(--ivory);
    scroll-snap-align: start;
  }
  .review__top { display: flex; align-items: center; gap: 14px; }
  .review__avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--wine);
    color: var(--white);
    font-family: var(--font);
    font-size: var(--fs-body);
    font-weight: var(--w-regular);
  }
  .review__author { font-family: var(--font); font-weight: var(--w-medium); letter-spacing: .3px; }
  .review__date { color: var(--muted); font-size: var(--fs-small); line-height: 20px; }
  .review__stars { display: flex; gap: 3px; color: var(--wine); }
  .review__stars svg { fill: currentColor; }
  .review__text {
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    white-space: pre-line; /* переносы строк как у автора на Яндексе */
  }
  .review.is-open .review__text { display: block; -webkit-line-clamp: none; }
  .review__more {
    align-self: flex-start;
    margin-top: auto;
    padding: 0 0 2px;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: none;
    color: var(--wine);
    font-family: var(--font);
    font-size: var(--fs-small);
    cursor: pointer;
  }
  .review__more[hidden] { display: none; }
  /* заглушки — пунктирная рамка, чтобы сразу было видно, что это не настоящий отзыв */
  .review--stub { outline: 1px dashed var(--wine); outline-offset: -1px; }

  .reviews__links { display: flex; flex-wrap: wrap; gap: 12px 48px; margin: 32px 0 0; padding: 0; list-style: none; }
  .reviews__links .arrow-link__arrow { color: var(--ink); }

  @media (max-width: 1199px) {
    .reviews__track { --per: 2; }
  }
  @media (max-width: 959px) {
    .reviews { margin-top: 70px; }
    .reviews .section-title { font-size: var(--fs-h2); font-weight: var(--w-light); }
    .reviews__head { gap: 20px; }
    .reviews__tab { padding: 0 16px; }
    .reviews__bar { margin-top: 28px; }
    .reviews__nav { display: none; } /* на телефоне листают пальцем */
    /* карточка чуть уже экрана — видно, что дальше есть ещё */
    .reviews__track { grid-auto-columns: 86%; gap: 12px; }
    .review { padding: 24px; border-radius: 16px; }
    .reviews__links { flex-direction: column; gap: 8px; }
  }
</style>
