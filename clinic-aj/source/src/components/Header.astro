---
import { mainNav, site } from '../data/site';
import { img } from '../data/images';
---
<header class="header container">
  <a class="header__logo" href="/" aria-label="A&J — на главную">
    <img src={img('logo')} alt="A&J — медицина, косметология" width="172" height="64" />
  </a>

  <nav class="header__nav" aria-label="Основное меню">
    {mainNav.map((l) => <a href={l.href}>{l.label}</a>)}
    <a class="header__cta" href="/#contact">Записаться</a>
  </nav>

  <a class="header__phone" href={site.phone.href}>{site.phone.display}</a>

  <button class="header__burger" type="button" aria-label="Открыть меню" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>
    <span></span><span></span><span></span>
  </button>
</header>

<style>
  .header {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    height: 66px;
  }
  .header__logo { flex: none; margin-left: 2px; }
  .header__logo img { width: 172px; height: 64px; object-fit: contain; }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 49px;
    margin-left: 138px;
    font-size: var(--fs-body);
    line-height: 18px;
    font-weight: var(--w-light);
  }
  .header__nav a { text-decoration: none; transition: opacity 0.2s; }
  .header__nav a:hover { opacity: 0.6; }
  .header__cta {
    padding-bottom: 4px;
    border-bottom: 1px solid var(--ink-2);
  }

  .header__phone {
    margin-left: auto;
    margin-right: 28px;
    font-weight: var(--w-medium);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__burger {
    display: none;
    position: relative;
    width: 30px;
    height: 24px;
    margin-left: auto;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .header__burger span {
    position: absolute;
    right: 0;
    height: 2px;
    width: 30px;
    background: var(--ink);
  }
  .header__burger span:nth-child(1) { top: 1px; }
  .header__burger span:nth-child(2) { top: 11px; }
  .header__burger span:nth-child(3) { top: 21px; width: 20px; }

  @media (max-width: 1199px) {
    .header__nav { margin-left: auto; gap: 40px; }
    .header__phone { display: none; }
  }
  @media (max-width: 959px) {
    .header__nav { display: none; }
    .header__burger { display: block; }
  }
</style>
