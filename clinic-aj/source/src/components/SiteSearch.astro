---
// Строка поиска по сайту (18.11). Стоит на первом экране главной, под кнопкой записи.
// Логика — public/search.js, индекс страниц собирается при сборке (integrations/search-index.mjs),
// ключи и синонимы — src/data/search.mjs.
import { site } from '../data/site';

interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<form class:list={['ssearch', cls]} role="search" data-site-search autocomplete="off" action="#">
  <label class="visually-hidden" for="site-search">Поиск по сайту</label>
  <div class="ssearch__field">
    <svg class="ssearch__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="M15.5 15.5L21 21" stroke-linecap="round" />
    </svg>
    <input
      id="site-search"
      class="ssearch__input"
      type="search"
      enterkeyhint="search"
      placeholder="Найти процедуру, аппарат или врача"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="site-search-list"
      data-search-input
    />
    <button class="ssearch__clear" type="button" aria-label="Очистить поиск" hidden data-search-clear>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke-linecap="round" /></svg>
    </button>
  </div>

  <div class="ssearch__panel" hidden data-search-panel>
    <div class="ssearch__hint" hidden data-search-hint>
      <p class="ssearch__label">Часто ищут</p>
      <ul class="ssearch__chips" data-search-popular></ul>
    </div>
    <ul class="ssearch__list" id="site-search-list" role="listbox" aria-label="Результаты поиска" data-search-list></ul>
    <div class="ssearch__empty" hidden data-search-empty>
      <p>По запросу «<span data-search-empty-q></span>» ничего не нашли.</p>
      <p>Позвоните <a href={site.phone.href}>{site.phone.display}</a> или <a href={site.bookingUrl} target="_blank" rel="noopener">запишитесь онлайн</a>: администратор подскажет процедуру.</p>
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" data-search-status></p>
</form>
<script is:inline src="/search.js?v=3" defer></script>

<style is:global>
  .ssearch { position: relative; width: 100%; max-width: 560px; z-index: 30; }

  .ssearch__field { position: relative; display: flex; align-items: center; }
  .ssearch__icon {
    position: absolute;
    left: 22px;
    color: var(--muted);
    pointer-events: none;
  }
  .ssearch__input {
    width: 100%;
    height: 56px;
    padding: 0 52px 0 54px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--graphite);
    font-family: var(--font-text);
    font-size: var(--fs-body);
    font-weight: var(--w-light);
    appearance: none;
    -webkit-appearance: none;
    transition: border-color 0.2s;
  }
  .ssearch__input::placeholder { color: var(--muted); opacity: 1; }
  .ssearch__input::-webkit-search-cancel-button { display: none; }
  .ssearch__input:hover { border-color: var(--graphite); }
  /* Фокус — винная рамка в 2 px (вместо обычного контура браузера) */
  .ssearch__input:focus,
  .ssearch__input:focus-visible { outline: none; border-color: var(--wine); box-shadow: inset 0 0 0 1px var(--wine); }

  .ssearch__clear {
    position: absolute;
    right: 10px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .ssearch__clear:hover { background: var(--ivory); color: var(--graphite); }
  .ssearch__clear[hidden] { display: none; }

  .ssearch__panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    max-height: min(440px, 60vh);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--white);
    box-shadow: 0 16px 40px rgba(38, 35, 35, 0.12);
  }
  .ssearch__panel[hidden] { display: none; }

  .ssearch__list { list-style: none; margin: 0; padding: 0; }
  .ssearch__list:empty { display: none; }
  .ssearch__item {
    display: grid;
    gap: 2px;
    padding: 10px 16px;
    border-radius: 16px;
    text-decoration: none;
    color: var(--graphite);
  }
  [aria-selected="true"] > .ssearch__item { background: var(--ivory); }
  .ssearch__section {
    font-family: var(--font);
    font-size: var(--fs-small);
    line-height: 1.3;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--wine);
  }
  .ssearch__title {
    font-family: var(--font);
    font-size: var(--fs-body);
    line-height: 1.35;
    font-weight: var(--w-regular);
  }
  .ssearch__title mark { background: none; color: var(--wine); }
  .ssearch__sub { font-weight: var(--w-light); color: var(--muted); }

  .ssearch__hint { padding: 10px 12px 12px; }
  .ssearch__hint[hidden] { display: none; }
  .ssearch__label {
    font-family: var(--font);
    font-size: var(--fs-small);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ssearch__chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 0; padding: 0; }
  .ssearch__chips .ssearch__chip {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font);
    font-size: var(--fs-small);
    text-decoration: none;
    color: var(--graphite);
    transition: border-color 0.2s, color 0.2s;
  }
  .ssearch__chips .ssearch__chip:hover { border-color: var(--wine); color: var(--wine); }

  .ssearch__empty { display: grid; gap: 6px; padding: 12px 16px; font-size: var(--fs-small); line-height: 1.5; color: var(--muted); }
  .ssearch__empty[hidden] { display: none; }
  .ssearch__empty a { color: var(--wine); }

  @media (max-width: 959px) {
    .ssearch { max-width: none; }
    .ssearch__panel { max-height: min(380px, 55vh); }
  }
</style>
