---
import Header from './Header.astro';
import Socials from './Socials.astro';
import { site } from '../data/site';
import { img } from '../data/images';

const benefits = [
  '> 30 видов услуг',
  'Ведущие специалисты в&nbsp;области косметологии',
  'Современное проф. оборудование',
  'Индивидуальный подход для&nbsp;каждого пациента',
];
const links = [
  { label: 'Контакты', href: '#contact' },
  { label: 'Блог', href: '/blog' },
];
---
<section class="hero">
  <Header />

  <div class="hero__top container">
    <div class="hero__text">
      <p class="hero__eyebrow">Медицина и&nbsp;косметология · Мурманск</p>
      <h1 class="hero__title">Клиника эстетической косметологии <span class="hero__city">в&nbsp;Мурманске</span></h1>
      <p class="hero__lead">Клиника с медицинской лицензией. Высококвалифицированные специалисты и&nbsp;сертифицированное оборудование.</p>

      <div class="hero__actions">
        <a class="hero__btn" href={site.bookingUrl} target="_blank" rel="noopener">Записаться онлайн</a>
        <a class="hero__phone" href={site.phone.href}>
          <span class="hero__phone-label">или позвоните</span>
          <span class="hero__phone-num">{site.phone.display}</span>
        </a>
      </div>

      <ul class="hero__benefits">
        {benefits.map((b) => (
          <li><img src={img('star')} alt="" width="15" height="15" /><span set:html={b} /></li>
        ))}
      </ul>
    </div>

    <div class="hero__visual">
      <img class="hero__letters" src={img('heroLetters')} alt="" aria-hidden="true" width="1200" height="608" />
      <img class="hero__doctors" src={img('heroDoctors')} alt="Специалисты клиники A&J" width="600" height="838" fetchpriority="high" />
    </div>
  </div>

  <div class="hero__band">
    <div class="container hero__band-inner">
      <div class="hero__links">
        {links.map((l) => (
          <a class="arrow-link" href={l.href}>
            <span class="arrow-link__text">{l.label}</span>
            <img class="arrow-link__arrow" src={img('arrow')} alt="" width="50" height="6" />
          </a>
        ))}
        <p class="hero__blog-note">В блоге отвечаем на&nbsp;ваши популярные вопросы</p>
      </div>
      <Socials class="hero__socials" size={36} gap={24} />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; background: var(--white); overflow: hidden; }

  /* ---------- Первый экран: текст слева, врачи справа ---------- */
  .hero__top {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 40px;
    min-height: 640px;
  }
  .hero__text {
    position: relative;
    z-index: 2;
    padding: 64px 0 56px;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font);
    font-size: 13px;
    font-weight: var(--w-regular);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--wine);
  }
  .hero__eyebrow::before {
    content: '';
    width: 40px;
    height: 1px;
    background: currentColor;
  }

  .hero__title {
    margin-top: 28px;
    font-size: 58px;
    line-height: 1.12;
    font-weight: var(--w-thin);
    letter-spacing: 0;
  }
  .hero__city { display: block; color: var(--wine); }

  .hero__lead {
    margin-top: 28px;
    max-width: 440px;
    font-size: var(--text);
    line-height: var(--lh);
    color: var(--muted);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px 32px;
    margin-top: 40px;
  }
  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 36px;
    border-radius: 999px;
    background: var(--wine);
    color: var(--white);
    font-family: var(--font);
    font-size: 16px;
    font-weight: var(--w-regular);
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .hero__btn:hover { background: var(--graphite); }

  .hero__phone {
    display: grid;
    text-decoration: none;
    line-height: 1.2;
  }
  .hero__phone-label { font-size: 13px; color: var(--muted); }
  .hero__phone-num {
    font-family: var(--font);
    font-size: 24px;
    font-weight: var(--w-regular);
    letter-spacing: 0.5px;
  }
  .hero__phone:hover .hero__phone-num { color: var(--wine); }

  .hero__benefits {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 32px;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.4;
  }
  .hero__benefits li { display: flex; align-items: flex-start; gap: 10px; }
  .hero__benefits li img { flex: none; margin-top: 4px; }

  /* Логотип A&J за врачами */
  .hero__visual { position: relative; z-index: 1; }
  .hero__letters,
  .hero__doctors { position: absolute; bottom: 0; max-width: none; }
  .hero__letters {
    left: 50%;
    width: 1040px;
    transform: translateX(-50%);
  }
  .hero__doctors {
    left: 50%;
    width: 420px;
    transform: translateX(-44%);
  }

  /* ---------- Полоса со ссылками ---------- */
  .hero__band { border-top: 1px solid var(--line); }
  .hero__band-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    padding-top: 28px;
    padding-bottom: 28px;
  }
  .hero__links { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 40px; }
  .hero__blog-note { font-size: 15px; line-height: 1.4; color: var(--muted); max-width: 260px; }

  /* ---------- Планшет ---------- */
  @media (max-width: 1199px) {
    .hero__title { font-size: 46px; }
    .hero__letters { width: 860px; }
    .hero__doctors { width: 360px; }
  }

  /* ---------- Мобильный ---------- */
  @media (max-width: 959px) {
    .hero__top { grid-template-columns: 1fr; gap: 0; min-height: 0; }
    .hero__text { display: contents; }
    .hero__eyebrow { margin-top: 36px; font-size: 11px; letter-spacing: 1.5px; }
    .hero__eyebrow::before { display: none; }
    .hero__title { margin-top: 20px; font-size: 36px; }
    .hero__lead { margin-top: 20px; }
    .hero__actions { margin-top: 28px; }
    .hero__btn { width: 100%; }
    .hero__visual { order: 1; height: 400px; margin-top: 36px; }
    .hero__letters { width: 700px; }
    .hero__doctors { width: 280px; }
    .hero__benefits { order: 2; margin: 0 0 40px; padding-top: 28px; border-top: 1px solid var(--line); gap: 18px 20px; font-size: 15px; }
    /* На телефоне — только «Ведущие специалисты» и «Индивидуальный подход» */
    .hero__benefits li:nth-child(1),
    .hero__benefits li:nth-child(3) { display: none; }

    .hero__band { border-top: 0; }

    .hero__band-inner { flex-direction: column; align-items: flex-start; gap: 28px; padding-top: 8px; padding-bottom: 40px; }
    .hero__links { flex-direction: column; align-items: flex-start; gap: 18px; }
    .hero__blog-note { display: none; }
  }
</style>
